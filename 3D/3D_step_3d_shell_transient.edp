// ============================================================
// step_3d_shell_transient.edp
// Full transient 3D shell scenario: ramp current to 0.7*Ic, settle, apply
// the 2mm x 2mm / 13W / 10ms spot heater (dead center, top face), then
// observe recovery vs. runaway -- the 3D analog of the 2D step2 workflow.
//
// Uses DISPATCHED (not additive-branch) material-property functions for
// source/kfun -- confirmed ~4.6x faster (72.5s -> 15.9s per assignment at
// this mesh size) than evaluating all region branches on every element.
//
// Timeline compressed vs. the 2D version to keep total step count
// manageable given ~40s/iteration cost: ramp in 10 (larger) steps,
// pulse resolved in 5 steps, recovery observed in ~10-15 steps.
// ============================================================

include "hts_mesh_module_3d.idp"
include "hts_materials.idp"

real Tcold = 77.0;
real shellArea = width*yB7 - coreWidth*(yB6-yB1);
real IcRebcoActual = JcT(77.0)*tSc*coreWidth;
real I0Target = 0.7 * IcRebcoActual;

real xHeatC = Lx/2, zHeatC = width/2;
real xHeatLo = xHeatC-1e-3, xHeatHi = xHeatC+1e-3;
real zHeatLo = zHeatC-1e-3, zHeatHi = zHeatC+1e-3;
real heaterPower = 13.0;
real qHeater = heaterPower/(2e-3*2e-3);

real Tramp = 0.5, tPulseStart = Tramp, tPulseDur = 0.01, tPulseEnd = tPulseStart+tPulseDur;
real tEnd = tPulseEnd + 0.08;

func real I0ofT(real tt){
  if (tt < Tramp) return I0Target*(tt/Tramp);
  return I0Target;
}
real[int] phaseBounds = [Tramp, tPulseStart, tPulseEnd, tEnd];
func real dtRaw(real tt){
  if (tt < Tramp) return 0.05;
  if (tt < tPulseEnd) return 0.002;
  return 0.01;
}
func real dtCapped(real tt){
  real d = dtRaw(tt);
  for (int i=0;i<4;i++) if (tt < phaseBounds[i]-1e-9 && tt+d > phaseBounds[i]) d = phaseBounds[i]-tt;
  return d;
}

func real kOf(int rg, real Tl){
  if (rg==1) return kCu(Tl);
  if (rg==2 || rg==6) return kAg(Tl);
  if (rg==3) return kHast(Tl);
  if (rg==4) return kBuf(Tl);
  if (rg==5) return kSc(Tl);
  return 1.0;
}
func real sourceOf(int rg, real Ef, real Tl){
  if (rg==1) return Ef^2/rhoCu(Tl);
  if (rg==2 || rg==6) return Ef^2/rhoAg(Tl);
  if (rg==3) return Ef^2/rhoHast(Tl);
  if (rg==5) return sigmaSc(Ef,Tl)*Ef^2;
  return 0.0;
}
func real rhoCpOf(int rg, real Tl){
  if (rg==1) return rhomCu*cpCu(Tl);
  if (rg==2 || rg==6) return rhomAg*cpAg(Tl);
  if (rg==3) return rhomHast*cpHast(Tl);
  if (rg==4) return rhomBuf*cpBuf(Tl);
  if (rg==5) return rhomSc*cpSc(Tl);
  return 1.0;
}
func real Itot(real E, real TcuShell, real TagB, real THast, real Tsc, real TagT){
  return shellArea*(E/rhoCu(TcuShell)) + tAgB*coreWidth*(E/rhoAg(TagB))
       + tSub*coreWidth*(E/rhoHast(THast))
       + tSc*coreWidth*sigmaSc(E,Tsc)*E + tAgT*coreWidth*(E/rhoAg(TagT));
}
real maxRelErrThisStep = 0.0;   // tracks worst-case current-conservation error per timestep

func real solveE(real TcuShell, real TagB, real THast, real Tsc, real TagT, real Itarget){
  if (Itarget <= 0.0) return 0.0;
  real Ehi0 = 4.0;
  int guard = 0;
  while (Itot(Ehi0,TcuShell,TagB,THast,Tsc,TagT) < Itarget && guard<40){ Ehi0 *= 2.0; guard++; }
  real logElo = log(1e-30), logEhi = log(Ehi0);
  for (int it=0; it<50; it++){
    real logEmid = 0.5*(logElo+logEhi);
    real Emid = exp(logEmid);
    if (Itot(Emid,TcuShell,TagB,THast,Tsc,TagT) < Itarget) logElo = logEmid; else logEhi = logEmid;
  }
  real Efinal = exp(0.5*(logElo+logEhi));
  real Icheck = Itot(Efinal,TcuShell,TagB,THast,Tsc,TagT);
  real relErr = abs(Icheck-Itarget)/max(Itarget,1e-30);
  if (relErr > maxRelErrThisStep) maxRelErrThisStep = relErr;
  assert(relErr <= 1e-3);
  return Efinal;
}

int nxs = 40;
real[int] xSample(nxs+1), Earr(nxs+1);
for (int i=0;i<=nxs;i++) xSample[i] = Lx*i/nxs;
func real Efun(real xx){ return interp1(xSample, Earr, nxs+1, xx); }

fespace Vh3(Th3, P1);
fespace Ph3(Th3, P0);
Ph3 reg = region;
Vh3 T, Told, w;
Ph3 kfun, source, rhocpfun;

real yCuTop = yB7-1e-9, yAgBmid=0.5*(yB1+yB2), yHastMid=0.5*(yB2+yB3), yScmid=0.5*(yB4+yB5), yAgTmid=0.5*(yB5+yB6);

int maxStepsThisRun = 1;   // per-invocation cap given ~40s/step cost

real t = 0.0;
{
  ifstream fchk("/scratch/rosep8/local-FreeFEM/3D/ckpt_3d_transient.txt");
  fchk >> t;
  for (int i=0;i<T.n;i++) fchk >> T[][i];
  cout << "Resumed at t="<<t<<"s Tmax="<<T[].max << endl;
}

{
  ofstream fout("/scratch/rosep8/local-FreeFEM/3D/transient_3d.csv", append);
  if (t <= 1e-12) fout << "t,I0,Tmax,maxCurrentConservationRelErr\n";

  int step = 0;
  while (t < tEnd-1e-12 && step < maxStepsThisRun){
    real I0w = I0ofT(t);
    maxRelErrThisStep = 0.0;
    for (int i=0;i<=nxs;i++){
      real xx = xSample[i];
      real TcuShell=T(xx,yCuTop,zHeatC), TagB=T(xx,yAgBmid,zHeatC), THast=T(xx,yHastMid,zHeatC),
           Tsc=T(xx,yScmid,zHeatC), TagT=T(xx,yAgTmid,zHeatC);
      Earr[i] = solveE(TcuShell,TagB,THast,Tsc,TagT, I0w);
    }
    cout << "t="<<t<<"s I0="<<I0w<<" Tmax="<<T[].max<<" maxConservErr="<<maxRelErrThisStep << endl;
    fout << t << "," << I0w << "," << T[].max << "," << maxRelErrThisStep << "\n";

    real dt = dtCapped(t);
    if (dt <= 1e-9) break;

    real qHeaterNow = 0.0;
    if (t >= tPulseStart && t < tPulseEnd) qHeaterNow = qHeater;

    source = sourceOf(region, Efun(x), T);
    Told = T;
    kfun = kOf(region, Told);
    rhocpfun = rhoCpOf(region, Told);

    solve heatStep(T, w) =
        int3d(Th3)( rhocpfun*T*w/dt + kfun*(dx(T)*dx(w) + dy(T)*dy(w) + dz(T)*dz(w)) )
      - int3d(Th3)( rhocpfun*Told*w/dt + source*w )
      - int2d(Th3, 3)( qHeaterNow*(x>xHeatLo)*(x<xHeatHi)*(z>zHeatLo)*(z<zHeatHi)*w )
      + on(2, 4, T=Tcold);

    t += dt;
    for (int i=0;i<4;i++) if (abs(t-phaseBounds[i])<1e-9) t = phaseBounds[i];
    step++;
  }
}

{
  ofstream fchkOut("/scratch/rosep8/local-FreeFEM/3D/ckpt_3d_transient.txt");
  fchkOut.precision(12);
  fchkOut << t << "\n";
  for (int i=0;i<T.n;i++) fchkOut << T[][i] << "\n";
}
cout << "Saved checkpoint at t="<<t<<"s" << endl;
