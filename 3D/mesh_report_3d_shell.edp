include "hts_mesh_module_3d.idp"
cout << "3D shell mesh: nv=" << Th3.nv << "  nt=" << Th3.nt << "  nbe=" << Th3.nbe << endl;
{
  ofstream fv("/scratch/rosep8/local-FreeFEM/3D/mesh3d_shell_vertices.csv");
  fv << "x,y,z\n";
  for (int i=0;i<Th3.nv;i++) fv << Th3(i).x << "," << Th3(i).y << "," << Th3(i).z << "\n";
}
{
  ofstream ft("/scratch/rosep8/local-FreeFEM/3D/mesh3d_shell_boundary.csv");
  ft << "v0,v1,v2,label\n";
  for (int i=0;i<Th3.nbe;i++) ft << Th3.be(i)[0] << "," << Th3.be(i)[1] << "," << Th3.be(i)[2] << "," << Th3.be(i).label << "\n";
}
// also export a y-z cross-section slice (at x=Lx/2) showing the shell+core structure
fespace Ph3(Th3, P0);
Ph3 reg = region;
{
  ofstream fs("/scratch/rosep8/local-FreeFEM/3D/shell_crosssection.csv");
  fs << "y,z,region\n";
  int ny2=60, nz2=60;
  for (int i=0;i<=ny2;i++){
    for (int j=0;j<=nz2;j++){
      real yy = yB7*i/ny2, zz = width*j/nz2;
      real yq = (yy<=0)?1e-9:(yy>=yB7?yB7-1e-9:yy);
      real zq = (zz<=0)?1e-9:(zz>=width?width-1e-9:zz);
      fs << yy << "," << zz << "," << reg(Lx/2,yq,zq) << "\n";
    }
  }
}
cout << "Wrote mesh3d_shell_vertices.csv, mesh3d_shell_boundary.csv, shell_crosssection.csv" << endl;
