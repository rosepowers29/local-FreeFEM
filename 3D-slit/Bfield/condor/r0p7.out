    1 : // ============================================================
    2 : // step_3d_slit_transient_bfield.edp
    3 : // Full transient scenario WITH the slit: ramp current to a target
    4 : // transport-current ratio (currentRatio*Ic, default 0.7 -- see -ratio)
    5 : // over the ramp phase, then apply the 2mm x 2mm / 13W / 10ms spot heater
    6 : // on the LEFT side only (z=width/4), then observe recovery or runaway --
    7 : // and critically, track how the current SPLIT between left/right
    8 : // evolves.
    9 : //
   10 : // Electrical model: outside the slit's x-range, one equipotential
   11 : // channel. WITHIN the slit's x-range, current splits into two
   12 : // independent parallel paths matched by equal voltage drop across the
   13 : // slit's length (cheap bisection, redone every timestep -- no 3D solve
   14 : // involved in this sub-solve).
   15 : // ============================================================
   16 : 
   17 : real tInvocationStart = clock();
   18 : 
   19 : real tMeshStart = clock();
   20 : include "../shared/hts_mesh_module_3d_slit.idp"// ============================================================
    2 : // hts_mesh_module_3d_slit.idp
    3 : // 3D shell mesh WITH a laser slit down the tape centerline.
    4 : //
    5 : // Slit: 5um wide, cuts FULL THICKNESS (top to bottom, severing the
    6 : // copper shell's top/bottom portions in that region -- only the shell's
    7 : // SIDE edges remain continuous, providing the one remaining electrical
    8 : // path between the two halves within the slit's x-extent). Represented
    9 : // as a "stadium" (capsule) shape in the (x,z) plane: all points within
   10 : // radius R of the line segment from (xSlitStart, zCenter) to
   11 : // (xSlitEnd, zCenter) -- gives rounded (semicircular) ends automatically,
   12 : // no separate case needed for the caps.
   13 : //
   14 : // Region 7 = slit (vacuum-like properties, defined in materials module).
   15 : // Regions 1-6 unchanged from the no-slit shell model.
   16 : // ============================================================
   17 : 
   18 : load "msh3"
   19 : 
   20 : real Lx    = 0.20;
   21 : real tCuB  = 20e-6, tAgB = 1.8e-6, tSub = 50e-6, tBuf = 0.2e-6,
   22 :      tSc   = 1e-6,  tAgT = 2e-6,  tCuT = 20e-6;
   23 : real yB0=0, yB1=yB0+tCuB, yB2=yB1+tAgB, yB3=yB2+tSub, yB4=yB3+tBuf,
   24 :      yB5=yB4+tSc, yB6=yB5+tAgT, yB7=yB6+tCuT;
   25 : 
   26 : real width   = 0.012;
   27 : real tSideCu = 20e-6;
   28 : real zB0 = 0, zB1 = tSideCu, zB2 = width - tSideCu, zB3 = width;
   29 : real coreWidth = zB2 - zB1;
   30 : 
   31 : // ---- slit geometry ----
   32 : real slitWidth  = 5e-6;
   33 : real slitR      = slitWidth/2;
   34 : real xSlitStart = 0.010, xSlitEnd = 0.190;
   35 : real zSlitCenter = width/2;
   36 : 
   37 : // distance from (px,pz) to the slit's centerline segment
   38 : func real distToSlitSegment(real px, real pz){
   39 :   real xa = xSlitStart, xb = xSlitEnd, zc = zSlitCenter;
   40 :   real xq = px;
   41 :   if (xq < xa) xq = xa;
   42 :   if (xq > xb) xq = xb;
   43 :   return sqrt((px-xq)^2 + (pz-zc)^2);
   44 : }
   45 : func bool inSlit(real px, real pz){
   46 :   return distToSlitSegment(px,pz) <= slitR;
   47 : }
   48 : 
   49 : int nx = 100;   // dx ~ 2mm (rounded-cap curvature at R=2.5um isn't resolved
   50 :                 // at this scale regardless of x-resolution -- see discussion)
   51 : int nCuB=8, nAgB=2, nSub=6, nBuf=1, nSc=2, nAgT=2, nCuT=8;
   52 : int ny = nCuB+nAgB+nSub+nBuf+nSc+nAgT+nCuT;
   53 : 
   54 : // z structure: shell | core-left-of-slit | slit band | core-right-of-slit | shell
   55 : int nzShell=2, nzCoreOuter=10, nzSlitBand=4;
   56 : int nz = 2*nzShell + 2*nzCoreOuter + nzSlitBand;
   57 : 
   58 : real zSlitLo = zSlitCenter-slitR, zSlitHi = zSlitCenter+slitR;
   59 : 
   60 : func real yphys(real s){
   61 :   real fCuB=nCuB*1.0/ny, fAgB=nAgB*1.0/ny, fSub=nSub*1.0/ny, fBuf=nBuf*1.0/ny,
   62 :        fSc=nSc*1.0/ny, fAgT=nAgT*1.0/ny, fCuT=nCuT*1.0/ny;
   63 :   real c0=0, c1=c0+fCuB, c2=c1+fAgB, c3=c2+fSub, c4=c3+fBuf, c5=c4+fSc, c6=c5+fAgT, c7=c6+fCuT;
   64 :   if (s<=c1) return yB0 + (yB1-yB0)*(s-c0)/(c1-c0);
   65 :   if (s<=c2) return yB1 + (yB2-yB1)*(s-c1)/(c2-c1);
   66 :   if (s<=c3) return yB2 + (yB3-yB2)*(s-c2)/(c3-c2);
   67 :   if (s<=c4) return yB3 + (yB4-yB3)*(s-c3)/(c4-c3);
   68 :   if (s<=c5) return yB4 + (yB5-yB4)*(s-c4)/(c5-c4);
   69 :   if (s<=c6) return yB5 + (yB6-yB5)*(s-c5)/(c6-c5);
   70 :   return yB6 + (yB7-yB6)*(s-c6)/(c7-c6);
   71 : }
   72 : 
   73 : func real zphys(real s){
   74 :   real fSh=nzShell*1.0/nz, fCo=nzCoreOuter*1.0/nz, fSl=nzSlitBand*1.0/nz;
   75 :   real c0=0, c1=c0+fSh, c2=c1+fCo, c3=c2+fSl, c4=c3+fCo, c5=c4+fSh;
   76 :   if (s<=c1) return zB0 + (zB1-zB0)*(s-c0)/(c1-c0);
   77 :   if (s<=c2) return zB1 + (zSlitLo-zB1)*(s-c1)/(c2-c1);
   78 :   if (s<=c3) return zSlitLo + (zSlitHi-zSlitLo)*(s-c2)/(c3-c2);
   79 :   if (s<=c4) return zSlitHi + (zB2-zSlitHi)*(s-c3)/(c4-c3);
   80 :   return zB2 + (zB3-zB2)*(s-c4)/(c5-c4);
   81 : }
   82 : 
   83 : mesh3 Th3 = cube(nx, ny, nz, [Lx*x, yphys(y), zphys(z)]);
   84 : 
   85 : fespace Ph3region(Th3, P0);
   86 : Ph3region region0 = 7*(inSlit(x,z))
   87 :                    + (1-inSlit(x,z))*(
   88 :                        (y<=yB1 || y>yB6 || z<=zB1 || z>=zB2)*1
   89 :                      + (y>yB1 && y<=yB2 && z>zB1 && z<zB2)*2
   90 :                      + (y>yB2 && y<=yB3 && z>zB1 && z<zB2)*3
   91 :                      + (y>yB3 && y<=yB4 && z>zB1 && z<zB2)*4
   92 :                      + (y>yB4 && y<=yB5 && z>zB1 && z<zB2)*5
   93 :                      + (y>yB5 && y<=yB6 && z>zB1 && z<zB2)*6 );
