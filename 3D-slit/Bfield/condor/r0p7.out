  126 : for (int i=0;i<=nxs;i++) xSample[i] = Lx*i/nxs;
  127 : func real Efun(real xx){ return interp1(xSample, Earr, nxs+1, xx); }
  128 : func real ElFun(real xx){ return interp1(xSample, ElArr, nxs+1, xx); }
  129 : func real ErFun(real xx){ return interp1(xSample, ErArr, nxs+1, xx); }
