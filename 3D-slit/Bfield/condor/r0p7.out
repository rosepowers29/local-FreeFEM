   92 : func real kOf(int rg, real Tl)
 *** Warning  The identifier Tl hide a Global identifier  
{
   93 :   if (rg==1) return kCu(Tl);
   94 :   if (rg==2 || rg==6) return kAg(Tl);
   95 :   if (rg==3) return kHast(Tl);
   96 :   if (rg==4) return kBuf(Tl);
   97 :   if (rg==5) return kSc(Tl);
