 *** Warning  The identifier Tl hide a Global identifier  
{
  102 :   if (rg==1) return Ef^2/rhoCu(Tl);
  103 :   if (rg==2 || rg==6) return Ef^2/rhoAg(Tl);
  104 :   if (rg==3) return Ef^2/rhoHast(Tl);   // Hastelloy: now a genuine parallel branch, not excluded
  105 :   if (rg==5) return sigmaSc(Ef,Tl)*Ef^2;
  106 :   return 0.0;   // region 4 (buffer) remains excluded -- see bfield_3d_slit.idp header note
  107 : }
