    3 : 
    4 : // Lets a run_transient.py-style wrapper point this at a per-run output
    5 : // directory without editing this file -- ported from electrothermal/
    6 : // init_3d_slit_transient_checkpoint.edp. Default "" reproduces this
    7 : // script's exact prior behavior (files written to the CWD).
    8 : string outPrefix = getARGV("-outprefix", "");
    9 : 
   10 : fespace Vh3(Th3, P1);
   11 : Vh3 T = 77.0;
   12 : // nxs must match the value used in the step scripts (60) -- this writes
   13 : // zero-initialized E-field arrays alongside t and T, matching the
   14 : // checkpoint format step_3d_slit_transient_bfield.edp now expects (see
   15 : // that file for why: computeSelfFieldB's lagged design requires these
   16 : // arrays to actually persist across script invocations, not just T).
   17 : // The plain (non-bfield) step scripts don't read these extra values at
   18 : // all, so this format change is harmless for them.
   19 : int nxs = 60;
   20 : {
   21 :   ofstream fchkOut(outPrefix+"ckpt_3d_slit_transient.txt");
   22 :   fchkOut.precision(12);
   23 :   fchkOut << 0.0 << "\n";
   24 :   for (int i=0;i<T.n;i++) fchkOut << T[][i] << "\n";
   25 :   for (int i=0;i<=nxs;i++) fchkOut << 0.0 << "\n";   // Earr
   26 :   for (int i=0;i<=nxs;i++) fchkOut << 0.0 << "\n";   // ElArr
   27 :   for (int i=0;i<=nxs;i++) fchkOut << 0.0 << "\n";   // ErArr
   28 : }
   29 : cout << "Initialized, T.n=" << T.n << endl;
