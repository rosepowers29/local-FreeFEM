  142 : real yCuTop=yB7-1e-9, yAgBmid=0.5*(yB1+yB2), yHastMid=0.5*(yB2+yB3), yScmid=0.5*(yB4+yB5), yAgTmid=0.5*(yB5+yB6);
  143 : real zLeftRep = width/4, zRightRep = 3*width/4;
  144 : 
  145 : // Self-field B computation (Kim-model Jc(B,T) feedback) -- must be
  146 : // included after Efun/ElFun/ErFun AND after Vh3 T exists (bfield_3d_slit.idp's
  147 : // computeSelfFieldB references the mesh field T directly), per its own
  148 : // header comment. FreeFEM resolves identifiers at parse time even inside
  149 : // func bodies not yet called, so this really does need to come after the
  150 : // Vh3 T declaration above, not just before it's first USED.
  151 : include "bfield_3d_slit.idp"// ============================================================
    2 : // bfield_3d_slit.idp
    3 : // Self-field B computation for Kim-model Jc(B,T) suppression.
    4 : //
    5 : // Scope decisions (see project history for the full discussion):
    6 : //  - Self-field only: computed via Biot-Savart directly from the
    7 : //    tape's own current distribution. No external circuit / current
    8 : //    return path is modeled (open-conductor approximation) -- this is
    9 : //    least accurate near the current leads (x=0, x=Lx) and most
   10 : //    accurate near the tape's midpoint, which is where the physics of
   11 : //    interest (heater/hot-spot self-field suppression) actually lives.
   12 : //  - LAGGED coupling: B is computed from the PREVIOUS timestep's
   13 : //    converged current distribution, then held fixed through the
   14 : //    current timestep's current-sharing bisection -- matches the
   15 : //    existing Told-based lagging already used for source terms, and
   16 : //    avoids a nested Picard loop.
   17 : //  - Thin-SHEET approximation, one sheet per CURRENT-CARRYING layer
   18 : //    (Hastelloy/buffer carry no current, no sheet needed): Ag-bottom,
   19 : //    REBCO, Ag-top (simple flat sheets) + the Cu shell decomposed into
   20 : //    4 non-overlapping sub-sheets (top strip, bottom strip, left wall,
   21 : //    right wall) to preserve its actual wrap-around geometry rather
   22 : //    than approximating it as flat. Each sheet's current density is
   23 : //    resolved in 2D (along x AND across its own width) -- deliberately
   24 : //    not collapsed to a 1D line current, since width-resolved self-field
   25 : //    structure at the tape edges is the specific thing motivating the
   26 : //    thin-sheet choice over a filament approximation.
   27 : //  - Within the slit's x-range, Ag-bottom/REBCO/Ag-top and the Cu
   28 : //    top/bottom strips split left/right at z=zSlitCenter (matching the
   29 : //    existing electrical model); the Cu side walls are always whole,
   30 : //    always on their respective side (confirmed from the mesh module:
   31 : //    the walls sit entirely outside the slit's z-range, so are never
   32 : //    severed by it).
   33 : //
   34 : // REQUIRES: this file must be included in a script that has already
   35 : // included hts_mesh_module_3d_slit.idp and hts_materials.idp, and
   36 : // which defines (with these exact names, as step_3d_slit_transient_diag.edp
   37 : // does): the E-field sample arrays/functions Efun/ElFun/ErFun and their
   38 : // backing arrays Earr/ElArr/ErArr, xSample, nxs, xSlitStart, xSlitEnd,
   39 : // zSlitCenter, zLeftRep, zRightRep, and Vh3 T.
   40 : // ============================================================
   41 : 
   42 : // ---- Kim model: Jc(B,T) = Jc(T)/(1+|B|/B0) ----
   43 : // LITERATURE VALUE (2026-09-25), from Loic Queval et al 2016 Supercond.
   44 : // Sci. Technol. 29 024007 -- replaces the prior 0.1 T placeholder (round,
   45 : // order-of-magnitude guess made without search access; see git history).
   46 : // Suppression scales with 1/B0kim, so this is a >2x more aggressive
   47 : // suppression curve than the placeholder, not a cosmetic change --
   48 : // verify with a real run before trusting downstream results against it
   49 : // (see Bfield/CLAUDE.md).
   50 : // Also note: this is still an ISOTROPIC Kim model using |B| regardless
   51 : // of orientation -- real REBCO Jc(B) is strongly anisotropic
   52 : // (perpendicular field suppresses much more than parallel field); that
   53 : // anisotropy is a known simplification here, not an oversight, and is a
   54 : // candidate refinement for later (see Bfield/CLAUDE.md for the
   55 : // isotropic-first verification plan), not implemented now.
   56 : real B0kim = 0.04265;
   57 : 
   58 : func real JcTB(real Tl, real Bmag)
 *** Warning  The identifier Tl hide a Global identifier  
{
   59 :   return JcT(Tl) / (1.0 + Bmag/B0kim);
   60 : }
   61 : func real sigmaScB(real Emag, real Tl, real Bmag)
 *** Warning  The identifier Tl hide a Global identifier  
{
   62 :   real Estab = max(abs(Emag), Einit);
   63 :   real JcVal = JcTB(Tl, Bmag);
   64 :   real nVal  = nT(Tl);   // Kim model here only suppresses Jc, not n -- standard simplification
   65 :   real scTerm = (JcVal/Estab) * (Estab/E0)^(1.0/nVal);
   66 :   return min(scTerm, sigmaMax) + sigmaRebco;
   67 : }
   68 : 
   69 : // ---- sheet geometry (all derived from the real mesh-module constants,
   70 : // nothing hardcoded) ----
   71 : real yCuBotSheet = tCuB/2.0;
   72 : real yCuTopSheet = yB6 + tCuT/2.0;
   73 : real yCuWallMid  = 0.5*(yB1+yB6);
   74 : real zCuLeftWall  = tSideCu/2.0;
   75 : real zCuRightWall = width - tSideCu/2.0;
   76 : 
   77 : real yAgBSheet = 0.5*(yB1+yB2);
   78 : real yHastSheet = 0.5*(yB2+yB3);
   79 : real yScSheet  = 0.5*(yB4+yB5);
   80 : real yAgTSheet = 0.5*(yB5+yB6);
   81 : 
   82 : // ---- E-field helper: which E value applies at x for the given side
   83 : // (side<0 = left/z<center, side>0 = right/z>center) -- outside the
   84 : // slit range both sides see the same unified Efun, matching the
   85 : // diagnostics module's identical convention ----
   86 : func real EforSide(real xx, int side){
   87 :   if (xx < xSlitStart || xx > xSlitEnd) return Efun(xx);
   88 :   return (side < 0) ? ElFun(xx) : ErFun(xx);
   89 : }
   90 : 
   91 : // ---- generic 2D Biot-Savart sheet integrators. Current always flows
   92 : // in +x (the model's universal assumption). K(x) is surface current
   93 : // density [A/m], uniform across the sheet's short/transverse extent at
   94 : // a given x (consistent with the existing model's per-x-slice-uniform
   95 : // current assumption within each layer) but resolved in 2D spatially
   96 : // via explicit sub-strips across that transverse extent, so the actual
   97 : // finite width still shapes the near-field the way a real sheet would.
   98 : // ----
   99 : func real[int] biotSheetYConst(real px,real py,real pz, real ySheet, real za,real zb,
  100 :                                 real[int] &Karr, int nSub){
  101 :   int Nz = 6;
  102 :   real dz = (zb-za)/Nz;
 *** Warning  The identifier dz hide a Global identifier  

  103 :   real sx=0.0, sy=0.0, sz=0.0;
  104 :   for (int iz=0; iz<Nz; iz++){
  105 :     real zq = za + (iz+0.5)*dz;
  106 :     for (int ix=0; ix<nSub-1; ix++){
  107 :       real xq = 0.5*(xSample[ix]+xSample[ix+1]);
  108 :       real Kavg = 0.5*(Karr[ix]+Karr[ix+1]);
  109 :       real dI = Kavg*dz;
  110 :       real dxSeg = xSample[ix+1]-xSample[ix];
  111 :       real rx=px-xq, ry=py-ySheet, rz=pz-zq;
  112 :       real rmag = sqrt(rx^2+ry^2+rz^2);
  113 :       real inv = dI/(4*pi*(rmag^3+1e-30));
  114 :       // dl=(dxSeg,0,0); dl x r = (0, -dxSeg*rz, dxSeg*ry)
  115 :       sy += (-dxSeg*rz)*inv;
  116 :       sz += ( dxSeg*ry)*inv;
  117 :     }
  118 :   }
  119 :   real[int] res = [sx, sy, sz];
  120 :   return res;
  121 : }
  122 : func real[int] biotSheetZConst(real px,real py,real pz, real zSheet, real ya,real yb,
  123 :                                 real[int] &Karr, int nSub){
  124 :   int Ny = 4;
  125 :   real dy = (yb-ya)/Ny;
 *** Warning  The identifier dy hide a Global identifier  

  126 :   real sx=0.0, sy=0.0, sz=0.0;
  127 :   for (int iy=0; iy<Ny; iy++){
  128 :     real yq = ya + (iy+0.5)*dy;
  129 :     for (int ix=0; ix<nSub-1; ix++){
  130 :       real xq = 0.5*(xSample[ix]+xSample[ix+1]);
  131 :       real Kavg = 0.5*(Karr[ix]+Karr[ix+1]);
  132 :       real dI = Kavg*dy;
  133 :       real dxSeg = xSample[ix+1]-xSample[ix];
  134 :       real rx=px-xq, ry=py-yq, rz=pz-zSheet;
  135 :       real rmag = sqrt(rx^2+ry^2+rz^2);
  136 :       real inv = dI/(4*pi*(rmag^3+1e-30));
  137 :       sy += (-dxSeg*rz)*inv;
  138 :       sz += ( dxSeg*ry)*inv;
  139 :     }
  140 :   }
  141 :   real[int] res = [sx, sy, sz];
  142 :   return res;
  143 : }
  144 : 
  145 : // ---- near-field-excluding variant, used ONLY when a sheet is being
  146 : // evaluated at a point ON ITSELF (same y-height, same side) -- e.g.
  147 : // REBCO's own contribution to B at REBCO's own location. Segments
  148 : // immediately adjacent to the evaluation x-index are excluded from
  149 : // the discretized sum (that's exactly where the y-distance is zero
  150 : // and the naive kernel is near-singular), and nothing is added back:
  151 : // the exact uniform-current-slab result for the field AT THE CENTER
  152 : // of a locally-uniform slab is precisely zero (see project notes),
  153 : // so omitting that immediate neighborhood entirely IS the correct
  154 : // near-field treatment here, not merely an approximation of it.
  155 : //
  156 : // CAVEAT: the excluded window's width is tied to the x-sampling grid
  157 : // spacing (~3.3mm at nxs=60), which is coarser than the length scale
  158 : // over which current density is truly uniform right at sharp
  159 : // features (the heater footprint, the slit edges). The zero-near-term
  160 : // result is exact only insofar as current is locally uniform within
  161 : // the excluded window -- it is a weaker approximation specifically at
  162 : // those sharp features than everywhere else. nExclude is left as an
  163 : // explicit, tunable parameter for exactly this reason.
  164 : func real[int] biotSheetYConstExcludeNear(real px,real py,real pz, real ySheet, real za,real zb,
  165 :                                            real[int] &Karr, int nSub, int excludeIdx, int nExclude){
  166 :   int Nz = 6;
  167 :   real dz = (zb-za)/Nz;
 *** Warning  The identifier dz hide a Global identifier  

  168 :   real sx=0.0, sy=0.0, sz=0.0;
  169 :   int loEx = max(0, excludeIdx-nExclude);
  170 :   int hiEx = min(nSub-2, excludeIdx+nExclude-1);
  171 :   for (int iz=0; iz<Nz; iz++){
  172 :     real zq = za + (iz+0.5)*dz;
  173 :     for (int ix=0; ix<nSub-1; ix++){
  174 :       if (ix>=loEx && ix<=hiEx) continue;   // skip the near neighborhood
  175 :       real xq = 0.5*(xSample[ix]+xSample[ix+1]);
  176 :       real Kavg = 0.5*(Karr[ix]+Karr[ix+1]);
  177 :       real dI = Kavg*dz;
  178 :       real dxSeg = xSample[ix+1]-xSample[ix];
  179 :       real rx=px-xq, ry=py-ySheet, rz=pz-zq;
  180 :       real rmag = sqrt(rx^2+ry^2+rz^2);
  181 :       real inv = dI/(4*pi*(rmag^3+1e-30));
  182 :       sy += (-dxSeg*rz)*inv;
  183 :       sz += ( dxSeg*ry)*inv;
  184 :     }
  185 :   }
  186 :   real[int] res = [sx, sy, sz];
  187 :   return res;
  188 : }
  189 : 
  190 : // ---- self-field driver: builds all 12 sheet current-density arrays
  191 : // from the CURRENT (soon to be overwritten) Earr/ElArr/ErArr and T --
  192 : // i.e. the previous timestep's converged state, per the lagged-
  193 : // coupling decision -- and evaluates |B| (in Tesla) at the REBCO
  194 : // layer's representative point for each side, at every x-sample point.
  195 : //
  196 : // NOTE on a deliberate simplification: the REBCO sheet's current here
  197 : // is reconstructed via the plain sigmaSc(E,T) formula (NOT sigmaScB),
  198 : // even though the "real" current that produced this stored E may have
  199 : // been computed under B-suppression on a previous step. This avoids
  200 : // needing a separate persisted-B checkpoint across script invocations
  201 : // (B is always freshly recomputed from the already-checkpointed E/T
  202 : // state instead). Given the whole self-field treatment is already an
  203 : // approximation (open-conductor, lagged, isotropic Kim model), this
  204 : // additional simplification is judged acceptable -- it does not
  205 : // compound across timesteps, since nothing here is itself persisted.
  206 : real mu0 = 4*pi*1e-7;
  207 : 
  208 : func int computeSelfFieldB(real[int] &BleftOut, real[int] &BrightOut, int nSub){
  209 :   real[int] KcuBotL(nSub), KcuBotR(nSub), KcuTopL(nSub), KcuTopR(nSub);
  210 :   real[int] KcuLW(nSub), KcuRW(nSub);
  211 :   real[int] KagbL(nSub), KagbR(nSub), KhastL(nSub), KhastR(nSub), KscL(nSub), KscR(nSub), KagtL(nSub), KagtR(nSub);
  212 : 
  213 :   for (int i=0; i<nSub; i++){
  214 :     real xx = xSample[i];
  215 :     real ElHere = EforSide(xx,-1), ErHere = EforSide(xx,+1);
  216 :     real TcuBotL=T(xx,yCuBotSheet,zLeftRep), TcuBotR=T(xx,yCuBotSheet,zRightRep);
  217 :     real TcuTopL=T(xx,yCuTopSheet,zLeftRep), TcuTopR=T(xx,yCuTopSheet,zRightRep);
  218 :     real TcuLWt=T(xx,yCuWallMid,zCuLeftWall), TcuRWt=T(xx,yCuWallMid,zCuRightWall);
  219 :     real TagbL=T(xx,yAgBSheet,zLeftRep), TagbR=T(xx,yAgBSheet,zRightRep);
  220 :     real ThastL=T(xx,yHastSheet,zLeftRep), ThastR=T(xx,yHastSheet,zRightRep);
  221 :     real TscL=T(xx,yScSheet,zLeftRep),   TscR=T(xx,yScSheet,zRightRep);
  222 :     real TagtL=T(xx,yAgTSheet,zLeftRep), TagtR=T(xx,yAgTSheet,zRightRep);
  223 : 
  224 :     KcuBotL[i]=tCuB*(ElHere/rhoCu(TcuBotL)); KcuBotR[i]=tCuB*(ErHere/rhoCu(TcuBotR));
  225 :     KcuTopL[i]=tCuT*(ElHere/rhoCu(TcuTopL)); KcuTopR[i]=tCuT*(ErHere/rhoCu(TcuTopR));
  226 :     KcuLW[i]=tSideCu*(ElHere/rhoCu(TcuLWt)); KcuRW[i]=tSideCu*(ErHere/rhoCu(TcuRWt));
  227 :     KagbL[i]=tAgB*(ElHere/rhoAg(TagbL));     KagbR[i]=tAgB*(ErHere/rhoAg(TagbR));
  228 :     KhastL[i]=tSub*(ElHere/rhoHast(ThastL)); KhastR[i]=tSub*(ErHere/rhoHast(ThastR));
  229 :     KscL[i]=sigmaSc(ElHere,TscL)*ElHere*tSc; KscR[i]=sigmaSc(ErHere,TscR)*ErHere*tSc;
  230 :     KagtL[i]=tAgT*(ElHere/rhoAg(TagtL));     KagtR[i]=tAgT*(ErHere/rhoAg(TagtR));
  231 :   }
  232 : 
  233 :   for (int i=0; i<nSub; i++){
  234 :     real xx = xSample[i];
  235 :     for (int side=-1; side<=1; side+=2){
  236 :       real pz = (side<0) ? zLeftRep : zRightRep;
  237 :       real[int] hCuBotL=biotSheetYConst(xx,yScSheet,pz, yCuBotSheet, 0.0,zSlitCenter, KcuBotL,nSub);
  238 :       real[int] hCuBotR=biotSheetYConst(xx,yScSheet,pz, yCuBotSheet, zSlitCenter,width, KcuBotR,nSub);
  239 :       real[int] hCuTopL=biotSheetYConst(xx,yScSheet,pz, yCuTopSheet, 0.0,zSlitCenter, KcuTopL,nSub);
  240 :       real[int] hCuTopR=biotSheetYConst(xx,yScSheet,pz, yCuTopSheet, zSlitCenter,width, KcuTopR,nSub);
  241 :       real[int] hCuLW  =biotSheetZConst(xx,yScSheet,pz, zCuLeftWall, yB1,yB6, KcuLW,nSub);
  242 :       real[int] hCuRW  =biotSheetZConst(xx,yScSheet,pz, zCuRightWall, yB1,yB6, KcuRW,nSub);
  243 :       real[int] hAgbL  =biotSheetYConst(xx,yScSheet,pz, yAgBSheet, zB1,zSlitCenter, KagbL,nSub);
  244 :       real[int] hAgbR  =biotSheetYConst(xx,yScSheet,pz, yAgBSheet, zSlitCenter,zB2, KagbR,nSub);
  245 :       // Hastelloy is a genuine cross-term here (evaluated at REBCO's
  246 :       // y-height, not its own), so no near-field exclusion is needed --
  247 :       // ordinary Biot-Savart, same as Ag/Cu.
  248 :       real[int] hHastL =biotSheetYConst(xx,yScSheet,pz, yHastSheet, zB1,zSlitCenter, KhastL,nSub);
  249 :       real[int] hHastR =biotSheetYConst(xx,yScSheet,pz, yHastSheet, zSlitCenter,zB2, KhastR,nSub);
  250 :       // REBCO's contribution to B AT ITS OWN LOCATION: only the
  251 :       // portion on the SAME side as the evaluation point (side<0 uses
  252 :       // hScL, side>0 uses hScR) needs the near-field exclusion, since
  253 :       // that's the only piece sharing both the evaluation y-height AND
  254 :       // covering the evaluation z-location. The opposite-side portion
  255 :       // is a genuine, well-posed cross-term (nonzero z-separation) and
  256 :       // uses ordinary Biot-Savart unchanged.
  257 :       real[int] hScL(3), hScR(3);
  258 :       if (side<0){ hScL=biotSheetYConstExcludeNear(xx,yScSheet,pz, yScSheet, zB1,zSlitCenter, KscL,nSub, i,2);
  259 :                    hScR=biotSheetYConst(xx,yScSheet,pz, yScSheet, zSlitCenter,zB2, KscR,nSub); }
  260 :       else       { hScL=biotSheetYConst(xx,yScSheet,pz, yScSheet, zB1,zSlitCenter, KscL,nSub);
  261 :                    hScR=biotSheetYConstExcludeNear(xx,yScSheet,pz, yScSheet, zSlitCenter,zB2, KscR,nSub, i,2); }
  262 :       real[int] hAgtL  =biotSheetYConst(xx,yScSheet,pz, yAgTSheet, zB1,zSlitCenter, KagtL,nSub);
  263 :       real[int] hAgtR  =biotSheetYConst(xx,yScSheet,pz, yAgTSheet, zSlitCenter,zB2, KagtR,nSub);
  264 : 
  265 :       real Hy = hCuBotL[1]+hCuBotR[1]+hCuTopL[1]+hCuTopR[1]+hCuLW[1]+hCuRW[1]
  266 :               + hAgbL[1]+hAgbR[1]+hHastL[1]+hHastR[1]+hScL[1]+hScR[1]+hAgtL[1]+hAgtR[1];
  267 :       real Hz = hCuBotL[2]+hCuBotR[2]+hCuTopL[2]+hCuTopR[2]+hCuLW[2]+hCuRW[2]
  268 :               + hAgbL[2]+hAgbR[2]+hHastL[2]+hHastR[2]+hScL[2]+hScR[2]+hAgtL[2]+hAgtR[2];
  269 :       real Hmag = sqrt(Hy^2+Hz^2);
  270 :       if (side<0) BleftOut[i]=mu0*Hmag; else BrightOut[i]=mu0*Hmag;
  271 :     }
  272 :   }
  273 :   return 0;
  274 : }
  275 : 
  276 : // ---- B-aware current-sharing bisection: identical structure to the
  277 : // existing ItotFull/solveEFull and ItotHalf/solveEHalf, but using
  278 : // sigmaScB (Kim-suppressed) instead of sigmaSc for the REBCO term.
  279 : //
  280 : // Hastelloy (region 3) is included here as a genuine parallel resistive
  281 : // branch (tSub*coreWidth*(E/rhoHast(THast)), same Ohmic form as Cu/Ag) --
  282 : // NOT excluded as "non-conducting". It has real, measured, merely-HIGH
  283 : // (not insulating) resistivity: ~1.23e-6 Ohm*m at 77-86K, essentially
  284 : // flat with temperature, versus Cu/Ag's ~3-6e-9 Ohm*m which itself rises
  285 : // with T. Back-of-envelope at 80K: Hastelloy's resistance per unit
  286 : // length is ~235x the parallel Cu+Ag combination, i.e. it carries
  287 : // roughly ~0.4-0.5% of the stabilizer's current there -- small, but a
  288 : // real, included contribution now rather than an assumed-zero omission.
  289 : // Buffer (region 4) remains excluded -- its assumed conductivity
  290 : // (sigmaBuf=1e-10 S/m) is ~4 orders of magnitude below even Hastelloy's
  291 : // real resistivity and is itself a nominal placeholder, not measured
  292 : // data, but that's a separate, much-better-justified approximation than
  293 : // Hastelloy's blanket exclusion was.
  294 : func real ItotFullB(real E, real TcuShell, real TagB, real THast, real Tsc, real TagT, real Bmag){
  295 :   return shellAreaFull*(E/rhoCu(TcuShell)) + tAgB*coreWidth*(E/rhoAg(TagB))
  296 :        + tSub*coreWidth*(E/rhoHast(THast))
  297 :        + tSc*coreWidth*sigmaScB(E,Tsc,Bmag)*E + tAgT*coreWidth*(E/rhoAg(TagT));
  298 : }
  299 : func real solveEFullB(real TcuShell, real TagB, real THast, real Tsc, real TagT, real Itarget, real Bmag){
  300 :   if (Itarget <= 0.0) return 0.0;
  301 :   real Ehi0=4.0; int guard=0;
  302 :   while (ItotFullB(Ehi0,TcuShell,TagB,THast,Tsc,TagT,Bmag) < Itarget && guard<40){ Ehi0*=2.0; guard++; }
  303 :   real logElo=log(1e-30), logEhi=log(Ehi0);
  304 :   for(int it=0;it<50;it++){
  305 :     real logEmid=0.5*(logElo+logEhi);
  306 :     real Emid=exp(logEmid);
  307 :     if (ItotFullB(Emid,TcuShell,TagB,THast,Tsc,TagT,Bmag) < Itarget) logElo=logEmid; else logEhi=logEmid;
  308 :   }
  309 :   real Ef=exp(0.5*(logElo+logEhi));
  310 :   real relErr=abs(ItotFullB(Ef,TcuShell,TagB,THast,Tsc,TagT,Bmag)-Itarget)/max(Itarget,1e-30);
  311 :   assert(relErr<=1e-3);
  312 :   return Ef;
  313 : }
  314 : func real ItotHalfB(real E, real TcuShell, real TagB, real THast, real Tsc, real TagT, real shellA, real cw, real Bmag){
  315 :   return shellA*(E/rhoCu(TcuShell)) + tAgB*cw*(E/rhoAg(TagB))
  316 :        + tSub*cw*(E/rhoHast(THast))
  317 :        + tSc*cw*sigmaScB(E,Tsc,Bmag)*E + tAgT*cw*(E/rhoAg(TagT));
  318 : }
  319 : func real solveEHalfB(real TcuShell, real TagB, real THast, real Tsc, real TagT, real Itarget, real shellA, real cw, real Bmag){
  320 :   if (Itarget <= 0.0) return 0.0;
  321 :   real Ehi0=4.0; int guard=0;
  322 :   while (ItotHalfB(Ehi0,TcuShell,TagB,THast,Tsc,TagT,shellA,cw,Bmag) < Itarget && guard<40){ Ehi0*=2.0; guard++; }
  323 :   real logElo=log(1e-30), logEhi=log(Ehi0);
  324 :   for(int it=0;it<50;it++){
  325 :     real logEmid=0.5*(logElo+logEhi);
  326 :     real Emid=exp(logEmid);
  327 :     if (ItotHalfB(Emid,TcuShell,TagB,THast,Tsc,TagT,shellA,cw,Bmag) < Itarget) logElo=logEmid; else logEhi=logEmid;
  328 :   }
  329 :   real Ef=exp(0.5*(logElo+logEhi));
  330 :   real relErr=abs(ItotHalfB(Ef,TcuShell,TagB,THast,Tsc,TagT,shellA,cw,Bmag)-Itarget)/max(Itarget,1e-30);
  331 :   assert(relErr<=1e-3);
  332 :   return Ef;
  333 : }
  334 : 
  152 : real[int] Bleft(nxs+1), Bright(nxs+1);
  153 : 
  154 : // Defaults to 1 (this script's exact prior behavior, unflagged). A
  155 : // wrapper passes a larger value via -steps-per-invocation to amortize
  156 : // the mesh-rebuild-per-invocation cost across several timesteps --
  157 : // CSV/diagnostics rows are still written every physical step regardless,
  158 : // and (see below) the checkpoint is now written every physical step too,
  159 : // so no time-resolution or crash-safety is lost by raising this.
  160 : int maxStepsThisRun = getARGV("-steps-per-invocation", 1);
  161 : 
  162 : // Adaptive-bisection/runaway-cutoff tunables, ported from
  163 : // electrothermal/step_3d_slit_transient_diag.edp -- see the step loop
  164 : // below for the mechanism and that track's CLAUDE.md for the crash
  165 : // history that motivated it (large-dt UMFPACK ill-conditioning on this
  166 : // project's own material tables, found to be node/hardware-dependent
  167 : // rather than a deterministic function of dt). getARGV lets these be
  168 : // overridden from the command line without editing the script; defaults
  169 : // reproduce this script's exact prior behavior when unflagged.
  170 : real maxStepRise = getARGV("-maxsteprise", 500.0);
  171 : int maxBisections = getARGV("-maxbisections", 10);
  172 : real tmaxCutoff = getARGV("-tmaxcutoff", 900.0);
  173 : 
  174 : // CHECKPOINT FORMAT CHANGE: now also persists Earr/ElArr/ErArr, not just
  175 : // t and T. This is required for computeSelfFieldB's lagged design to
  176 : // actually work: it reads these arrays BEFORE this step's electrical
  177 : // solve overwrites them, expecting last step's converged values. Without
  178 : // persisting them, every fresh script invocation saw freshly-zero-
  179 : // initialized arrays instead, and B was silently 0 forever regardless of
  180 : // the real current/heating state -- a real bug, not a physics effect,
  181 : // caught by exactly that symptom (uniformly zero B at every Hall probe
  182 : // reading). Checkpoints from before this fix do NOT have this data --
  183 : // re-run init_3d_slit_transient_checkpoint.edp for a fresh start rather
  184 : // than resuming an old checkpoint with this script; there's no valid B
  185 : // history in an old checkpoint to recover anyway (B was always 0 there).
  186 : real t = 0.0;
  187 : {
  188 :   ifstream fchk(outPrefix+"ckpt_3d_slit_transient.txt");
  189 :   fchk >> t;
  190 :   for (int i=0;i<T.n;i++) fchk >> T[][i];
  191 :   for (int i=0;i<=nxs;i++) fchk >> Earr[i];
  192 :   for (int i=0;i<=nxs;i++) fchk >> ElArr[i];
  193 :   for (int i=0;i<=nxs;i++) fchk >> ErArr[i];
  194 :   cout << "Resumed at t="<<t<<"s Tmax="<<T[].max << endl;
  195 : }
  196 : 
  197 : {
  198 :   ofstream fout(outPrefix+"transient_3d_slit.csv", append);
  199 :   if (t <= 1e-12) fout << "t,I0,Tmax,TmaxLeft,TmaxRight,fracLeft\n";
  200 : 
  201 :   ofstream fdiag(outPrefix+"diagnostics_3d_slit.csv", append);
  202 :   int diagFileCheck = exec("test -s "+outPrefix+"diagnostics_3d_slit.csv");
  203 :   bool diagCsvHasHeader = (diagFileCheck == 0);
  204 :   // Metadata is static and cheap -- just rewrite it every invocation so it's
  205 :   // always present/current, regardless of when this feature was added
  206 :   // relative to an in-progress run's t value.
  207 :   writeDiagnosticsMetadata(outPrefix+"diagnostics_positions_3d_slit.csv");
  208 :   if (!diagCsvHasHeader) {
  209 :     fdiag << "t,I0,Tmax,fracLeft,V_CL_plus,V_CL_minus";
  210 :     for (int i=0;i<nTapsPerSide;i++) fdiag << ",V1_" << (i+1);
  211 :     for (int i=0;i<nTapsPerSide;i++) fdiag << ",V2_" << (i+1);
  212 :     for (int i=0;i<nRTDsPerSide;i++) fdiag << ",RTD1_" << (i+1);
  213 :     for (int i=0;i<nRTDsPerSide;i++) fdiag << ",RTD2_" << (i+1);
  214 :     fdiag << ",H1,H2\n";
  215 :   }
  216 : 
  217 :   int step = 0;
  218 :   while (t < tEnd-1e-12 && step < maxStepsThisRun && T[].max < tmaxCutoff){
  219 :     real tStepStart = clock();
  220 :     real I0w = I0ofT(t);
  221 : 
  222 :     // Self-field B, computed from the CURRENT (about-to-be-overwritten)
  223 :     // Earr/ElArr/ErArr and T -- i.e. the previous timestep's converged
  224 :     // state -- then held fixed through this timestep's bisection below
  225 :     // (the "lagged" coupling decision).
  226 :     real tBstart = clock();
  227 :     computeSelfFieldB(Bleft, Bright, nxs+1);
  228 :     real tBfield = clock() - tBstart;
  229 : 
  230 :     real tElecStart = clock();
  231 :     // electrical: single channel outside slit range, split L/R inside.
  232 :     // WITHIN the slit, El(x)/Er(x) are resolved PER-x (matching the
  233 :     // outside-slit treatment) rather than sampled once at a single
  234 :     // representative point and extended uniformly -- the heater creates a
  235 :     // strongly localized hot spot, and a single point's local resistivity
  236 :     // is not representative of the other ~178mm of slit length.
  237 :     for (int i=0;i<=nxs;i++){
  238 :       real xx = xSample[i];
  239 :       if (xx < xSlitStart || xx > xSlitEnd){
  240 :         real TcuShell=T(xx,yCuTop,zLeftRep), TagB=T(xx,yAgBmid,zLeftRep), THast=T(xx,yHastMid,zLeftRep),
  241 :              Tsc=T(xx,yScmid,zLeftRep), TagT=T(xx,yAgTmid,zLeftRep);
  242 :         Earr[i] = solveEFullB(TcuShell,TagB,THast,Tsc,TagT, I0w, Bleft[i]);
  243 :         ElArr[i] = 0; ErArr[i] = 0;
  244 :       } else {
  245 :         Earr[i] = 0;
  246 :       }
  247 :     }
  248 : 
  249 :     // Precompute local per-x temperatures within the slit range for both
  250 :     // sides ONCE per timestep -- T is fixed during this algebraic
  251 :     // current-split sub-solve, so there's no need to re-evaluate the FE
  252 :     // field on every bisection iteration below.
  253 :     real[int] TcuLx(nxs+1), TagBLx(nxs+1), THastLx(nxs+1), TscLx(nxs+1), TagTLx(nxs+1);
  254 :     real[int] TcuRx(nxs+1), TagBRx(nxs+1), THastRx(nxs+1), TscRx(nxs+1), TagTRx(nxs+1);
  255 :     int iSlitLo=-1, iSlitHi=-1;
  256 :     for (int i=0;i<=nxs;i++){
  257 :       real xx = xSample[i];
  258 :       if (xx >= xSlitStart && xx <= xSlitEnd){
  259 :         if (iSlitLo<0) iSlitLo=i;
  260 :         iSlitHi=i;
  261 :         TcuLx[i]=T(xx,yCuTop,zLeftRep);  TagBLx[i]=T(xx,yAgBmid,zLeftRep);  THastLx[i]=T(xx,yHastMid,zLeftRep);
  262 :         TscLx[i]=T(xx,yScmid,zLeftRep);  TagTLx[i]=T(xx,yAgTmid,zLeftRep);
  263 :         TcuRx[i]=T(xx,yCuTop,zRightRep); TagBRx[i]=T(xx,yAgBmid,zRightRep); THastRx[i]=T(xx,yHastMid,zRightRep);
  264 :         TscRx[i]=T(xx,yScmid,zRightRep); TagTRx[i]=T(xx,yAgTmid,zRightRep);
  265 :       }
  266 :     }
  267 : 
  268 :     // Total voltage drop along each side = integral of the LOCAL field
  269 :     // (current fixed at Il/Ir along the length, field varies with local T)
  270 :     // over the slit's x-range, trapezoidal over the same x-sample grid used
  271 :     // everywhere else.
  272 :     func real VLeftTotal(real fracLeft){
  273 :       real Il = fracLeft*I0w;
  274 :       real sum = 0.0;
  275 :       for (int i=iSlitLo;i<iSlitHi;i++){
  276 :         real Ea = solveEHalfB(TcuLx[i],  TagBLx[i],  THastLx[i],  TscLx[i],  TagTLx[i],  Il, leftShellArea, leftCoreWidth, Bleft[i]);
  277 :         real Eb = solveEHalfB(TcuLx[i+1],TagBLx[i+1],THastLx[i+1],TscLx[i+1],TagTLx[i+1],Il, leftShellArea, leftCoreWidth, Bleft[i+1]);
  278 :         sum += 0.5*(Ea+Eb)*(xSample[i+1]-xSample[i]);
  279 :       }
  280 :       return sum;
  281 :     }
  282 :     func real VRightTotal(real fracLeft){
  283 :       real Ir = (1-fracLeft)*I0w;
  284 :       real sum = 0.0;
  285 :       for (int i=iSlitLo;i<iSlitHi;i++){
  286 :         real Ea = solveEHalfB(TcuRx[i],  TagBRx[i],  THastRx[i],  TscRx[i],  TagTRx[i],  Ir, rightShellArea, rightCoreWidth, Bright[i]);
  287 :         real Eb = solveEHalfB(TcuRx[i+1],TagBRx[i+1],THastRx[i+1],TscRx[i+1],TagTRx[i+1],Ir, rightShellArea, rightCoreWidth, Bright[i+1]);
  288 :         sum += 0.5*(Eb+Ea)*(xSample[i+1]-xSample[i]);
  289 :       }
  290 :       return sum;
  291 :     }
  292 :     func real Vdiff(real fracLeft){
  293 :       return VLeftTotal(fracLeft) - VRightTotal(fracLeft);
  294 :     }
  295 :     real flo=0.0, fhi=1.0;
  296 :     if (I0w <= 0.0){ flo=0.5; fhi=0.5; }
  297 :     else {
  298 :       for(int it=0;it<30;it++){
  299 :         real fmid=0.5*(flo+fhi);
  300 :         if (Vdiff(fmid) < 0) flo=fmid; else fhi=fmid;
  301 :       }
  302 :     }
  303 :     real fracLeft = 0.5*(flo+fhi);
  304 :     real IlFinal = fracLeft*I0w, IrFinal = (1-fracLeft)*I0w;
  305 :     for (int i=iSlitLo;i<=iSlitHi;i++){
  306 :       ElArr[i] = solveEHalfB(TcuLx[i],TagBLx[i],THastLx[i],TscLx[i],TagTLx[i], IlFinal, leftShellArea, leftCoreWidth, Bleft[i]);
  307 :       ErArr[i] = solveEHalfB(TcuRx[i],TagBRx[i],THastRx[i],TscRx[i],TagTRx[i], IrFinal, rightShellArea, rightCoreWidth, Bright[i]);
  308 :     }
  309 :     real tElectrical = clock() - tElecStart;
  310 : 
  311 :     real dt = dtCapped(t);
  312 :     if (dt <= 1e-9) break;
  313 : 
  314 :     real qHeaterNow = 0.0;
  315 :     if (t >= tPulseStart && t < tPulseEnd) qHeaterNow = qHeater;
  316 : 
  317 :     real tFieldsStart = clock();
  318 :     Ph3 inSlitRange = (x>=xSlitStart)*(x<=xSlitEnd);
  319 :     source = (1-inSlitRange)*sourceOfFull(region, Efun(x), T)
  320 :            + inSlitRange*( (z<zSlitCenter)*sourceOfFull(region, ElFun(x), T)
  321 :                           + (z>zSlitCenter)*sourceOfFull(region, ErFun(x), T) );
  322 :     Told = T;
  323 :     kfun = kOf(region, Told);
  324 :     rhocpfun = rhoCpOf(region, Told);
  325 :     real tFields = clock() - tFieldsStart;
  326 : 
  327 :     // Adaptive step bisection -- ported from electrothermal/
  328 :     // step_3d_slit_transient_diag.edp (see its CLAUDE.md, "Ramp collapse
  329 :     // breaks down above Ic" / "Adaptive step-size bisection" / "Above-Ic
  330 :     // phase: adaptive Jc-based step growth"). heatStep's solve leaves
  331 :     // solver= unspecified, so FreeFEM solves the (genuinely SPD) bilinear
  332 :     // form as a general system via UMFPACK, which can fail -- loudly (OOM
  333 :     // on pathological pivoting/fill-in) or silently (a technically-
  334 :     // completed but numerically garbage factorization) -- on an ill-
  335 :     // conditioned matrix. This project's material tables span many orders
  336 :     // of magnitude (e.g. buffer's placeholder sigmaBuf=1e-10 S/m), and the
  337 :     // failure was found to be node/hardware-dependent rather than a
  338 :     // deterministic function of dt, so no fixed-dt cap can be proven safe
  339 :     // in advance. Retry at half dt whenever the result isn't physically
  340 :     // sane, standard adaptive-FEA practice. maxStepRise is deliberately
  341 :     // generous (a real quench -- ~650K/s, the fastest observed this
  342 :     // project -- is only ~13K at pulse-phase dt) so this only ever fires
  343 :     // on genuine numerical garbage.
  344 :     //
  345 :     // Only the above-Ic ramp window gets the second, Jc-based accuracy
  346 :     // controller below -- below tCrossIc, I0(t) is still ramping toward
  347 :     // Ic with no current-sharing physics engaged yet (maxStepRise alone is
  348 :     // the right guard there), and the pulse/post-pulse phases already
  349 :     // have independently-validated fixed dt. This only actually triggers
  350 :     // once currentRatio>1 (see tCrossIc above); at the default ratio=0.7
  351 :     // it's a no-op, same as before ratio was parameterized.
  352 :     bool inAboveIcPhase = (currentRatio > 1.0 && t >= tCrossIc-1e-9 && t < Tramp-1e-9);
  353 :     real TmaxBefore = Told[].max, TminBefore = Told[].min;
  354 :     real jcBefore = JcT(TmaxBefore);
  355 :     // Normalize the Jc swing against a FIXED reference (Jc at the cold
  356 :     // base temperature), not the local jcBefore -- JcT is linear and hits
  357 :     // exactly 0 at Tc=90K, so as Tmax approaches Tc, jcBefore->0 and a
  358 :     // fraction normalized by it becomes unsatisfiable regardless of how
  359 :     // small dt gets. Ported already-fixed (see electrothermal/CLAUDE.md's
  360 :     // "Jc bisect fix" for the live bug this avoids: r1p36 spun for 13.3
  361 :     // hours approaching T=90K without ever crossing it under the original,
  362 :     // locally-normalized version of this check).
  363 :     real jcRef = JcT(Tcold);
  364 :     real dtTry = dt;
  365 :     int bisectCount = 0;
  366 :     real jcFrac = 0.0;
  367 :     bool solveOk = false;
  368 :     real tHeatStart = clock();
  369 :     while (!solveOk){
  370 :       solve heatStep(T, w) =
  371 :           int3d(Th3)( rhocpfun*T*w/dtTry + kfun*(dx(T)*dx(w) + dy(T)*dy(w) + dz(T)*dz(w)) )
  372 :         - int3d(Th3)( rhocpfun*Told*w/dtTry + source*w )
  373 :         - int2d(Th3, 3)( qHeaterNow*(x>xHeatLo)*(x<xHeatHi)*(z>zHeatLo)*(z<zHeatHi)*w )
  374 :         + on(2, 4, T=Tcold);
  375 :       // NaN checked separately from the rise bound -- a NaN comparison
  376 :       // against a finite bound via ">" is always false in IEEE-754, so a
  377 :       // diverged-to-NaN solve would otherwise never trip the bisection.
  378 :       bool isNan = (T[].max != T[].max) || (T[].min != T[].min);
  379 :       bool blewUp = isNan || (T[].max-TmaxBefore > maxStepRise) || (TminBefore-T[].min > maxStepRise);
  380 :       // Accuracy check, above-Ic phase only. Skipped once blewUp is
  381 :       // already true: no point computing Jc off catastrophically garbage
  382 :       // T[].max.
  383 :       bool jcTooFast = false;
  384 :       if (inAboveIcPhase && !blewUp){
  385 :         jcFrac = abs(JcT(T[].max)-jcBefore)/max(jcRef, 1e-30);
  386 :         jcTooFast = jcFrac > maxJcFracChange;
  387 :       }
  388 :       if (!blewUp && !jcTooFast) solveOk = true;
  389 :       else {
  390 :         bisectCount++;
  391 :         cout << "[bisect] step=" << step << " t=" << t << " dtTry=" << dtTry
  392 :              << " jcFrac=" << jcFrac << " Tmax=" << T[].max << " Tmin=" << T[].min
  393 :              << " -- halving (attempt " << bisectCount << "/" << maxBisections << ")" << endl;
  394 :         if (bisectCount > maxBisections){
  395 :           cout << "FATAL: heatStep did not stabilize after " << maxBisections
  396 :                << " bisections at t=" << t << " (started from dt=" << dt << ")" << endl;
  397 :           assert(false);
  398 :         }
  399 :         dtTry = dtTry/2.0;
  400 :       }
  401 :     }
  402 :     dt = dtTry;   // the committed dt, possibly smaller than originally requested
  403 :     // Grow the above-Ic guess for the NEXT step if this one was comfortably
  404 :     // inside the accuracy band; otherwise just carry forward whatever dt
  405 :     // actually worked, rather than re-attempting the same too-large value.
  406 :     if (inAboveIcPhase){
  407 :       if (jcFrac < 0.5*maxJcFracChange) rampDtAboveIc = dtTry*2.0;
  408 :       else rampDtAboveIc = dtTry;
  409 :     }
  410 :     real tHeatSolve = clock() - tHeatStart;
  411 : 
  412 :     t += dt;
  413 :     for (int i=0;i<5;i++) if (abs(t-phaseBounds[i])<1e-9) t = phaseBounds[i];
  414 :     step++;
  415 : 
  416 :     // CSV/diagnostic write moved to AFTER the (possibly-bisected) solve and
  417 :     // AFTER advancing t -- ported from the same electrothermal fix, and
  418 :     // fixing the identical bug here: writing before the solve meant a CSV
  419 :     // row's Tmax was always one physical step stale relative to what the
  420 :     // checkpoint ended up holding, so the truly-final row before an early
  421 :     // exit (tmaxCutoff, a bisection FATAL) would never reach
  422 :     // transient_3d_slit.csv at all. Voltage/Hall-probe diagnostics still
  423 :     // reflect the electrical solve computed from the step's STARTING
  424 :     // temperature (the model's existing staggered-scheme convention,
  425 :     // unchanged) -- only Tmax/TmaxLeft/TmaxRight need the post-solve,
  426 :     // just-committed state.
  427 :     real TmaxLeft = T(xHeatC,yCuTop,zLeftRep);
  428 :     real TmaxRight = T(xHeatC,yCuTop,zRightRep);
  429 :     // I0w (used above, in the solve and the electrical/voltage sub-solve)
  430 :     // is deliberately evaluated at the PRE-increment t -- an explicit,
  431 :     // frozen-coefficient source consistent with kfun/rhocpfun/Told, same
  432 :     // convention as fracLeft/voltages below. But I0 itself is an exactly-
  433 :     // known, purely time-driven function (no solve involved) -- there is
  434 :     // no reason to log a stale value for it. I0Now re-evaluates I0ofT at
  435 :     // the now-current (post-increment) t so the logged "I0" column
  436 :     // actually matches the timestamp it's printed against. Ported from
  437 :     // electrothermal/step_3d_slit_transient_diag.edp's "fix write lag
  438 :     // issue" -- see that track's CLAUDE.md for where it was first found
  439 :     // (r1p26's CSV showed I0=0 at its very first row because that row's
  440 :     // I0w was I0ofT(0) from the ramp's true start).
  441 :     real I0Now = I0ofT(t);
  442 :     cout << "t="<<t<<"s I0="<<I0Now<<" Tmax="<<T[].max<<" TmaxL="<<TmaxLeft<<" TmaxR="<<TmaxRight<<" fracLeft="<<fracLeft << endl;
  443 :     fout << t << "," << I0Now << "," << T[].max << "," << TmaxLeft << "," << TmaxRight << "," << fracLeft << "\n";
  444 : 
  445 :     real tDiagStart = clock();
  446 :     diagAllTapVoltages(diagVL, diagVR);
  447 :     real VclPlus = 0.0;
  448 :     real VclMinus = diagVcum(Lx, -1);   // == diagVcum(Lx,+1) by the slit's equal-voltage-drop closure condition
  449 :     // (I0Now above is the one exception to "diagnostics reflect the
  450 :     // step's starting state" -- it's not re-derived from a solve, just
  451 :     // re-evaluating the same closed-form ramp function at the correct
  452 :     // time, so there's no such tradeoff for it.)
  453 :     fdiag << t << "," << I0Now << "," << T[].max << "," << fracLeft << "," << VclPlus << "," << VclMinus;
  454 :     for (int i=0;i<nTapsPerSide;i++) fdiag << "," << diagVL[i];
  455 :     for (int i=0;i<nTapsPerSide;i++) fdiag << "," << diagVR[i];
  456 :     for (int i=0;i<nRTDsPerSide;i++) fdiag << "," << T(xRTD[i], yB7, zDiagLeft);
  457 :     for (int i=0;i<nRTDsPerSide;i++) fdiag << "," << T(xRTD[i], yB7, zDiagRight);
  458 :     real BatHallLeft = interp1(xSample, Bleft, nxs+1, xHall);
  459 :     real BatHallRight = interp1(xSample, Bright, nxs+1, xHall);
  460 :     fdiag << "," << BatHallLeft << "," << BatHallRight << "\n";
  461 :     real tDiag = clock() - tDiagStart;
  462 : 
  463 :     real tStepTotal = clock() - tStepStart;
  464 :     cout << "TIMING (s): Bfield=" << tBfield << "  electrical=" << tElectrical
  465 :          << "  diagnostics=" << tDiag << "  fieldAssign=" << tFields << "  heatSolve=" << tHeatSolve
  466 :          << "  bisections=" << bisectCount << "  ||  stepTotal=" << tStepTotal << endl;
  467 : 
  468 :     // Checkpoint after EVERY physical step, not just once at invocation
  469 :     // end -- ported from electrothermal's identical fix, now actually
  470 :     // relevant here too since -steps-per-invocation can exceed 1. Without
  471 :     // this, a crash/preemption partway through a multi-step invocation
  472 :     // would leave the checkpoint behind the CSV rows already written,
  473 :     // and --resume (once this workflow has one) would re-write
  474 :     // duplicate/overlapping t rows. Mesh-rebuild amortization (the reason
  475 :     // for -steps-per-invocation>1) is unaffected -- the mesh is only
  476 :     // built once per invocation regardless of how often this (cheap)
  477 :     // checkpoint file is rewritten.
  478 :     {
  479 :       ofstream fchkOut(outPrefix+"ckpt_3d_slit_transient.txt");
  480 :       fchkOut.precision(12);
  481 :       fchkOut << t << "\n";
  482 :       for (int i=0;i<T.n;i++) fchkOut << T[][i] << "\n";
  483 :       for (int i=0;i<=nxs;i++) fchkOut << Earr[i] << "\n";
  484 :       for (int i=0;i<=nxs;i++) fchkOut << ElArr[i] << "\n";
  485 :       for (int i=0;i<=nxs;i++) fchkOut << ErArr[i] << "\n";
  486 :     }
  487 :   }
  488 :   if (T[].max >= tmaxCutoff) cout << "Tmax cutoff " << tmaxCutoff << "K reached (Tmax="
  489 :        << T[].max << "K) -- stopping early, " << (maxStepsThisRun-step)
  490 :        << " step(s) skipped this invocation" << endl;
  491 : }
  492 : cout << "Saved checkpoint at t="<<t<<"s" << endl;
  493 : cout << "[profile] totalInvocation=" << (clock()-tInvocationStart) << "s" << endl;
