  110 :   if (rg==2 || rg==6) return rhomAg*cpAg(Tl);
  111 :   if (rg==3) return rhomHast*cpHast(Tl);
  112 :   if (rg==4) return rhomBuf*cpBuf(Tl);
  113 :   if (rg==5) return rhomSc*cpSc(Tl);
  114 :   return 1.0;   // region 7 (slit): nominal small value for well-posedness
  115 : }
