  131 : // Diagnostics (voltage taps / RTDs / Hall-probe placeholders) -- must be
  132 : // included after Efun/ElFun/ErFun above, per that file's header comment.
  133 : include "../shared/diagnostics_3d_slit.idp"// ============================================================
    2 : // diagnostics_3d_slit.idp
    3 : // Lab-instrumentation-style diagnostics export for the 3D slit model.
    4 : //
    5 : // Mimics a real diagnostics board (see user-provided layout diagram):
    6 : //   - 10 voltage taps per side (20 total), evenly spaced over 80% of
    7 : //     the slit length, centered on the slit/heater x-location.
    8 : //   - 8 RTD-style point temperature sensors per side (16 total),
    9 : //     nested at the midpoint of each tap-to-tap gap EXCEPT the one
   10 : //     gap that straddles the heater/Hall-probe location (no RTD
   11 : //     there, matching the diagram).
   12 : //   - 2 Hall-probe position placeholders (one per side, co-located
   13 : //     with the heater), reserved but NOT wired to any B-field
   14 : //     computation yet -- exported as a fixed sentinel value until the
   15 : //     self-field roadmap item is implemented.
   16 : //   - V_CL+ / V_CL- : the current-lead voltage reference points at the
   17 : //     tape ends (x=0, x=Lx), outside the slit -- single channel there.
   18 : //
   19 : // IMPORTANT -- scope/inclusion requirements:
   20 : //   This file assumes the INCLUDING script has ALREADY defined, with
   21 : //   exactly these names (as step_3d_slit_transient.edp does):
   22 : //     real Lx, width, xSlitStart, xSlitEnd, yB7
   23 : //     func real Efun(real xx)   -- full-channel E, valid outside slit range
   24 : //     func real ElFun(real xx)  -- left-channel E,  valid inside slit range
   25 : //     func real ErFun(real xx)  -- right-channel E, valid inside slit range
   26 : //   Include this file AFTER those are defined (i.e. after the E-field
   27 : //   sampling arrays for the current timestep have been filled), not
   28 : //   at the top of the script, since tap voltages must reflect the
   29 : //   CURRENT timestep's field. Positions/metadata below are static and
   30 : //   only need to be computed once, but voltage evaluation
   31 : //   (diagVoltage/diagAllTapVoltages) must be called freshly each step.
   32 : // ============================================================
   33 : 
   34 : // ---- physical z-locations representing "side" (matches TmaxLeft/
   35 : // TmaxRight convention already used elsewhere in the transient script) ----
   36 : real zDiagLeft  = width/4;
   37 : real zDiagRight = 3*width/4;
   38 : 
   39 : // ---- tap layout: 10 per side, 80% of slit length, centered on slit ----
   40 : int nTapsPerSide = 10;
   41 : real slitLen    = xSlitEnd - xSlitStart;
   42 : real spanCenter = 0.5*(xSlitStart + xSlitEnd);
   43 : real spanFrac   = 0.8;
   44 : real spanLen    = spanFrac*slitLen;
   45 : real xSpanLo    = spanCenter - 0.5*spanLen;
   46 : real xSpanHi    = spanCenter + 0.5*spanLen;
   47 : real tapSpacing = spanLen/(nTapsPerSide-1);
   48 : 
   49 : real[int] xTap(nTapsPerSide);
   50 : for (int i=0; i<nTapsPerSide; i++) xTap[i] = xSpanLo + i*tapSpacing;
   51 : 
   52 : // ---- RTD layout: one at the midpoint of each tap-gap, except the
   53 : // gap straddling spanCenter (heater/Hall location) ----
   54 : int nGaps = nTapsPerSide - 1;
   55 : int heaterGapIdx = -1;
   56 : for (int i=0; i<nGaps; i++)
   57 :   if (xTap[i] <= spanCenter+1e-12 && xTap[i+1] >= spanCenter-1e-12) heaterGapIdx = i;
   58 : 
   59 : int nRTDsPerSide = nGaps - 1;
   60 : real[int] xRTD(nRTDsPerSide);
   61 : {
   62 :   int k = 0;
   63 :   for (int i=0; i<nGaps; i++){
   64 :     if (i == heaterGapIdx) continue;
   65 :     xRTD[k] = 0.5*(xTap[i] + xTap[i+1]);
   66 :     k++;
   67 :   }
   68 : }
   69 : 
   70 : // ---- Hall probe placeholder positions (reserved, not yet computed) ----
   71 : real xHall = spanCenter;   // co-located with heater, per diagram (H_1/H_2)
   72 : real hallNotModeled = -999.0;   // sentinel: B-field modeling not yet implemented
   73 : 
   74 : // ---- field integration: honors the slit's L/R channel split ----
   75 : // side: -1 = left (z=zDiagLeft), +1 = right (z=zDiagRight)
   76 : func real diagEfield(real xx, int side){
   77 :   if (xx < xSlitStart || xx > xSlitEnd) return Efun(xx);
   78 :   return (side < 0) ? ElFun(xx) : ErFun(xx);
   79 : }
   80 : 
   81 : // Cumulative voltage from x=0 (V_CL+ reference) out to xx, along the
   82 : // given side's physical conductor path. Midpoint-rule integration --
   83 : // cheap (interpolation lookups only, no solve) so a fine sub-count is
   84 : // fine even though this runs every timestep.
   85 : func real diagVcum(real xx, int side){
   86 :   int nSub = 400;
   87 :   real h = xx/nSub;
   88 :   real sum = 0.0;
   89 :   for (int j=0; j<nSub; j++){
   90 :     real xm = (j+0.5)*h;
   91 :     sum += diagEfield(xm, side)*h;
   92 :   }
   93 :   return sum;
   94 : }
   95 : 
   96 : // Fills two length-nTapsPerSide arrays with the current cumulative tap
   97 : // voltages for left/right. Call once per timestep after Efun/ElFun/
   98 : // ErFun have been refreshed for that step.
   99 : func int diagAllTapVoltages(real[int] &VL, real[int] &VR){
  100 :   for (int i=0; i<nTapsPerSide; i++){
  101 :     VL[i] = diagVcum(xTap[i], -1);
  102 :     VR[i] = diagVcum(xTap[i], +1);
  103 :   }
  104 :   return 0;
  105 : }
  106 : 
  107 : // One-time metadata export: physical location + type of every channel,
  108 : // written once (not per-row) so it doesn't bloat the timeseries CSV.
  109 : func int writeDiagnosticsMetadata(string fname){
  110 :   ofstream fmeta(fname);
  111 :   fmeta << "channel,type,side,x_m,y_m,z_m,notes\n";
  112 :   for (int i=0; i<nTapsPerSide; i++){
  113 :     fmeta << "V1_" << (i+1) << ",voltage_tap,left," << xTap[i] << "," << yB7 << "," << zDiagLeft  << ",cumulative from V_CL+\n";
  114 :     fmeta << "V2_" << (i+1) << ",voltage_tap,right," << xTap[i] << "," << yB7 << "," << zDiagRight << ",cumulative from V_CL+\n";
  115 :   }
  116 :   for (int i=0; i<nRTDsPerSide; i++){
  117 :     fmeta << "RTD1_" << (i+1) << ",temperature_rtd,left," << xRTD[i] << "," << yB7 << "," << zDiagLeft  << ",surface-mounted (top Cu)\n";
  118 :     fmeta << "RTD2_" << (i+1) << ",temperature_rtd,right," << xRTD[i] << "," << yB7 << "," << zDiagRight << ",surface-mounted (top Cu)\n";
  119 :   }
  120 :   fmeta << "H1,hall_probe,left," << xHall << "," << yB7 << "," << zDiagLeft  << ",PLACEHOLDER - not yet wired to B-field computati
  ... : on\n";
  121 :   fmeta << "H2,hall_probe,right," << xHall << "," << yB7 << "," << zDiagRight << ",PLACEHOLDER - not yet wired to B-field computati
  ... : on\n";
  122 :   fmeta << "V_CL_plus,current_lead_voltage,n/a,0," << yB7 << ",n/a,reference (=0 by construction)\n";
  123 :   fmeta << "V_CL_minus,current_lead_voltage,n/a," << Lx << "," << yB7 << ",n/a,far current lead\n";
  124 :   return 0;
  125 : }
