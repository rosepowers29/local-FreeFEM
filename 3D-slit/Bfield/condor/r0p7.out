   25 : 
   26 : // currentRatio/outPrefix let a run_transient.py-style wrapper drive this
   27 : // script without editing it -- ported from electrothermal/
   28 : // step_3d_slit_transient_diag.edp. Defaults reproduce this script's
   29 : // exact prior hardcoded behavior (ratio=0.7, output files in the CWD)
   30 : // when invoked with no extra flags.
   31 : real currentRatio = getARGV("-ratio", 0.7);
   32 : string outPrefix  = getARGV("-outprefix", "");
   33 : cout << "[profile] meshBuild=" << (tMeshDone-tMeshStart) << "s materialsLoad="
   34 :      << (tMaterialsDone-tMeshDone) << "s" << endl;
   35 : 
   36 : real Tcold = 77.0;
   37 : real IcRebcoActual = JcT(77.0)*tSc*coreWidth;
   38 : real I0Target = currentRatio * IcRebcoActual;
   39 : 
   40 : real shellAreaFull = width*yB7 - coreWidth*(yB6-yB1);
   41 : real leftCoreWidth  = (zSlitCenter-slitR) - zB1;
   42 : real rightCoreWidth = zB2 - (zSlitCenter+slitR);
   43 : real leftShellArea  = tSideCu*yB7 + (tCuB+tCuT)*leftCoreWidth;
   44 : real rightShellArea = tSideCu*yB7 + (tCuB+tCuT)*rightCoreWidth;
   45 : 
   46 : real xHeatC = Lx/2, zHeatC = width/4;   // LEFT side only
   47 : real xHeatLo = xHeatC-1e-3, xHeatHi = xHeatC+1e-3;
   48 : real zHeatLo = zHeatC-1e-3, zHeatHi = zHeatC+1e-3;
   49 : real heaterPower = 13.0;
   50 : real qHeater = heaterPower/(2e-3*2e-3);
   51 : 
   52 : // rampRateTarget (-ramprate, A/s) / rampDt (-rampdt) / rampDtAboveIc
   53 : // (-rampdt-aboveic, MUTATED by the step loop's adaptive controller below)
   54 : // / maxJcFracChange (-maxjcfracchange) -- ported verbatim from
   55 : // electrothermal/step_3d_slit_transient_diag.edp, including the
   56 : // jcRef-vs-Tcold fix already applied there (see the step loop below for
   57 : // why jcRef, not the local jcBefore, is used as the fractional-change
   58 : // denominator). Defaults reproduce this script's exact prior fixed-0.5s-
   59 : // ramp behavior when unflagged.
   60 : real rampRateTarget = getARGV("-ramprate", 0.0);
   61 : real rampDt = getARGV("-rampdt", 0.05);
   62 : real rampDtAboveIc = getARGV("-rampdt-aboveic", 0.002);
   63 : real maxJcFracChange = getARGV("-maxjcfracchange", 0.05);
   64 : real Tramp = 0.5;
   65 : if (rampRateTarget > 0.0) Tramp = I0Target/rampRateTarget;
   66 : // tCrossIc: when I0(t)=I0Target*(tt/Tramp) first reaches IcRebcoActual.
   67 : // For currentRatio<=1, I0(t) never reaches Ic during the ramp, so this
   68 : // equals Tramp exactly -- dtRaw/phaseBounds below are then byte-for-byte
   69 : // unchanged from this script's pre-parameterization behavior.
   70 : real tCrossIc = (currentRatio > 1.0) ? Tramp/currentRatio : Tramp;
   71 : real tPulseStart = Tramp, tPulseDur = 0.01, tPulseEnd = tPulseStart+tPulseDur;
   72 : real tEnd = tPulseEnd + 1.5;
   73 : 
   74 : func real I0ofT(real tt){
   75 :   if (tt < Tramp) return I0Target*(tt/Tramp);
   76 :   return I0Target;
   77 : }
   78 : real[int] phaseBounds = [tCrossIc, Tramp, tPulseStart, tPulseEnd, tEnd];
   79 : func real dtRaw(real tt){
   80 :   if (tt < tCrossIc) return rampDt;
   81 :   if (tt < Tramp) return rampDtAboveIc;
   82 :   if (tt < tPulseEnd) return 0.002;
   83 :   if (tt > tPulseEnd + 0.2) return 0.02;
   84 :   return 0.01;
   85 : }
   86 : func real dtCapped(real tt){
   87 :   real d = dtRaw(tt);
   88 :   for (int i=0;i<5;i++) if (tt < phaseBounds[i]-1e-9 && tt+d > phaseBounds[i]) d = phaseBounds[i]-tt;
   89 :   return d;
   90 : }
