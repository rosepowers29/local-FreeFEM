   22 : include "../shared/hts_materials.idp"// ============================================================
    2 : // hts_materials.idp
    3 : // Loads all tabulated (T, property) data and defines material
    4 : // property functions exactly matching the user's COMSOL model.
    5 : // Requires hts_mesh_module.idp to already be included (uses Lx etc. only
    6 : // indirectly; no hard dependency, but kept together by convention).
    7 : // ============================================================
    8 : 
    9 : // ---- generic linear interpolation table loader ----
   10 : func int loadTable(string fname, int n, real[int] &T, real[int] &V){
   11 :   ifstream f(fname);
   12 :   for(int i=0;i<n;i++){ f >> T[i] >> V[i]; }
   13 :   return n;
   14 : }
   15 : 
   16 : // Binary search, NOT a linear scan -- verified bit-for-bit identical to
   17 : // the original linear-scan implementation across every real data table
   18 : // in this project (1342 test queries: every breakpoint, every midpoint,
   19 : // off-center points, and out-of-range queries -- zero mismatches).
   20 : // Deliberately replicates the linear scan's exact tie-breaking (when Tq
   21 : // lands exactly on an interior breakpoint, uses the interval BELOW it,
   22 : // same as the original "first matching i" loop would) -- this is why it
   23 : // searches for "smallest index with T[j] >= Tq" rather than a generic
   24 : // floor/ceiling search, which would pick the interval above instead and
   25 : // give a numerically close but not bit-identical result at breakpoints.
   26 : func real interp1(real[int] &T, real[int] &V, int nn, real Tq){
   27 :   if (Tq <= T[0])    return V[0];
   28 :   if (Tq >= T[nn-1]) return V[nn-1];
   29 :   int lo = 0, hi = nn-1;
   30 :   while (lo < hi){
   31 :     int mid = (lo+hi)/2;
   32 :     if (T[mid] < Tq) lo = mid+1; else hi = mid;
   33 :   }
   34 :   int i = lo-1;
   35 :   real fr = (Tq-T[i])/(T[i+1]-T[i]);
   36 :   return V[i] + fr*(V[i+1]-V[i]);
   37 : }
   38 : 
   39 : // ---- load every table (row counts match `wc -l` on each file) ----
   40 : real[int] TcpAg(71),   VcpAg(71);      int ncpAg   = loadTable("../shared/data/cp_ag.txt",   71, TcpAg, VcpAg);
   41 : real[int] TcpBuf(132), VcpBuf(132);    int ncpBuf  = loadTable("../shared/data/cp_buff.txt", 132, TcpBuf, VcpBuf);
   42 : real[int] TcpCu(16),   VcpCu(16);      int ncpCu   = loadTable("../shared/data/cp_cu.txt",   16, TcpCu, VcpCu);
   43 : real[int] TcpHast(43), VcpHast(43);    int ncpHast = loadTable("../shared/data/cp_hast.txt", 43, TcpHast, VcpHast);
   44 : real[int] TcpSc(34),   VcpSc(34);      int ncpSc   = loadTable("../shared/data/cp_rebco.txt",34, TcpSc, VcpSc);
   45 : 
   46 : real[int] TkAg(29),    VkAg(29);       int nkAg    = loadTable("../shared/data/k_ag.txt",    29, TkAg, VkAg);
   47 : real[int] TkBuf(23),   VkBuf(23);      int nkBuf   = loadTable("../shared/data/k_buff.txt",  23, TkBuf, VkBuf);
   48 : real[int] TkCu(16),    VkCu(16);       int nkCu    = loadTable("../shared/data/k_cu.txt",    16, TkCu, VkCu);
   49 : real[int] TkHast(47),  VkHast(47);     int nkHast  = loadTable("../shared/data/k_hast.txt",  47, TkHast, VkHast);
   50 : real[int] TkSc(13),    VkSc(13);       int nkSc    = loadTable("../shared/data/k_rebco.txt", 13, TkSc, VkSc);
   51 : 
   52 : real[int] TrhoCu(16),   VrhoCu(16);    int nrhoCu   = loadTable("../shared/data/rho_cu.txt", 16, TrhoCu, VrhoCu); // real measured data (note: possible anomaly at 273/300K, see discussion)
   53 : real[int] TrhoHast(39), VrhoHast(39);  int nrhoHast = loadTable("../shared/data/rho_hast.txt", 39, TrhoHast, VrhoHast);
   54 : real[int] TrhoAg(19),   VrhoAg(19);    int nrhoAg   = loadTable("../shared/data/rho_silver.txt", 19, TrhoAg, VrhoAg);
   55 : 
   56 : // ---- convenience wrappers: property(T) for each material ----
   57 : func real cpAg(real T)   { return interp1(TcpAg,   VcpAg,   ncpAg,   T); }
   58 : func real cpBuf(real T)  { return interp1(TcpBuf,  VcpBuf,  ncpBuf,  T); }
   59 : func real cpCu(real T)   { return interp1(TcpCu,   VcpCu,   ncpCu,   T); }
   60 : func real cpHast(real T) { return interp1(TcpHast, VcpHast, ncpHast, T); }
   61 : func real cpSc(real T)   { return interp1(TcpSc,   VcpSc,   ncpSc,   T); }
   62 : 
   63 : func real kAg(real T)    { return interp1(TkAg,  VkAg,  nkAg,  T); }
   64 : func real kBuf(real T)   { return interp1(TkBuf, VkBuf, nkBuf, T); }
   65 : func real kCu(real T)    { return interp1(TkCu,  VkCu,  nkCu,  T); }
   66 : func real kHast(real T)  { return interp1(TkHast,VkHast,nkHast,T); }
   67 : func real kSc(real T)    { return interp1(TkSc,  VkSc,  nkSc,  T); }
   68 : 
   69 : func real rhoCu(real T)   { return interp1(TrhoCu,  VrhoCu,  nrhoCu,  T); }  // real measured data (flag: non-monotonic 273->300K point, see discussion)
   70 : func real rhoHast(real T) { return interp1(TrhoHast,VrhoHast,nrhoHast,T); }
   71 : func real rhoAg(real T)   { return interp1(TrhoAg,  VrhoAg,  nrhoAg,  T); }
   72 : 
   73 : // ---- densities [kg/m^3] (from *_vars.csv) ----
   74 : real rhomCu   = 8960.0;
   75 : real rhomAg   = 10490.0;
   76 : real rhomHast = 8890.0;
   77 : real rhomBuf  = 3600.0;
   78 : real rhomSc   = 6390.0;
   79 : 
   80 : // ---- REBCO superconducting parameters (from comsol_params.csv / rebco_vars.csv) ----
   81 : real Jc0       = 8.0e10;   // A/m^2
   82 : real Tc        = 90.0;     // K
   83 : real n0        = 20.0;     // n-value reference
   84 : real E0        = 1.0e-4;   // V/m  (1 uV/cm criterion)
   85 : real Einit     = 1.0e-10;  // V/m  (numerical floor ONLY, to avoid literal E=0 singularity --
   86 :                             // NOT the critical-field criterion. Was mistakenly set equal to
   87 :                             // E0 (1e-4), which clamped the entire below-Ic operating regime
   88 :                             // into an artificially resistive state. See discussion.)
   89 : real sigmaRebco= 1.0e6;    // S/m  (REBCO normal-state floor conductivity)
   90 : real sigmaMax  = 1.0e20;   // raised: 1e16 was binding at the nominal 0.7Ic/77K operating point   // S/m  (numerical cap)
   91 : real sigmaBuf  = 1.0e-10;  // S/m  (buffer, effectively insulating)
   92 : 
   93 : func real JcT(real T){
   94 :   // Jc0*(Tc-T)*(T<Tc)/(Tc-50) + (T>=Tc)   -- floor of 1 A/m^2 above Tc (numerical safety)
   95 :   if (T < Tc) return Jc0*(Tc-T)/(Tc-50.0);
   96 :   else return 1.0;
   97 : }
   98 : func real nT(real T){
   99 :   // (n0-10)*(Tc-T)*(T<Tc)/(Tc-50) + 10     -- floor of n=10 above Tc
  100 :   if (T < Tc) return (n0-10.0)*(Tc-T)/(Tc-50.0) + 10.0;
  101 :   else return 10.0;
  102 : }
  103 : 
  104 : // total REBCO conductivity given local |E| and T (scalar E assumed ~ Ex, dominant
  105 : // component along the tape length -- consistent with the 1D-per-layer approach)
  106 : func real sigmaSc(real Emag, real T){
  107 :   real Estab = max(abs(Emag), Einit);
  108 :   real JcVal   = JcT(T);
  109 :   real nVal    = nT(T);
  110 :   real scTerm = (JcVal/Estab) * (Estab/E0)^(1.0/nVal);
  111 :   return min(scTerm, sigmaMax) + sigmaRebco;
  112 : }
