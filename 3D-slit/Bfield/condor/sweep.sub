# Condor submit file: one job per current ratio, ratio-level parallelism
# (embarrassingly parallel -- each ratio is fully independent, isolated
# into its own runs/<label>/ by run_bfield_transient.py already). Ported
# from electrothermal/condor/sweep.sub -- see condor/README.md before
# submitting a real sweep with this, and that track's own README.md for
# the underlying Condor-syntax/resource-sizing caveats this inherits
# unverified.

universe        = container
# Unified container syntax (HTCondor 9.0+): container_image accepts both
# a Docker reference (docker://registry/image:tag) and a local Apptainer/
# Singularity .sif path. UNVERIFIED against this pool's actual HTCondor
# version -- same caveat electrothermal's sweep.sub carries; ask pool
# admins which applies and swap this block if needed.
#
# Reuses electrothermal's exact published image (same digest) rather
# than building a separate one: the image is track-agnostic (FreeFEM +
# Ubuntu + python3 only, see ../../electrothermal/condor/Dockerfile --
# no project code or data baked in, that's transferred separately via
# payload.tar.gz). Building a Bfield-specific image would be identical
# content under a different tag -- pure duplicated build/push/digest-
# pinning effort for zero functional difference. If you'd rather have a
# Bfield-tagged image for naming clarity, `docker buildx build` the same
# Dockerfile as `local-freefem-bfield` and update this line to match.
container_image = docker://ghcr.io/rosepowers29/local-freefem-electrothermal@sha256:8b39db74c15d90180fb623cda03211d434ce619cd3786c3abbd37de930aed37c

# The published image is amd64-only (confirmed: no aarch64 variant) --
# guarantee it never lands on a non-x86_64 execute node, in case this
# pool has any in the mix.
requirements = (Arch == "X86_64")

executable      = condor_run_ratio.sh
# ramp_rate/ramp_dt: pool-level constants (not a per-ratio sweep
# dimension, same class as max_wall_seconds/request_memory below) --
# 20 A/s matches electrothermal's validated collaborator-requested ramp
# (electrothermal/CLAUDE.md's "Ramp rate / ramp-dt -- validated") and
# this workflow's own r1p2/r1p2-sc confirmation runs (CLAUDE.md), which
# used this exact -ramprate 20.0 -rampdt 999.0 pair. **The 2026-10-06
# sweep that first used this file omitted both flags entirely**, silently
# falling through to run_bfield_transient.py's old 0.0 sentinel (the
# .edp's original fixed 0.5s ramp, implying ~435-933 A/s depending on
# ratio, not 20) -- a real gap in this submit file, not in the .edp,
# found while analyzing that sweep's results and fixed here. That
# already-landed fast-ramp sweep is being kept as its own valid dataset,
# not discarded -- see CLAUDE.md's "Realistic 20 A/s ramp" section.
# ramp_dt=999 collapses the sub-Ic ramp phase to a single step
# (validated safe for currentRatio<=1); it must be raised together with
# ramp_rate or the slow ramp silently pays a 2.5-4.3x step-count penalty
# for zero accuracy benefit (see CLAUDE.md).
ramp_rate = 20.0
ramp_dt = 999.0
#
# pulse_dt/max_picard_iter: also pool-level constants. Found (real
# landed-diagnostics evidence) that -selfconsistent Picard non-
# convergence in the 0.70-1.20 ratio band is caused by the heater
# pulse's abrupt onset within its fixed dt window -- independent of ramp
# rate. pulse_dt=0.0005 (4x finer than the .edp's own 0.002 unflagged
# default) shrinks that per-step jump directly; max_picard_iter=40 (was
# 20) gives headroom for whatever residual stiffness remains. Starting
# values to confirm via a real smoke test -- see CLAUDE.md's
# "Heater-pulse Picard non-convergence" -- not final numbers.
pulse_dt = 0.0005
max_picard_iter = 40
#
# max_wall_seconds: found via a real sweep: some ratios -- almost
# certainly the ones sitting right at the marginal/slow-to-settle quench
# threshold -- ran past this pool's own ~20h walltime cap and got
# forcibly killed mid-run, which our on_exit_hold/periodic_release retry
# logic then blindly retried up to 4x (burning up to 4x the pool's cap
# for a DETERMINISTIC timeout that just repeats, unlike the node-
# dependent UMFPACK failures that policy was built for). 64800s=18h
# leaves a margin under that observed 20h cap -- adjust to match your
# pool's actual enforced limit if you've confirmed a different number.
# See CLAUDE.md's "Large aniso+self-consistent sweep" for the incident.
max_wall_seconds = 64800
arguments       = $(ratio) $(label) --runaway-tmax $(runaway_tmax) --aniso $(aniso) --selfconsistent $(selfconsistent) --heater-power $(heaterpower) --ramp-rate $(ramp_rate) --ramp-dt $(ramp_dt) --pulse-dt $(pulse_dt) --max-picard-iter $(max_picard_iter) --max-wall-seconds $(max_wall_seconds)

should_transfer_files   = YES
when_to_transfer_output = ON_EXIT
transfer_input_files    = payload.tar.gz
transfer_output_files   = work/runs/$(label)

# First-pass guesses carried over from electrothermal's sweep.sub, NOT
# re-measured for Bfield specifically -- the mesh is the same size
# (~88K DOF, same hts_mesh_module_3d_slit.idp) but this workflow does
# extra per-step work (Biot-Savart self-field reconstruction), so actual
# memory/CPU usage may differ. Run one job, check its actual usage
# (condor_q -long, or the job's .log after completion), and tune before
# trusting a full unattended sweep.
request_cpus   = 1
request_memory = 4096M
request_disk   = 2048M

output = logs/$(label).out
error  = logs/$(label).err
log    = logs/$(label).log
# Without these, Condor buffers stdout/stderr until the job exits -- see
# electrothermal/condor/README.md for why that matters for a
# multi-hour job.
stream_output = True
stream_error  = True

# Auto-retry on a RETRY_WORTHY exit code -- same policy and same
# reasoning as electrothermal/condor/sweep.sub (node-heterogeneity
# found there, not independently confirmed for Bfield, but the
# underlying mechanism -- UMFPACK on an ill-conditioned matrix -- is
# identical since both tracks share the same material tables and
# unspecified solver=). Requires run_bfield_transient.py's main() to
# exit 1 on a RETRY_WORTHY status, which it does (ported from
# electrothermal's identical fix).
on_exit_hold        = (ExitCode != 0)
on_exit_hold_reason  = "run_bfield_transient.py reported a RETRY_WORTHY status (see CLAUDE.md) -- auto-releasing to retry, likely on a different execute node"
periodic_release     = (NumJobStarts < 4) && ((CurrentTime - EnteredCurrentStatus) > 300)

queue ratio,label,runaway_tmax,aniso,selfconsistent,heaterpower from ratios.txt
