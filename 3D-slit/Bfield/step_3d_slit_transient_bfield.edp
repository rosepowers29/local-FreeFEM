// ============================================================
// step_3d_slit_transient_bfield.edp
// Full transient scenario WITH the slit: ramp current to a target
// transport-current ratio (currentRatio*Ic, default 0.7 -- see -ratio)
// over the ramp phase, then apply the 2mm x 2mm / 13W / 10ms spot heater
// on the LEFT side only (z=width/4), then observe recovery or runaway --
// and critically, track how the current SPLIT between left/right
// evolves.
//
// Electrical model: outside the slit's x-range, one equipotential
// channel. WITHIN the slit's x-range, current splits into two
// independent parallel paths matched by equal voltage drop across the
// slit's length (cheap bisection, redone every timestep -- no 3D solve
// involved in this sub-solve).
// ============================================================

real tInvocationStart = clock();

real tMeshStart = clock();
include "../shared/hts_mesh_module_3d_slit.idp"
real tMeshDone = clock();
include "../shared/hts_materials.idp"
real tMaterialsDone = clock();
include "getARGV.idp"

// currentRatio/outPrefix let a run_transient.py-style wrapper drive this
// script without editing it -- ported from electrothermal/
// step_3d_slit_transient_diag.edp. Defaults reproduce this script's
// exact prior hardcoded behavior (ratio=0.7, output files in the CWD)
// when invoked with no extra flags.
real currentRatio = getARGV("-ratio", 0.7);
string outPrefix  = getARGV("-outprefix", "");
cout << "[profile] meshBuild=" << (tMeshDone-tMeshStart) << "s materialsLoad="
     << (tMaterialsDone-tMeshDone) << "s" << endl;

real Tcold = 77.0;
real IcRebcoActual = JcT(77.0)*tSc*coreWidth;
real I0Target = currentRatio * IcRebcoActual;

real shellAreaFull = width*yB7 - coreWidth*(yB6-yB1);
real leftCoreWidth  = (zSlitCenter-slitR) - zB1;
real rightCoreWidth = zB2 - (zSlitCenter+slitR);
real leftShellArea  = tSideCu*yB7 + (tCuB+tCuT)*leftCoreWidth;
real rightShellArea = tSideCu*yB7 + (tCuB+tCuT)*rightCoreWidth;

real xHeatC = Lx/2, zHeatC = width/4;   // LEFT side only
real xHeatLo = xHeatC-1e-3, xHeatHi = xHeatC+1e-3;
real zHeatLo = zHeatC-1e-3, zHeatHi = zHeatC+1e-3;
// -heaterpower (W) lets a sweep disable the heater entirely (0.0) to
// isolate pure above-Ic ramp-driven quench behavior from heater-triggered
// quench -- default 13.0 reproduces this script's exact prior behavior
// when unflagged. tPulseStart/tPulseEnd/the pulse-phase dt schedule
// (dtRaw) are UNCHANGED by this -- qHeaterNow is simply 0 throughout if
// heaterPower=0, rather than removing the pulse-phase fine-dt window
// itself, so a 0-heater run still gets the same time resolution through
// that phase as a real-heater run at the same ratio (needed for a clean
// apples-to-apples comparison between the two).
real heaterPower = getARGV("-heaterpower", 13.0);
real qHeater = heaterPower/(2e-3*2e-3);

// rampRateTarget (-ramprate, A/s) / rampDt (-rampdt) / rampDtAboveIc
// (-rampdt-aboveic, MUTATED by the step loop's adaptive controller below)
// / maxJcFracChange (-maxjcfracchange) -- ported verbatim from
// electrothermal/step_3d_slit_transient_diag.edp, including the
// jcRef-vs-Tcold fix already applied there (see the step loop below for
// why jcRef, not the local jcBefore, is used as the fractional-change
// denominator). Defaults reproduce this script's exact prior fixed-0.5s-
// ramp behavior when unflagged.
real rampRateTarget = getARGV("-ramprate", 0.0);
real rampDt = getARGV("-rampdt", 0.05);
real rampDtAboveIc = getARGV("-rampdt-aboveic", 0.002);
real maxJcFracChange = getARGV("-maxjcfracchange", 0.05);
// -pulsedt: dt used strictly inside [tPulseStart, tPulseEnd] (default
// 0.002, today's exact hardcoded value -- unflagged behavior unchanged).
// The heater's onset is a near-discontinuous local source term switched
// on within this fixed-duration window regardless of -ramprate/-rampdt
// -- found (grepping real landed diagnostics, not guessed) to be the
// actual root cause of -selfconsistent Picard non-convergence in the
// 0.70-1.20 ratio band, independent of ramp rate. A finer value here
// shrinks the per-step jump in that abrupt transition directly, rather
// than just giving the Picard loop a bigger budget to grind through the
// same stiffness. See Bfield/CLAUDE.md's "Heater-pulse Picard
// non-convergence" section.
real pulseDt = getARGV("-pulsedt", 0.002);
real Tramp = 0.5;
if (rampRateTarget > 0.0) Tramp = I0Target/rampRateTarget;
// tCrossIc: when I0(t)=I0Target*(tt/Tramp) first reaches IcRebcoActual.
// For currentRatio<=1, I0(t) never reaches Ic during the ramp, so this
// equals Tramp exactly -- dtRaw/phaseBounds below are then byte-for-byte
// unchanged from this script's pre-parameterization behavior.
real tCrossIc = (currentRatio > 1.0) ? Tramp/currentRatio : Tramp;
real tPulseStart = Tramp, tPulseDur = 0.01, tPulseEnd = tPulseStart+tPulseDur;
real tEnd = tPulseEnd + 1.5;

func real I0ofT(real tt){
  if (tt < Tramp) return I0Target*(tt/Tramp);
  return I0Target;
}
real[int] phaseBounds = [tCrossIc, Tramp, tPulseStart, tPulseEnd, tEnd];
func real dtRaw(real tt){
  if (tt < tCrossIc) return rampDt;
  if (tt < Tramp) return rampDtAboveIc;
  if (tt < tPulseEnd) return pulseDt;
  if (tt > tPulseEnd + 0.2) return 0.02;
  return 0.01;
}
func real dtCapped(real tt){
  real d = dtRaw(tt);
  for (int i=0;i<5;i++) if (tt < phaseBounds[i]-1e-9 && tt+d > phaseBounds[i]) d = phaseBounds[i]-tt;
  return d;
}

func real kOf(int rg, real Tl){
  if (rg==1) return kCu(Tl);
  if (rg==2 || rg==6) return kAg(Tl);
  if (rg==3) return kHast(Tl);
  if (rg==4) return kBuf(Tl);
  if (rg==5) return kSc(Tl);
  if (rg==7) return 1e-2;
  return 1.0;
}
func real sourceOfFull(int rg, real Ef, real Tl){
  if (rg==1) return Ef^2/rhoCu(Tl);
  if (rg==2 || rg==6) return Ef^2/rhoAg(Tl);
  if (rg==3) return Ef^2/rhoHast(Tl);   // Hastelloy: now a genuine parallel branch, not excluded
  if (rg==5) return sigmaSc(Ef,Tl)*Ef^2;
  return 0.0;   // region 4 (buffer) remains excluded -- see bfield_3d_slit.idp header note
}
func real rhoCpOf(int rg, real Tl){
  if (rg==1) return rhomCu*cpCu(Tl);
  if (rg==2 || rg==6) return rhomAg*cpAg(Tl);
  if (rg==3) return rhomHast*cpHast(Tl);
  if (rg==4) return rhomBuf*cpBuf(Tl);
  if (rg==5) return rhomSc*cpSc(Tl);
  return 1.0;   // region 7 (slit): nominal small value for well-posedness
}

// (The non-B-aware ItotFull/solveEFull/ItotHalf/solveEHalf that used to
// live here were dead code -- never called; the actual solve uses only
// the B-aware solveEFullB/solveEHalfB from bfield_3d_slit.idp. Removed
// rather than left stale, since leaving them would mean an un-fixed
// duplicate missing the Hastelloy branch below sitting right next to
// the real implementation.)

int nxs = 60;
real[int] xSample(nxs+1), Earr(nxs+1), ElArr(nxs+1), ErArr(nxs+1);
for (int i=0;i<=nxs;i++) xSample[i] = Lx*i/nxs;
func real Efun(real xx){ return interp1(xSample, Earr, nxs+1, xx); }
func real ElFun(real xx){ return interp1(xSample, ElArr, nxs+1, xx); }
func real ErFun(real xx){ return interp1(xSample, ErArr, nxs+1, xx); }

// Diagnostics (voltage taps / RTDs / Hall-probe placeholders) -- must be
// included after Efun/ElFun/ErFun above, per that file's header comment.
include "../shared/diagnostics_3d_slit.idp"
real[int] diagVL(nTapsPerSide), diagVR(nTapsPerSide);

fespace Vh3(Th3, P1);
fespace Ph3(Th3, P0);
Ph3 reg = region;
Vh3 T, Told, w;
Ph3 kfun, source, rhocpfun;

real yCuTop=yB7-1e-9, yAgBmid=0.5*(yB1+yB2), yHastMid=0.5*(yB2+yB3), yScmid=0.5*(yB4+yB5), yAgTmid=0.5*(yB5+yB6);
real zLeftRep = width/4, zRightRep = 3*width/4;

// Self-field B computation (Kim-model Jc(B,T) feedback) -- must be
// included after Efun/ElFun/ErFun AND after Vh3 T exists (bfield_3d_slit.idp's
// computeSelfFieldB references the mesh field T directly), per its own
// header comment. FreeFEM resolves identifiers at parse time even inside
// func bodies not yet called, so this really does need to come after the
// Vh3 T declaration above, not just before it's first USED.
include "bfield_3d_slit.idp"
real[int] Bleft(nxs+1), Bright(nxs+1);
// Component-wise self-field (perpendicular=mesh-y/thickness/c-axis,
// parallel=mesh-z/width/ab-plane) -- feeds the anisotropic Kim model
// (JcTBAniso/sigmaScBAniso/solveE*BAniso in bfield_3d_slit.idp), used by
// the electrical solve below only when -aniso 1 (see useAniso above);
// always populated regardless of the flag since computeSelfFieldB now
// always computes both from the same pass. See Bfield/CLAUDE.md's
// "Anisotropic Kim model infrastructure".
real[int] ByLeft(nxs+1), ByRight(nxs+1), BzLeft(nxs+1), BzRight(nxs+1);

// Defaults to 1 (this script's exact prior behavior, unflagged). A
// wrapper passes a larger value via -steps-per-invocation to amortize
// the mesh-rebuild-per-invocation cost across several timesteps --
// CSV/diagnostics rows are still written every physical step regardless,
// and (see below) the checkpoint is now written every physical step too,
// so no time-resolution or crash-safety is lost by raising this.
int maxStepsThisRun = getARGV("-steps-per-invocation", 1);

// Adaptive-bisection/runaway-cutoff tunables, ported from
// electrothermal/step_3d_slit_transient_diag.edp -- see the step loop
// below for the mechanism and that track's CLAUDE.md for the crash
// history that motivated it (large-dt UMFPACK ill-conditioning on this
// project's own material tables, found to be node/hardware-dependent
// rather than a deterministic function of dt). getARGV lets these be
// overridden from the command line without editing the script; defaults
// reproduce this script's exact prior behavior when unflagged.
real maxStepRise = getARGV("-maxsteprise", 500.0);
int maxBisections = getARGV("-maxbisections", 10);
real tmaxCutoff = getARGV("-tmaxcutoff", 900.0);

// -aniso 1 switches the electrical solve from the isotropic Kim model
// (solveE*B, |B| via Bleft/Bright) to the anisotropic one (solveE*BAniso,
// component-resolved via ByLeft/BzLeft/ByRight/BzRight -- see
// bfield_3d_slit.idp's "Anisotropic Kim model infrastructure"). Coupling
// stays LAGGED either way -- this only changes how a given lagged B is
// turned into a Jc suppression, not the lag itself. Default 0 (isotropic)
// reproduces this script's exact prior behavior when unflagged.
int useAniso = getARGV("-aniso", 0);

// -selfconsistent 1 replaces the LAGGED B<->E coupling above with a
// within-timestep self-consistent (Picard) solve: at the frozen entering
// T/I0w, iterate {compute B from current E} -> {solve electrical for new
// E from that B} until E stops changing, before ever touching heatStep.
// Default 0 (lagged) reproduces this script's exact prior behavior when
// unflagged -- the loop below runs exactly once, with no residual check
// or relaxation applied, in that case.
//
// Deliberately NOT nested inside the dtTry bisection while-loop further
// below: the self-field/electrical sub-problem depends only on the
// frozen entering T and I0w, neither of which depends on dt at all (dt
// first enters downstream, in heatStep's own diffusion solve). Retrying
// this sub-problem at a smaller dtTry would hand it the exact same
// inputs and so cannot change whether it has/finds a fixed point --
// under-relaxation (picardOmega below), not dt, is the only real lever
// against non-convergence here. See Bfield/CLAUDE.md's "Self-consistent
// (non-lagged) B<->E Picard solve" for the full reasoning (including why
// non-convergence logs a warning and proceeds rather than asserting --
// unlike heatStep's bisection failure, a Picard non-convergence at a
// given (T,I0w) is deterministic, so retrying the identical invocation
// under Condor's on_exit_hold/periodic_release would just fail the same
// way every time instead of recovering).
int useSelfConsistent = getARGV("-selfconsistent", 0);
int maxPicardIter = getARGV("-maxpicarditer", 20);
real picardTol = getARGV("-picardtol", 1e-3);
real picardOmega0 = getARGV("-picardomega", 0.5);

// CHECKPOINT FORMAT CHANGE: now also persists Earr/ElArr/ErArr, not just
// t and T. This is required for computeSelfFieldB's lagged design to
// actually work: it reads these arrays BEFORE this step's electrical
// solve overwrites them, expecting last step's converged values. Without
// persisting them, every fresh script invocation saw freshly-zero-
// initialized arrays instead, and B was silently 0 forever regardless of
// the real current/heating state -- a real bug, not a physics effect,
// caught by exactly that symptom (uniformly zero B at every Hall probe
// reading). Checkpoints from before this fix do NOT have this data --
// re-run init_3d_slit_transient_checkpoint.edp for a fresh start rather
// than resuming an old checkpoint with this script; there's no valid B
// history in an old checkpoint to recover anyway (B was always 0 there).
real t = 0.0;
{
  ifstream fchk(outPrefix+"ckpt_3d_slit_transient.txt");
  fchk >> t;
  for (int i=0;i<T.n;i++) fchk >> T[][i];
  for (int i=0;i<=nxs;i++) fchk >> Earr[i];
  for (int i=0;i<=nxs;i++) fchk >> ElArr[i];
  for (int i=0;i<=nxs;i++) fchk >> ErArr[i];
  cout << "Resumed at t="<<t<<"s Tmax="<<T[].max << endl;
}

{
  ofstream fout(outPrefix+"transient_3d_slit.csv", append);
  if (t <= 1e-12) fout << "t,I0,Tmax,TmaxLeft,TmaxRight,fracLeft\n";

  ofstream fdiag(outPrefix+"diagnostics_3d_slit.csv", append);
  int diagFileCheck = exec("test -s "+outPrefix+"diagnostics_3d_slit.csv");
  bool diagCsvHasHeader = (diagFileCheck == 0);
  // Metadata is static and cheap -- just rewrite it every invocation so it's
  // always present/current, regardless of when this feature was added
  // relative to an in-progress run's t value.
  writeDiagnosticsMetadata(outPrefix+"diagnostics_positions_3d_slit.csv");
  if (!diagCsvHasHeader) {
    fdiag << "t,I0,Tmax,fracLeft,V_CL_plus,V_CL_minus";
    for (int i=0;i<nTapsPerSide;i++) fdiag << ",V1_" << (i+1);
    for (int i=0;i<nTapsPerSide;i++) fdiag << ",V2_" << (i+1);
    for (int i=0;i<nRTDsPerSide;i++) fdiag << ",RTD1_" << (i+1);
    for (int i=0;i<nRTDsPerSide;i++) fdiag << ",RTD2_" << (i+1);
    fdiag << ",H1,H2,picardIters,picardRelErr\n";
  }

  int step = 0;
  while (t < tEnd-1e-12 && step < maxStepsThisRun && T[].max < tmaxCutoff){
    real tStepStart = clock();
    real I0w = I0ofT(t);

    // Self-field B <-> electrical solve. LAGGED mode (-selfconsistent 0,
    // default): this loop runs exactly once, computing B from the CURRENT
    // (about-to-be-overwritten) Earr/ElArr/ErArr -- i.e. the previous
    // timestep's converged state -- then holding it fixed through this
    // timestep's electrical solve (the original "lagged" coupling
    // decision). SELF-CONSISTENT mode (-selfconsistent 1): the loop
    // repeats {compute B from current E} -> {re-solve electrical for E
    // from that B} until E stops changing (relative to picardTol) or
    // maxPicardIter is hit, at fixed entering T/I0w throughout -- see the
    // -selfconsistent flag comment above and Bfield/CLAUDE.md for why this
    // is NOT nested in the dtTry bisection loop below (dt-independent).
    int picardOuterCap = useSelfConsistent ? maxPicardIter : 1;
    real[int] EarrPrev(nxs+1), ElArrPrev(nxs+1), ErArrPrev(nxs+1);
    bool picardConverged = true;
    int picardItersUsed = 1;
    real picardRelErrFinal = -999.0;
    real omega = picardOmega0;
    real picardRelErrPrev = 1e300;
    real tBfieldTotal = 0.0, tElectricalTotal = 0.0;
    real fracLeft = 0.5;

    for (int pIter=0; pIter<picardOuterCap; pIter++){
      EarrPrev = Earr; ElArrPrev = ElArr; ErArrPrev = ErArr;

      real tBstart = clock();
      computeSelfFieldB(Bleft, Bright, ByLeft, ByRight, BzLeft, BzRight, nxs+1);
      tBfieldTotal += clock() - tBstart;

      real tElecStart = clock();
      // electrical: single channel outside slit range, split L/R inside.
      // WITHIN the slit, El(x)/Er(x) are resolved PER-x (matching the
      // outside-slit treatment) rather than sampled once at a single
      // representative point and extended uniformly -- the heater creates a
      // strongly localized hot spot, and a single point's local resistivity
      // is not representative of the other ~178mm of slit length.
      for (int i=0;i<=nxs;i++){
        real xx = xSample[i];
        if (xx < xSlitStart || xx > xSlitEnd){
          real TcuShell=T(xx,yCuTop,zLeftRep), TagB=T(xx,yAgBmid,zLeftRep), THast=T(xx,yHastMid,zLeftRep),
               Tsc=T(xx,yScmid,zLeftRep), TagT=T(xx,yAgTmid,zLeftRep);
          Earr[i] = useAniso ? solveEFullBAniso(TcuShell,TagB,THast,Tsc,TagT, I0w, ByLeft[i], BzLeft[i])
                              : solveEFullB(TcuShell,TagB,THast,Tsc,TagT, I0w, Bleft[i]);
          ElArr[i] = 0; ErArr[i] = 0;
        } else {
          Earr[i] = 0;
        }
      }

      // Precompute local per-x temperatures within the slit range for both
      // sides ONCE per Picard iteration -- T is fixed during this algebraic
      // current-split sub-solve, so there's no need to re-evaluate the FE
      // field on every bisection iteration below.
      real[int] TcuLx(nxs+1), TagBLx(nxs+1), THastLx(nxs+1), TscLx(nxs+1), TagTLx(nxs+1);
      real[int] TcuRx(nxs+1), TagBRx(nxs+1), THastRx(nxs+1), TscRx(nxs+1), TagTRx(nxs+1);
      int iSlitLo=-1, iSlitHi=-1;
      for (int i=0;i<=nxs;i++){
        real xx = xSample[i];
        if (xx >= xSlitStart && xx <= xSlitEnd){
          if (iSlitLo<0) iSlitLo=i;
          iSlitHi=i;
          TcuLx[i]=T(xx,yCuTop,zLeftRep);  TagBLx[i]=T(xx,yAgBmid,zLeftRep);  THastLx[i]=T(xx,yHastMid,zLeftRep);
          TscLx[i]=T(xx,yScmid,zLeftRep);  TagTLx[i]=T(xx,yAgTmid,zLeftRep);
          TcuRx[i]=T(xx,yCuTop,zRightRep); TagBRx[i]=T(xx,yAgBmid,zRightRep); THastRx[i]=T(xx,yHastMid,zRightRep);
          TscRx[i]=T(xx,yScmid,zRightRep); TagTRx[i]=T(xx,yAgTmid,zRightRep);
        }
      }

      // Total voltage drop along each side = integral of the LOCAL field
      // (current fixed at Il/Ir along the length, field varies with local T)
      // over the slit's x-range, trapezoidal over the same x-sample grid used
      // everywhere else.
      func real VLeftTotal(real fracLeftArg){
        real Il = fracLeftArg*I0w;
        real sum = 0.0;
        for (int i=iSlitLo;i<iSlitHi;i++){
          real Ea = useAniso ? solveEHalfBAniso(TcuLx[i],  TagBLx[i],  THastLx[i],  TscLx[i],  TagTLx[i],  Il, leftShellArea, leftCoreWidth, ByLeft[i],  BzLeft[i])
                              : solveEHalfB(TcuLx[i],  TagBLx[i],  THastLx[i],  TscLx[i],  TagTLx[i],  Il, leftShellArea, leftCoreWidth, Bleft[i]);
          real Eb = useAniso ? solveEHalfBAniso(TcuLx[i+1],TagBLx[i+1],THastLx[i+1],TscLx[i+1],TagTLx[i+1],Il, leftShellArea, leftCoreWidth, ByLeft[i+1],BzLeft[i+1])
                              : solveEHalfB(TcuLx[i+1],TagBLx[i+1],THastLx[i+1],TscLx[i+1],TagTLx[i+1],Il, leftShellArea, leftCoreWidth, Bleft[i+1]);
          sum += 0.5*(Ea+Eb)*(xSample[i+1]-xSample[i]);
        }
        return sum;
      }
      func real VRightTotal(real fracLeftArg){
        real Ir = (1-fracLeftArg)*I0w;
        real sum = 0.0;
        for (int i=iSlitLo;i<iSlitHi;i++){
          real Ea = useAniso ? solveEHalfBAniso(TcuRx[i],  TagBRx[i],  THastRx[i],  TscRx[i],  TagTRx[i],  Ir, rightShellArea, rightCoreWidth, ByRight[i],  BzRight[i])
                              : solveEHalfB(TcuRx[i],  TagBRx[i],  THastRx[i],  TscRx[i],  TagTRx[i],  Ir, rightShellArea, rightCoreWidth, Bright[i]);
          real Eb = useAniso ? solveEHalfBAniso(TcuRx[i+1],TagBRx[i+1],THastRx[i+1],TscRx[i+1],TagTRx[i+1],Ir, rightShellArea, rightCoreWidth, ByRight[i+1],BzRight[i+1])
                              : solveEHalfB(TcuRx[i+1],TagBRx[i+1],THastRx[i+1],TscRx[i+1],TagTRx[i+1],Ir, rightShellArea, rightCoreWidth, Bright[i+1]);
          sum += 0.5*(Eb+Ea)*(xSample[i+1]-xSample[i]);
        }
        return sum;
      }
      func real Vdiff(real fracLeftArg){
        return VLeftTotal(fracLeftArg) - VRightTotal(fracLeftArg);
      }
      real flo=0.0, fhi=1.0;
      if (I0w <= 0.0){ flo=0.5; fhi=0.5; }
      else {
        for(int it=0;it<30;it++){
          real fmid=0.5*(flo+fhi);
          if (Vdiff(fmid) < 0) flo=fmid; else fhi=fmid;
        }
      }
      fracLeft = 0.5*(flo+fhi);
      real IlFinal = fracLeft*I0w, IrFinal = (1-fracLeft)*I0w;
      for (int i=iSlitLo;i<=iSlitHi;i++){
        ElArr[i] = useAniso ? solveEHalfBAniso(TcuLx[i],TagBLx[i],THastLx[i],TscLx[i],TagTLx[i], IlFinal, leftShellArea, leftCoreWidth, ByLeft[i], BzLeft[i])
                             : solveEHalfB(TcuLx[i],TagBLx[i],THastLx[i],TscLx[i],TagTLx[i], IlFinal, leftShellArea, leftCoreWidth, Bleft[i]);
        ErArr[i] = useAniso ? solveEHalfBAniso(TcuRx[i],TagBRx[i],THastRx[i],TscRx[i],TagTRx[i], IrFinal, rightShellArea, rightCoreWidth, ByRight[i], BzRight[i])
                             : solveEHalfB(TcuRx[i],TagBRx[i],THastRx[i],TscRx[i],TagTRx[i], IrFinal, rightShellArea, rightCoreWidth, Bright[i]);
      }
      tElectricalTotal += clock() - tElecStart;

      picardItersUsed = pIter + 1;
      if (!useSelfConsistent) break;   // exactly today's single-pass behavior

      // Relative-change residual, computed on the RAW solve output BEFORE
      // relaxation is applied below -- relaxing first would shrink the
      // metric by omega and falsely declare convergence early. Normalized
      // by a single GLOBAL max(|E|), not a per-point previous-value
      // denominator: E0 (1uV/cm, hts_materials.idp) floors it so points
      // that happen to sit near zero locally don't blow the ratio up.
      real maxE = 0.0, maxDiff = 0.0;
      for (int i=0;i<=nxs;i++){
        maxE = max(maxE, abs(Earr[i])); maxDiff = max(maxDiff, abs(Earr[i]-EarrPrev[i]));
        if (xSample[i]>=xSlitStart && xSample[i]<=xSlitEnd){
          maxE = max(maxE, max(abs(ElArr[i]),abs(ErArr[i])));
          maxDiff = max(maxDiff, max(abs(ElArr[i]-ElArrPrev[i]), abs(ErArr[i]-ErArrPrev[i])));
        }
      }
      real picardRelErr = maxDiff / max(maxE, E0);
      picardRelErrFinal = picardRelErr;
      if (picardRelErr <= picardTol){ picardConverged = true; break; }

      // Adaptive backtrack: if this iteration moved AWAY from convergence
      // relative to the last one (the oscillation/ringing symptom this
      // whole feature exists to fix), get more conservative for the rest
      // of THIS step's loop only -- reset to picardOmega0 at the top of
      // every new physical step rather than carrying a stiff step's
      // caution forward into later, possibly well-behaved steps.
      if (picardRelErr > picardRelErrPrev) omega = max(omega*0.5, 0.05);
      picardRelErrPrev = picardRelErr;

      Earr  = omega*Earr  + (1-omega)*EarrPrev;
      ElArr = omega*ElArr + (1-omega)*ElArrPrev;
      ErArr = omega*ErArr + (1-omega)*ErArrPrev;

      if (pIter == maxPicardIter-1) picardConverged = false;
    }
    if (useSelfConsistent && !picardConverged){
      // Deliberately NOT assert(false): a Picard non-convergence at this
      // (T,I0w) is deterministic (see the flag comment above), so unlike
      // heatStep's bisection failure below, retrying this exact invocation
      // under Condor would just fail the same way every time instead of
      // recovering -- proceed with the best-available under-relaxed
      // E/B state (bounded, one-step residual error) and surface it loudly
      // instead of stalling the whole run.
      cout << "PICARD-NOT-CONVERGED t=" << t << " relErr=" << picardRelErrFinal
           << " tol=" << picardTol << " after " << picardItersUsed
           << " iterations -- proceeding with best-available under-relaxed E/B." << endl;
    }

    real dt = dtCapped(t);
    if (dt <= 1e-9) break;

    real qHeaterNow = 0.0;
    if (t >= tPulseStart && t < tPulseEnd) qHeaterNow = qHeater;

    real tFieldsStart = clock();
    Ph3 inSlitRange = (x>=xSlitStart)*(x<=xSlitEnd);
    source = (1-inSlitRange)*sourceOfFull(region, Efun(x), T)
           + inSlitRange*( (z<zSlitCenter)*sourceOfFull(region, ElFun(x), T)
                          + (z>zSlitCenter)*sourceOfFull(region, ErFun(x), T) );
    Told = T;
    kfun = kOf(region, Told);
    rhocpfun = rhoCpOf(region, Told);
    real tFields = clock() - tFieldsStart;

    // Adaptive step bisection -- ported from electrothermal/
    // step_3d_slit_transient_diag.edp (see its CLAUDE.md, "Ramp collapse
    // breaks down above Ic" / "Adaptive step-size bisection" / "Above-Ic
    // phase: adaptive Jc-based step growth"). heatStep's solve leaves
    // solver= unspecified, so FreeFEM solves the (genuinely SPD) bilinear
    // form as a general system via UMFPACK, which can fail -- loudly (OOM
    // on pathological pivoting/fill-in) or silently (a technically-
    // completed but numerically garbage factorization) -- on an ill-
    // conditioned matrix. This project's material tables span many orders
    // of magnitude (e.g. buffer's placeholder sigmaBuf=1e-10 S/m), and the
    // failure was found to be node/hardware-dependent rather than a
    // deterministic function of dt, so no fixed-dt cap can be proven safe
    // in advance. Retry at half dt whenever the result isn't physically
    // sane, standard adaptive-FEA practice. maxStepRise is deliberately
    // generous (a real quench -- ~650K/s, the fastest observed this
    // project -- is only ~13K at pulse-phase dt) so this only ever fires
    // on genuine numerical garbage.
    //
    // Only the above-Ic ramp window gets the second, Jc-based accuracy
    // controller below -- below tCrossIc, I0(t) is still ramping toward
    // Ic with no current-sharing physics engaged yet (maxStepRise alone is
    // the right guard there), and the pulse/post-pulse phases already
    // have independently-validated fixed dt. This only actually triggers
    // once currentRatio>1 (see tCrossIc above); at the default ratio=0.7
    // it's a no-op, same as before ratio was parameterized.
    bool inAboveIcPhase = (currentRatio > 1.0 && t >= tCrossIc-1e-9 && t < Tramp-1e-9);
    real TmaxBefore = Told[].max, TminBefore = Told[].min;
    real jcBefore = JcT(TmaxBefore);
    // Normalize the Jc swing against a FIXED reference (Jc at the cold
    // base temperature), not the local jcBefore -- JcT is linear and hits
    // exactly 0 at Tc=90K, so as Tmax approaches Tc, jcBefore->0 and a
    // fraction normalized by it becomes unsatisfiable regardless of how
    // small dt gets. Ported already-fixed (see electrothermal/CLAUDE.md's
    // "Jc bisect fix" for the live bug this avoids: r1p36 spun for 13.3
    // hours approaching T=90K without ever crossing it under the original,
    // locally-normalized version of this check).
    real jcRef = JcT(Tcold);
    real dtTry = dt;
    int bisectCount = 0;
    real jcFrac = 0.0;
    bool solveOk = false;
    real tHeatStart = clock();
    while (!solveOk){
      solve heatStep(T, w) =
          int3d(Th3)( rhocpfun*T*w/dtTry + kfun*(dx(T)*dx(w) + dy(T)*dy(w) + dz(T)*dz(w)) )
        - int3d(Th3)( rhocpfun*Told*w/dtTry + source*w )
        - int2d(Th3, 3)( qHeaterNow*(x>xHeatLo)*(x<xHeatHi)*(z>zHeatLo)*(z<zHeatHi)*w )
        + on(2, 4, T=Tcold);
      // NaN checked separately from the rise bound -- a NaN comparison
      // against a finite bound via ">" is always false in IEEE-754, so a
      // diverged-to-NaN solve would otherwise never trip the bisection.
      bool isNan = (T[].max != T[].max) || (T[].min != T[].min);
      bool blewUp = isNan || (T[].max-TmaxBefore > maxStepRise) || (TminBefore-T[].min > maxStepRise);
      // Accuracy check, above-Ic phase only. Skipped once blewUp is
      // already true: no point computing Jc off catastrophically garbage
      // T[].max.
      bool jcTooFast = false;
      if (inAboveIcPhase && !blewUp){
        jcFrac = abs(JcT(T[].max)-jcBefore)/max(jcRef, 1e-30);
        jcTooFast = jcFrac > maxJcFracChange;
      }
      if (!blewUp && !jcTooFast) solveOk = true;
      else {
        bisectCount++;
        cout << "[bisect] step=" << step << " t=" << t << " dtTry=" << dtTry
             << " jcFrac=" << jcFrac << " Tmax=" << T[].max << " Tmin=" << T[].min
             << " -- halving (attempt " << bisectCount << "/" << maxBisections << ")" << endl;
        if (bisectCount > maxBisections){
          cout << "FATAL: heatStep did not stabilize after " << maxBisections
               << " bisections at t=" << t << " (started from dt=" << dt << ")" << endl;
          assert(false);
        }
        dtTry = dtTry/2.0;
      }
    }
    dt = dtTry;   // the committed dt, possibly smaller than originally requested
    // Grow the above-Ic guess for the NEXT step if this one was comfortably
    // inside the accuracy band; otherwise just carry forward whatever dt
    // actually worked, rather than re-attempting the same too-large value.
    if (inAboveIcPhase){
      if (jcFrac < 0.5*maxJcFracChange) rampDtAboveIc = dtTry*2.0;
      else rampDtAboveIc = dtTry;
    }
    real tHeatSolve = clock() - tHeatStart;

    t += dt;
    for (int i=0;i<5;i++) if (abs(t-phaseBounds[i])<1e-9) t = phaseBounds[i];
    step++;

    // CSV/diagnostic write moved to AFTER the (possibly-bisected) solve and
    // AFTER advancing t -- ported from the same electrothermal fix, and
    // fixing the identical bug here: writing before the solve meant a CSV
    // row's Tmax was always one physical step stale relative to what the
    // checkpoint ended up holding, so the truly-final row before an early
    // exit (tmaxCutoff, a bisection FATAL) would never reach
    // transient_3d_slit.csv at all. Voltage/Hall-probe diagnostics still
    // reflect the electrical solve computed from the step's STARTING
    // temperature (the model's existing staggered-scheme convention,
    // unchanged) -- only Tmax/TmaxLeft/TmaxRight need the post-solve,
    // just-committed state.
    real TmaxLeft = T(xHeatC,yCuTop,zLeftRep);
    real TmaxRight = T(xHeatC,yCuTop,zRightRep);
    // I0w (used above, in the solve and the electrical/voltage sub-solve)
    // is deliberately evaluated at the PRE-increment t -- an explicit,
    // frozen-coefficient source consistent with kfun/rhocpfun/Told, same
    // convention as fracLeft/voltages below. But I0 itself is an exactly-
    // known, purely time-driven function (no solve involved) -- there is
    // no reason to log a stale value for it. I0Now re-evaluates I0ofT at
    // the now-current (post-increment) t so the logged "I0" column
    // actually matches the timestamp it's printed against. Ported from
    // electrothermal/step_3d_slit_transient_diag.edp's "fix write lag
    // issue" -- see that track's CLAUDE.md for where it was first found
    // (r1p26's CSV showed I0=0 at its very first row because that row's
    // I0w was I0ofT(0) from the ramp's true start).
    real I0Now = I0ofT(t);
    cout << "t="<<t<<"s I0="<<I0Now<<" Tmax="<<T[].max<<" TmaxL="<<TmaxLeft<<" TmaxR="<<TmaxRight<<" fracLeft="<<fracLeft << endl;
    fout << t << "," << I0Now << "," << T[].max << "," << TmaxLeft << "," << TmaxRight << "," << fracLeft << "\n";

    real tDiagStart = clock();
    diagAllTapVoltages(diagVL, diagVR);
    real VclPlus = 0.0;
    real VclMinus = diagVcum(Lx, -1);   // == diagVcum(Lx,+1) by the slit's equal-voltage-drop closure condition
    // (I0Now above is the one exception to "diagnostics reflect the
    // step's starting state" -- it's not re-derived from a solve, just
    // re-evaluating the same closed-form ramp function at the correct
    // time, so there's no such tradeoff for it.)
    fdiag << t << "," << I0Now << "," << T[].max << "," << fracLeft << "," << VclPlus << "," << VclMinus;
    for (int i=0;i<nTapsPerSide;i++) fdiag << "," << diagVL[i];
    for (int i=0;i<nTapsPerSide;i++) fdiag << "," << diagVR[i];
    for (int i=0;i<nRTDsPerSide;i++) fdiag << "," << T(xRTD[i], yB7, zDiagLeft);
    for (int i=0;i<nRTDsPerSide;i++) fdiag << "," << T(xRTD[i], yB7, zDiagRight);
    real BatHallLeft = interp1(xSample, Bleft, nxs+1, xHall);
    real BatHallRight = interp1(xSample, Bright, nxs+1, xHall);
    // picardIters/picardRelErr: ALWAYS emitted regardless of -selfconsistent
    // (picardIters=1/picardRelErr=-999 in lagged mode, matching this file's
    // own H1/H2 -999-sentinel convention) -- the CSV's header shape is keyed
    // by file-existence-on-disk per run/label (diagCsvHasHeader above), not
    // per-invocation flags, so making these columns conditional on the flag
    // risks silently corrupting the file if a run were ever re-invoked with
    // a different -selfconsistent value mid-run.
    fdiag << "," << BatHallLeft << "," << BatHallRight
          << "," << picardItersUsed << "," << picardRelErrFinal << "\n";
    real tDiag = clock() - tDiagStart;

    real tStepTotal = clock() - tStepStart;
    cout << "TIMING (s): Bfield=" << tBfieldTotal << "  electrical=" << tElectricalTotal
         << "  diagnostics=" << tDiag << "  fieldAssign=" << tFields << "  heatSolve=" << tHeatSolve
         << "  bisections=" << bisectCount << "  picardIters=" << picardItersUsed
         << "  picardOmegaFinal=" << omega << "  ||  stepTotal=" << tStepTotal << endl;

    // Checkpoint after EVERY physical step, not just once at invocation
    // end -- ported from electrothermal's identical fix, now actually
    // relevant here too since -steps-per-invocation can exceed 1. Without
    // this, a crash/preemption partway through a multi-step invocation
    // would leave the checkpoint behind the CSV rows already written,
    // and --resume (once this workflow has one) would re-write
    // duplicate/overlapping t rows. Mesh-rebuild amortization (the reason
    // for -steps-per-invocation>1) is unaffected -- the mesh is only
    // built once per invocation regardless of how often this (cheap)
    // checkpoint file is rewritten.
    {
      ofstream fchkOut(outPrefix+"ckpt_3d_slit_transient.txt");
      fchkOut.precision(12);
      fchkOut << t << "\n";
      for (int i=0;i<T.n;i++) fchkOut << T[][i] << "\n";
      for (int i=0;i<=nxs;i++) fchkOut << Earr[i] << "\n";
      for (int i=0;i<=nxs;i++) fchkOut << ElArr[i] << "\n";
      for (int i=0;i<=nxs;i++) fchkOut << ErArr[i] << "\n";
    }
  }
  if (T[].max >= tmaxCutoff) cout << "Tmax cutoff " << tmaxCutoff << "K reached (Tmax="
       << T[].max << "K) -- stopping early, " << (maxStepsThisRun-step)
       << " step(s) skipped this invocation" << endl;
}
cout << "Saved checkpoint at t="<<t<<"s" << endl;
cout << "[profile] totalInvocation=" << (clock()-tInvocationStart) << "s" << endl;
