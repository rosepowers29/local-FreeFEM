// ============================================================
// step3_3d_slit_steady_verify.edp
// Steady-state verification WITH the laser slit, heater OFF. Symmetric,
// no-disturbance baseline check -- confirms the slit geometry doesn't
// break anything before we introduce any asymmetric physics (a one-sided
// heater) in a later pass.
//
// The slit's width (5um) is negligible compared to the tape width (12mm),
// so the per-x current-sharing model is reused essentially unchanged from
// the no-slit shell model (the areas it would remove are a ~0.04%
// correction, well below the precision we're working at elsewhere). The
// slit's real effect here is on the THERMAL field: region 7 (slit) gets
// near-zero conductivity and zero Joule heating.
// ============================================================

include "hts_mesh_module_3d_slit.idp"
include "hts_materials.idp"

real Tcold = 77.0;
real shellArea = width*yB7 - coreWidth*(yB6-yB1);
real IcRebcoActual = JcT(77.0)*tSc*coreWidth;
real TESTRATIO = 1.00;
real I0 = TESTRATIO * IcRebcoActual;

func real kOf(int rg, real Tl){
  if (rg==1) return kCu(Tl);
  if (rg==2 || rg==6) return kAg(Tl);
  if (rg==3) return kHast(Tl);
  if (rg==4) return kBuf(Tl);
  if (rg==5) return kSc(Tl);
  if (rg==7) return 1e-2;   // slit: vacuum-like, near-zero conductivity
  return 1.0;
}
func real sourceOf(int rg, real Ef, real Tl){
  if (rg==1) return Ef^2/rhoCu(Tl);
  if (rg==2 || rg==6) return Ef^2/rhoAg(Tl);
  if (rg==5) return sigmaSc(Ef,Tl)*Ef^2;
  return 0.0;   // regions 3,4,7 (Hastelloy, buffer, slit): no current, no heating
}
func real Itot(real E, real TcuShell, real TagB, real Tsc, real TagT){
  return shellArea*(E/rhoCu(TcuShell)) + tAgB*coreWidth*(E/rhoAg(TagB))
       + tSc*coreWidth*sigmaSc(E,Tsc)*E + tAgT*coreWidth*(E/rhoAg(TagT));
}
func real solveE(real TcuShell, real TagB, real Tsc, real TagT, real Itarget){
  if (Itarget <= 0.0) return 0.0;
  real Ehi0 = 4.0;
  int guard = 0;
  while (Itot(Ehi0,TcuShell,TagB,Tsc,TagT) < Itarget && guard<40){ Ehi0 *= 2.0; guard++; }
  real logElo = log(1e-30), logEhi = log(Ehi0);
  for (int it=0; it<50; it++){
    real logEmid = 0.5*(logElo+logEhi);
    real Emid = exp(logEmid);
    if (Itot(Emid,TcuShell,TagB,Tsc,TagT) < Itarget) logElo = logEmid; else logEhi = logEmid;
  }
  real Efinal = exp(0.5*(logElo+logEhi));
  real Icheck = Itot(Efinal,TcuShell,TagB,Tsc,TagT);
  real relErr = abs(Icheck-Itarget)/max(Itarget,1e-30);
  assert(relErr <= 1e-3);
  return Efinal;
}

int nxs = 40;
real[int] xSample(nxs+1), Earr(nxs+1);
for (int i=0;i<=nxs;i++) xSample[i] = Lx*i/nxs;
func real Efun(real xx){ return interp1(xSample, Earr, nxs+1, xx); }

fespace Vh3(Th3, P1);
fespace Ph3(Th3, P0);
Ph3 reg = region;
Vh3 T, Tnew, w;
Ph3 kfun, source;

// sample layer temperatures at z=width/4 (well clear of the slit and the
// side shell, deep in the "left half" of the core) -- a representative
// point since by symmetry the two halves should match in this test
real zRep = width/4;
real yCuTop = yB7-1e-9, yAgBmid=0.5*(yB1+yB2), yScmid=0.5*(yB4+yB5), yAgTmid=0.5*(yB5+yB6);

int nPicard = 20;
int nPicardThisRun = 1;
cout << "Ic_REBCO="<<IcRebcoActual<<"  I0="<<I0 << endl;

int iterStart = 0;
{
  ifstream fchk("ckpt_3d_slit.txt");
  fchk >> iterStart;
  for (int i=0;i<T.n;i++) fchk >> T[][i];
  cout << "Resumed from iter="<<iterStart<<" Tmax="<<T[].max << endl;
}

real relax = 0.5;
for (int iter=iterStart; iter<min(iterStart+nPicardThisRun,nPicard); iter++){
  real t0 = clock();
  for (int i=0;i<=nxs;i++){
    real xx = xSample[i];
    real TcuShell=T(xx,yCuTop,zRep), TagB=T(xx,yAgBmid,zRep),
         Tsc=T(xx,yScmid,zRep), TagT=T(xx,yAgTmid,zRep);
    Earr[i] = solveE(TcuShell,TagB,Tsc,TagT, I0);
  }
  source = sourceOf(region, Efun(x), T);
  kfun = kOf(region, T);

  solve steadyHeat3D(Tnew, w) =
      int3d(Th3)( kfun*(dx(Tnew)*dx(w) + dy(Tnew)*dy(w) + dz(Tnew)*dz(w)) )
    - int3d(Th3)( source*w )
    + on(2, 4, Tnew=Tcold);

  T = T + relax*(Tnew - T);
  real t1 = clock();
  cout << "iter="<<iter<<" Tmax="<<T[].max<<"  (iter time "<<(t1-t0)<<"s)" << endl;
}

{
  ofstream fchkOut("ckpt_3d_slit.txt");
  fchkOut.precision(12);
  fchkOut << min(iterStart+nPicardThisRun,nPicard) << "\n";
  for (int i=0;i<T.n;i++) fchkOut << T[][i] << "\n";
}
cout << "Checkpoint saved." << endl;
