# Repeat of sweep_noheater.sub's 801-ratio no-heater sweep (same ratios.txt,
# same 900/250 runaway_tmax split, 20 A/s ramp) with the post-ramp hold
# extended from 1.5 s to hold_time seconds, to see the long-term fate of
# overcurrents (does a "stable" ratio stay stable, does a marginal one
# eventually run away).
#
# Hold dt is log-spaced (see step_3d_slit_transient_diag.edp's holdTime
# comment): dt = hold_dt_frac x (time since ramp end), floor 0.02 s, cap
# hold_dt_max, bisected if Tmax moves > hold_max_rise K or Jc swings >5%
# in a step. Hold step counts: 1.5 s fixed (old) ~85; 30 s ~121; 60 s ~151
# -- so extending 30 -> 60 s only adds ~30 steps (~1 h) per job.
#
# Ships its OWN tarball (payload_hold.tar.gz, via PAYLOAD) so building it
# never touches payload.tar.gz while sweep_istar.sub's jobs are queued:
#   ./make_payload.sh payload_hold.tar.gz
#   mkdir -p logs && condor_submit sweep_noheater_hold.sub
#
# Outputs come back to this directory as hold30_<label>/ (Condor keeps only
# the last path component of transfer_output_files) -- move them into
# ../runs_hold30/ when they land.
#
# Site exclusions + max_wall_seconds copied from sweep_istar.sub (see
# Bfield/CLAUDE.md's 2026-10-07 / 2026-10-12 incidents for why).

universe        = container
container_image = docker://ghcr.io/rosepowers29/local-freefem-electrothermal@sha256:8b39db74c15d90180fb623cda03211d434ce619cd3786c3abbd37de930aed37c
requirements = (Arch == "X86_64") && (GLIDEIN_ResourceName =!= "MTState-Tempest-CE1") && (GLIDEIN_ResourceName =!= "IU-Jetstream2-Backfill")

executable      = condor_run_ratio.sh
environment     = "PAYLOAD=payload_hold.tar.gz"

hold_time        = 30
hold_dt_frac     = 0.05
hold_dt_max      = 1.0
hold_max_rise    = 5.0
tag              = hold30
max_wall_seconds = 64800

arguments       = $(ratio) $(tag)_$(label) --ramp-rate 20 --ramp-dt 999 --runaway-tmax $(runaway_tmax) --heater-power 0 --hold-time $(hold_time) --hold-dt-frac $(hold_dt_frac) --hold-dt-max $(hold_dt_max) --hold-max-rise $(hold_max_rise) --max-wall-seconds $(max_wall_seconds) --base-dir runs_$(tag)

should_transfer_files   = YES
when_to_transfer_output = ON_EXIT
transfer_input_files    = payload_hold.tar.gz
transfer_output_files   = work/runs_$(tag)/$(tag)_$(label)

request_cpus   = 1
request_memory = 4096M
request_disk   = 2048M

output = logs/$(tag)_$(label).out
error  = logs/$(tag)_$(label).err
log    = logs/$(tag)_$(label).log
stream_output = True
stream_error  = True

on_exit_hold        = (ExitCode != 0)
on_exit_hold_reason  = "run_transient.py reported a RETRY_WORTHY status (see CLAUDE.md) -- auto-releasing to retry, likely on a different execute node"
periodic_release     = (NumJobStarts < 4) && ((CurrentTime - EnteredCurrentStatus) > 300)

queue ratio,label,runaway_tmax from ratios.txt
