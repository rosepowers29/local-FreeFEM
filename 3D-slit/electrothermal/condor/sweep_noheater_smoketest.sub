# Smoketest for the no-heater (pure-ramp) sweep -- see CLAUDE.md's
# "Pure-ramp (no-heater) sweep" section. Identical to sweep.sub except:
#   - --heater-power 0 (disables the heater pulse entirely)
#   - --base-dir runs_noheater / transfer_output_files under work/runs_noheater
#     -- structurally prevents collision with the heater dataset's
#     identically-labeled runs/<label> directories once copied back,
#     rather than relying on remembering to copy into a different local
#     folder.
# Small, deliberately-chosen ratio set spanning the full range plus extra
# density right at the 0.90-0.911 boundary (see ratios_noheater_smoketest.txt)
# -- the open question this smoketest exists to answer: without a heater to
# kick-start instability, do near-boundary ratios still show Tmax trending
# toward runaway within the existing ~1.5s post-ramp window, or do they look
# flatly stable? That answer decides whether the real batch needs a longer
# observation window before submitting ~800 jobs on it.

universe        = container
container_image = docker://ghcr.io/rosepowers29/local-freefem-electrothermal@sha256:8b39db74c15d90180fb623cda03211d434ce619cd3786c3abbd37de930aed37c
requirements = (Arch == "X86_64")

executable      = condor_run_ratio.sh
arguments       = $(ratio) $(label) --ramp-rate 20 --ramp-dt 999 --runaway-tmax $(runaway_tmax) --heater-power 0 --base-dir runs_noheater

should_transfer_files   = YES
when_to_transfer_output = ON_EXIT
transfer_input_files    = payload.tar.gz
transfer_output_files   = work/runs_noheater/$(label)

request_cpus   = 1
request_memory = 4096M
request_disk   = 2048M

output = logs/noheater_smoketest_$(label).out
error  = logs/noheater_smoketest_$(label).err
log    = logs/noheater_smoketest_$(label).log
stream_output = True
stream_error  = True

# Same auto-retry policy as sweep.sub -- see its comments for the full
# rationale (node-heterogeneity, RETRY_WORTHY exit codes).
on_exit_hold        = (ExitCode != 0)
on_exit_hold_reason  = "run_transient.py reported a RETRY_WORTHY status (see CLAUDE.md) -- auto-releasing to retry, likely on a different execute node"
periodic_release     = (NumJobStarts < 4) && ((CurrentTime - EnteredCurrentStatus) > 300)

queue ratio,label,runaway_tmax from ratios_noheater_smoketest.txt
