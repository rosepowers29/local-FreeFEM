# Condor submit file for the electrothermal (no-B-field) half of the I*
# surrogate-training sweep -- see ../../shared/istar_sweep.py's docstring
# for the round-by-round workflow, and ../../Bfield/condor/sweep_istar.sub
# for the B-field counterpart. Use the SAME conditions.csv for both tracks
# so each (T0, ramp) condition has a paired I* with and without self-field.
#
# Derived from sweep_noheater.sub (same image, resources, retry policy).
# Differences:
#   - t0 and ramp_rate are PER-JOB queue columns (the surrogate's inputs).
#   - runaway_tmax flat 250: with the heater off there is no recovering
#     heater transient at low ratio to misclassify (the reason for the
#     900/250 split elsewhere).
#   - max_wall_seconds 64800 (18h): --max-wall-seconds was ported into
#     run_transient.py for this sweep, so a near-threshold job stops
#     cleanly as wall_budget_exceeded (an "unknown" to istar_sweep.py)
#     instead of being killed at the pool's ~20h cap and retried 4x.
#   - Site exclusions copied from Bfield/condor/sweep.sub (same OSPool;
#     those sites caused most eviction-driven duration-cap holds there).
#   - Outputs isolated under runs_istar/ (labels are is-cNNN-r<ratio>).
#
# Each round:
#   python3 ../../shared/istar_sweep.py round1 conditions.csv > istar_queue.txt
#   ./make_payload.sh && condor_submit sweep_istar.sub

universe        = container
container_image = docker://ghcr.io/rosepowers29/local-freefem-electrothermal@sha256:8b39db74c15d90180fb623cda03211d434ce619cd3786c3abbd37de930aed37c
requirements = (Arch == "X86_64") && (GLIDEIN_ResourceName =!= "MTState-Tempest-CE1") && (GLIDEIN_ResourceName =!= "IU-Jetstream2-Backfill")

executable      = condor_run_ratio.sh

heaterpower      = 0
runaway_tmax     = 250
ramp_dt          = 999
max_wall_seconds = 64800

arguments       = $(ratio) $(label) --t0 $(t0) --ramp-rate $(ramp_rate) --ramp-dt $(ramp_dt) --runaway-tmax $(runaway_tmax) --heater-power $(heaterpower) --max-wall-seconds $(max_wall_seconds) --base-dir runs_istar

should_transfer_files   = YES
when_to_transfer_output = ON_EXIT
transfer_input_files    = payload.tar.gz
transfer_output_files   = work/runs_istar/$(label)

request_cpus   = 1
request_memory = 4096M
request_disk   = 2048M

output = logs/$(label).out
error  = logs/$(label).err
log    = logs/$(label).log
stream_output = True
stream_error  = True

on_exit_hold        = (ExitCode != 0)
on_exit_hold_reason  = "run_transient.py reported a RETRY_WORTHY status (see CLAUDE.md) -- auto-releasing to retry, likely on a different execute node"
periodic_release     = (NumJobStarts < 4) && ((CurrentTime - EnteredCurrentStatus) > 300)

queue ratio,label,t0,ramp_rate from istar_queue.txt
