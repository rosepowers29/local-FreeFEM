// ============================================================
// step2_transient_quench.edp  (v2 -- ramped current + surface spot heater)
//
// Scenario:
//   1) Transport current ramps LINEARLY from ~0 to 0.7*Ic(77K) over Tramp,
//      then holds constant (a function of absolute time t, I(t)).
//   2) Short settle window to confirm baseline steady state before the
//      disturbance (per the mesh/regularization fixes, this should hold
//      at exactly 77K).
//   3) A 2mm x 2mm spot heater on the TOP Cu surface (label 2), modeled as
//      a Neumann (imposed flux) boundary condition, delivers 13W for
//      0.01s: q = 13W / (0.002m*0.002m) = 3.25e6 W/m^2.
//   4) Recovery window afterward to see whether the disturbance decays or
//      grows.
//
// Time-stepping uses a phase-dependent dt (coarse during the ramp, fine
// during/after the pulse), automatically capped so it never overshoots a
// phase boundary (so the pulse start/end land exactly on a step).
// ============================================================

include "hts_mesh_module.idp"
include "hts_materials.idp"

real width = 0.012;           // tape width [m]
real Tcold = 77.0;            // K, LN2 bath at the two end contacts (label 3,4)

real Ic77w   = JcT(77.0)*tSc;      // critical current per unit width at 77K [A/m]
real I0wTarg = 0.7*Ic77w;          // target operating current per unit width
cout << "Ic(77K) per unit width = " << Ic77w << " A/m  (total Ic = " << Ic77w*width << " A)" << endl;
cout << "Target I0 = " << I0wTarg << " A/m  (total I0 = " << I0wTarg*width << " A)" << endl;

// ---- timeline ----
real Tramp      = 0.5;     // s, linear current ramp duration
real tSettleEnd = 0.55;    // s, end of post-ramp settle window
real tPulseStart= 0.55;    // s, heater pulse starts
real tPulseDur  = 0.01;    // s, heater pulse duration (10 ms)
real tPulseEnd  = tPulseStart + tPulseDur;
real tEnd       = tPulseEnd + 0.05;   // s, recovery window (shortened -- long-term
                                       // stability already confirmed in the prior run;
                                       // this pass is about the current-redistribution
                                       // dynamics during/just after the pulse)

func real I0ofT(real tt){
  if (tt < Tramp) return I0wTarg*(tt/Tramp);
  return I0wTarg;
}

// ---- heater: 2mm x 2mm spot on the top Cu surface, boundary label 2 ----
real xHeatLo = Lx*0.5 - 1e-3, xHeatHi = Lx*0.5 + 1e-3;  // 2mm window at mid-length
real heaterArea = 2e-3*2e-3;               // 4mm^2 (matches physical spot size)
real heaterPower = 13.0;                   // W
real qHeater = heaterPower/heaterArea;     // W/m^2 = 3.25e6

// ---- phase-dependent timestep, capped so it never overshoots a boundary ----
real[int] phaseBounds = [Tramp, tSettleEnd, tPulseStart, tPulseEnd, tEnd];
func real dtRaw(real tt){
  if (tt < Tramp)       return 0.02;   // ramp: coarse, current changes slowly
  if (tt < tSettleEnd)  return 0.01;   // settle: confirm baseline
  if (tt < tPulseEnd)   return 0.001;  // pulse: resolve the 10ms window finely
  return 0.003;                        // recovery: moderate resolution
}
func real dtCapped(real tt){
  real d = dtRaw(tt);
  for (int i=0;i<5;i++) if (tt < phaseBounds[i] && tt+d > phaseBounds[i]) d = phaseBounds[i]-tt;
  return d;
}

// ---- region -> material property dispatch ----
func real kOf(int rg, real Tl){
  if (rg==1 || rg==7) return kCu(Tl);
  if (rg==2 || rg==6) return kAg(Tl);
  if (rg==3) return kHast(Tl);
  if (rg==4) return kBuf(Tl);
  if (rg==5) return kSc(Tl);
  return 1.0;
}
func real rhoCpOf(int rg, real Tl){
  if (rg==1 || rg==7) return rhomCu*cpCu(Tl);
  if (rg==2 || rg==6) return rhomAg*cpAg(Tl);
  if (rg==3) return rhomHast*cpHast(Tl);
  if (rg==4) return rhomBuf*cpBuf(Tl);
  if (rg==5) return rhomSc*cpSc(Tl);
  return 1.0;
}

// ---- per-x current-sharing model over the 5 conducting layers ----
func real Itot(real E, real TcuBl, real TagBl, real Tscl, real TagTl, real TcuTl){
  return tCuB*(E/rhoCu(TcuBl)) + tAgB*(E/rhoAg(TagBl)) + tSc*sigmaSc(E,Tscl)*E
       + tAgT*(E/rhoAg(TagTl)) + tCuT*(E/rhoCu(TcuTl));
}
func real solveE(real TcuBl, real TagBl, real Tscl, real TagTl, real TcuTl, real Itarget){
  if (Itarget <= 0.0) return 0.0;
  real Elo = 0.0, Ehi = 4.0;
  int guard = 0;
  while (Itot(Ehi,TcuBl,TagBl,Tscl,TagTl,TcuTl) < Itarget && guard<40){ Ehi *= 2.0; guard++; }
  for (int it=0; it<28; it++){
    real Emid = 0.5*(Elo+Ehi);
    if (Itot(Emid,TcuBl,TagBl,Tscl,TagTl,TcuTl) < Itarget) Elo = Emid; else Ehi = Emid;
  }
  return 0.5*(Elo+Ehi);
}

// non-uniform x-sampling: dense around the heater (where current-sharing
// physics might actually happen), sparse elsewhere
real padLo = xHeatLo - 0.02, padHi = xHeatHi + 0.02;

int nSparseL = 10, nDense = 60, nSparseR = 10;
int nxs = nSparseL + nDense + nSparseR;
real[int] xSample(nxs+1), Earr(nxs+1);
{
  int idx = 0;
  for (int i=0;i<=nSparseL;i++) xSample[idx++] = padLo*i/nSparseL;
  for (int i=1;i<=nDense;i++)   xSample[idx++] = padLo + (padHi-padLo)*i/nDense;
  for (int i=1;i<=nSparseR;i++) xSample[idx++] = padHi + (Lx-padHi)*i/nSparseR;
}
func real Efun(real xx){ return interp1(xSample, Earr, nxs+1, xx); }

fespace Ph(Th, P0);
fespace Vh(Th, P1);
Ph reg = region;

Vh T;
Vh Told, w;
Ph source, kfun, rhocpfun;

real tStart = 0.0;
{
  ifstream fchk("/scratch/rosep8/local-FreeFEM/checkpoint.txt");
  fchk >> tStart;
  for (int i=0;i<T.n;i++) fchk >> T[][i];
  cout << "Resumed from checkpoint at t=" << tStart << "s, Tmax=" << T[].max << "K" << endl;
}

// layer y-midpoints (all 7, for full through-thickness diagnostics at the heater)
real yCuBmid=0.5*(yB0+yB1), yAgBmid=0.5*(yB1+yB2), yHastmid=0.5*(yB2+yB3),
     yBufmid=0.5*(yB3+yB4), yScmid=0.5*(yB4+yB5), yAgTmid=0.5*(yB5+yB6), yCuTmid=0.5*(yB6+yB7);
real xHeatCenter = Lx*0.5;

real t = tStart;
{
  ofstream fout("/scratch/rosep8/local-FreeFEM/transient_log.csv", append);
  if (tStart == 0.0)
    fout << "t,I0,Tmax,Vtot,T_CuB,T_AgB,T_Hast,T_Buf,T_REBCO,T_AgT,T_CuT,"
         << "IcuB,IagB,Isc,IagT,IcuT,E_heater\n";

  int step = 0;
  int maxStepsThisRun = 8;   // cap per invocation; rerun the script to continue
  while (t < tEnd - 1e-12 && step < maxStepsThisRun){

    real I0w = I0ofT(t);

    // 1) per-x electrical solve using CURRENT temperature field and CURRENT I0(t)
    for (int i=0;i<=nxs;i++){
      real xx = xSample[i];
      real TcuBl=T(xx,yCuBmid), TagBl=T(xx,yAgBmid), Tscl=T(xx,yScmid),
           TagTl=T(xx,yAgTmid), TcuTl=T(xx,yCuTmid);
      Earr[i] = solveE(TcuBl,TagBl,Tscl,TagTl,TcuTl, I0w);
    }
    real Vtot = 0.0;
    for (int i=0;i<nxs;i++) Vtot += 0.5*(Earr[i]+Earr[i+1])*(xSample[i+1]-xSample[i]);

    cout << "t="<<t<<"s  I0="<<I0w<<"A/m  Tmax="<<T[].max<<"K  Vtot="<<Vtot<<"V" << endl;

    // per-layer current breakdown AT THE HEATER LOCATION (independent explicit
    // solve at x=xHeatCenter, not reused from the xSample array, for clarity)
    real TcuBh=T(xHeatCenter,yCuBmid), TagBh=T(xHeatCenter,yAgBmid), Tsch=T(xHeatCenter,yScmid),
         TagTh=T(xHeatCenter,yAgTmid), TcuTh=T(xHeatCenter,yCuTmid);
    real Eheater = solveE(TcuBh,TagBh,Tsch,TagTh,TcuTh, I0w);
    real IcuB = tCuB*(Eheater/rhoCu(TcuBh));
    real IagB = tAgB*(Eheater/rhoAg(TagBh));
    real Isc  = tSc*sigmaSc(Eheater,Tsch)*Eheater;
    real IagT = tAgT*(Eheater/rhoAg(TagTh));
    real IcuT = tCuT*(Eheater/rhoCu(TcuTh));

    fout << t << "," << I0w << "," << T[].max << "," << Vtot << ","
         << T(xHeatCenter,yCuBmid) << "," << T(xHeatCenter,yAgBmid) << ","
         << T(xHeatCenter,yHastmid) << "," << T(xHeatCenter,yBufmid) << ","
         << T(xHeatCenter,yScmid) << "," << T(xHeatCenter,yAgTmid) << ","
         << T(xHeatCenter,yCuTmid) << ","
         << IcuB << "," << IagB << "," << Isc << "," << IagT << "," << IcuT << ","
         << Eheater << "\n";

    real dt = dtCapped(t);
    if (dt <= 1e-9) break;

    // 2) Joule heat source from the current-sharing solution
    source = (reg==1)*(Efun(x)^2/rhoCu(T)) + (reg==7)*(Efun(x)^2/rhoCu(T))
           + (reg==2)*(Efun(x)^2/rhoAg(T)) + (reg==6)*(Efun(x)^2/rhoAg(T))
           + (reg==5)*(sigmaSc(Efun(x),T)*Efun(x)^2);

    // 3) heater flux, active only during the pulse window
    real qHeaterNow = 0.0;
    if (t >= tPulseStart && t < tPulseEnd) qHeaterNow = qHeater;

    // 4) implicit Euler thermal step, semi-implicit (lagged) nonlinear coefficients
    Told = T;
    kfun     = kOf(region, Told);
    rhocpfun = rhoCpOf(region, Told);

    solve heatStep(T, w) =
        int2d(Th)( rhocpfun*T*w/dt + kfun*(dx(T)*dx(w) + dy(T)*dy(w)) )
      - int2d(Th)( rhocpfun*Told*w/dt + source*w )
      - int1d(Th, 2)( qHeaterNow*(x>xHeatLo)*(x<xHeatHi)*w )
      + on(3, 4, T=Tcold);

    t += dt;
    step++;
  }
}
cout << "Wrote /scratch/rosep8/local-FreeFEM/transient_log.csv" << endl;

{
  ofstream fchkOut("/scratch/rosep8/local-FreeFEM/checkpoint.txt");
  fchkOut.precision(12);
  fchkOut << t << "\n";
  for (int i=0;i<T.n;i++) fchkOut << T[][i] << "\n";
}
cout << "Saved checkpoint at t=" << t << "s" << endl;
