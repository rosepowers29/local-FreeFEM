   81 : // ---- densities [kg/m^3] -- identical values to 3D/3D-slit ----
   82 : real rhomCu   = 8960.0;
   83 : real rhomHast = 8890.0;
   84 : real rhomBuf  = 3600.0;
   85 : real rhomSc   = 6390.0;
