   32 : include "hts_materials.idp"// ============================================================
    2 : // hts_materials.idp (strain-defect track)
    3 : // Loads tabulated (T, property) data for the 5-region tape stack (Cu,
    4 : // Hastelloy, Buffer, REBCO, Ag) -- same underlying measured data as
    5 : // 3D/3D-slit (copied into strain-defect/data/, not referenced cross-track,
    6 : // so this directory stays self-contained per existing per-track precedent).
    7 : // No bottom-Ag-specific table: there is only one Ag layer in this stack
    8 : // (top), using the same cpAg/kAg/rhoAg functions the other tracks' AgTop
    9 : // already uses.
   10 : //
   11 : // Adds the strain-defect-specific pieces on top of the existing JcT/sigmaSc
   12 : // pattern: a position-dependent Jc0 scale factor, loaded from tables
   13 : // generated by strain_to_jc.py. jcRatioOfXZ(x,z) (the full 2D field) is the
   14 : // load-bearing one -- used both in the volumetric 3D heating source AND
   15 : // (as of the z-resolved electrical model, see step_strain_tape_transient.edp)
   16 : // in the per-x per-z current-sharing integral itself. icRatioOfX(x) (the
   17 : // width-averaged 1D profile) is kept loaded for diagnostic/comparison
   18 : // purposes only -- it drove an earlier width-averaged electrical-solve
   19 : // design that was replaced once real strain data showed a defect severe/
   20 : // narrow enough that averaging was unconservative (see
   21 : // strain-defect/CLAUDE.md).
   22 : // ============================================================
   23 : 
   24 : // ---- generic linear interpolation table loader (identical to 3D-slit's) ----
   25 : func int loadTable(string fname, int n, real[int] &T, real[int] &V){
   26 :   ifstream f(fname);
   27 :   for(int i=0;i<n;i++){ f >> T[i] >> V[i]; }
   28 :   return n;
   29 : }
   30 : 
   31 : // Binary search -- see 3D-slit/shared/hts_materials.idp for the verification
   32 : // history (1342 test queries, bit-identical to a linear scan). Copied
   33 : // unchanged.
   34 : func real interp1(real[int] &T, real[int] &V, int nn, real Tq){
   35 :   if (Tq <= T[0])    return V[0];
   36 :   if (Tq >= T[nn-1]) return V[nn-1];
   37 :   int lo = 0, hi = nn-1;
   38 :   while (lo < hi){
   39 :     int mid = (lo+hi)/2;
   40 :     if (T[mid] < Tq) lo = mid+1; else hi = mid;
   41 :   }
   42 :   int i = lo-1;
   43 :   real fr = (Tq-T[i])/(T[i+1]-T[i]);
   44 :   return V[i] + fr*(V[i+1]-V[i]);
   45 : }
   46 : 
   47 : // ---- load every table (row counts match `wc -l` on each file) ----
   48 : real[int] TcpAg(71),   VcpAg(71);      int ncpAg   = loadTable("data/cp_ag.txt",   71, TcpAg, VcpAg);
   49 : real[int] TcpBuf(132), VcpBuf(132);    int ncpBuf  = loadTable("data/cp_buff.txt", 132, TcpBuf, VcpBuf);
   50 : real[int] TcpCu(16),   VcpCu(16);      int ncpCu   = loadTable("data/cp_cu.txt",   16, TcpCu, VcpCu);
   51 : real[int] TcpHast(43), VcpHast(43);    int ncpHast = loadTable("data/cp_hast.txt", 43, TcpHast, VcpHast);
   52 : real[int] TcpSc(34),   VcpSc(34);      int ncpSc   = loadTable("data/cp_rebco.txt",34, TcpSc, VcpSc);
   53 : 
   54 : real[int] TkAg(29),    VkAg(29);       int nkAg    = loadTable("data/k_ag.txt",    29, TkAg, VkAg);
   55 : real[int] TkBuf(23),   VkBuf(23);      int nkBuf   = loadTable("data/k_buff.txt",  23, TkBuf, VkBuf);
   56 : real[int] TkCu(16),    VkCu(16);       int nkCu    = loadTable("data/k_cu.txt",    16, TkCu, VkCu);
   57 : real[int] TkHast(47),  VkHast(47);     int nkHast  = loadTable("data/k_hast.txt",  47, TkHast, VkHast);
   58 : real[int] TkSc(13),    VkSc(13);       int nkSc    = loadTable("data/k_rebco.txt", 13, TkSc, VkSc);
   59 : 
   60 : real[int] TrhoCu(16),   VrhoCu(16);    int nrhoCu   = loadTable("data/rho_cu.txt", 16, TrhoCu, VrhoCu);
   61 : real[int] TrhoHast(39), VrhoHast(39);  int nrhoHast = loadTable("data/rho_hast.txt", 39, TrhoHast, VrhoHast);
   62 : real[int] TrhoAg(19),   VrhoAg(19);    int nrhoAg   = loadTable("data/rho_silver.txt", 19, TrhoAg, VrhoAg);
   63 : 
   64 : // ---- convenience wrappers: property(T) for each material ----
   65 : func real cpAg(real T)   { return interp1(TcpAg,   VcpAg,   ncpAg,   T); }
   66 : func real cpBuf(real T)  { return interp1(TcpBuf,  VcpBuf,  ncpBuf,  T); }
   67 : func real cpCu(real T)   { return interp1(TcpCu,   VcpCu,   ncpCu,   T); }
   68 : func real cpHast(real T) { return interp1(TcpHast, VcpHast, ncpHast, T); }
   69 : func real cpSc(real T)   { return interp1(TcpSc,   VcpSc,   ncpSc,   T); }
   70 : 
   71 : func real kAg(real T)    { return interp1(TkAg,  VkAg,  nkAg,  T); }
   72 : func real kBuf(real T)   { return interp1(TkBuf, VkBuf, nkBuf, T); }
   73 : func real kCu(real T)    { return interp1(TkCu,  VkCu,  nkCu,  T); }
   74 : func real kHast(real T)  { return interp1(TkHast,VkHast,nkHast,T); }
   75 : func real kSc(real T)    { return interp1(TkSc,  VkSc,  nkSc,  T); }
   76 : 
   77 : func real rhoCu(real T)   { return interp1(TrhoCu,  VrhoCu,  nrhoCu,  T); }
   78 : func real rhoHast(real T) { return interp1(TrhoHast,VrhoHast,nrhoHast,T); }
   79 : func real rhoAg(real T)   { return interp1(TrhoAg,  VrhoAg,  nrhoAg,  T); }
   80 : 
   81 : // ---- densities [kg/m^3] -- identical values to 3D/3D-slit ----
   82 : real rhomCu   = 8960.0;
   83 : real rhomHast = 8890.0;
   84 : real rhomBuf  = 3600.0;
   85 : real rhomSc   = 6390.0;
   86 : real rhomAg   = 10490.0;
   87 : 
   88 : // ---- REBCO superconducting parameters -- nominal values unchanged from
   89 : // 3D/3D-slit (Jc0 is a material property of the REBCO itself, not of this
   90 : // tape's geometry; the strain-defect map scales it locally, it doesn't
   91 : // replace the nominal baseline) ----
   92 : real Jc0       = 8.0e10;   // A/m^2
   93 : real Tc        = 90.0;     // K
   94 : real n0        = 20.0;     // n-value reference
   95 : real E0        = 1.0e-4;   // V/m  (1 uV/cm criterion)
   96 : real Einit     = 1.0e-10;  // V/m  (numerical floor only, NOT the critical-field criterion)
   97 : real sigmaRebco= 1.0e6;    // S/m  (REBCO normal-state floor conductivity)
   98 : real sigmaMax  = 1.0e20;   // S/m  (numerical cap)
   99 : real sigmaBuf  = 1.0e-10;  // S/m  (buffer, effectively insulating)
  100 : 
  101 : func real nT(real T){
  102 :   if (T < Tc) return (n0-10.0)*(Tc-T)/(Tc-50.0) + 10.0;
  103 :   else return 10.0;
  104 : }
  105 : 
  106 : // JcTScaled: JcT(T) generalized with a position-dependent Jc0 multiplier
  107 : // (jc0Scale=1.0 reproduces the original unscaled 3D/3D-slit behavior
  108 : // exactly). The floor branch (T>=Tc) is scaled too -- deliberately, so a
  109 : // severely-suppressed-Jc defect doesn't retain the SAME residual floor
  110 : // value as an undamaged region once T crosses Tc (flagged during planning:
  111 : // an unscaled floor would silently erase the defect's effect exactly where
  112 : // quench behavior matters most).
  113 : func real JcTScaled(real T, real jc0Scale){
  114 :   if (T < Tc) return Jc0*jc0Scale*(Tc-T)/(Tc-50.0);
  115 :   else return 1.0*jc0Scale;
  116 : }
  117 : func real JcT(real T){ return JcTScaled(T, 1.0); }   // unscaled convenience alias
  118 : 
  119 : // sigmaScDefect: sigmaSc generalized with the same jc0Scale multiplier.
  120 : func real sigmaScDefect(real Emag, real T, real jc0Scale){
  121 :   real Estab = max(abs(Emag), Einit);
  122 :   real JcVal   = JcTScaled(T, jc0Scale);
  123 :   real nVal    = nT(T);
  124 :   real scTerm = (JcVal/Estab) * (Estab/E0)^(1.0/nVal);
  125 :   return min(scTerm, sigmaMax) + sigmaRebco;
  126 : }
  127 : func real sigmaSc(real Emag, real T){ return sigmaScDefect(Emag, T, 1.0); }
  128 : 
  129 : // ============================================================
  130 : // Strain-defect Jc/Jc0 ratio tables (generated by strain_to_jc.py).
  131 : // Array sizes come from strain_jc_meta.idp (auto-generated alongside the
  132 : // data files -- include that file BEFORE this one, or before these
  133 : // declarations run, so nIcRatioX/nJcGridX/nJcGridZ are already defined).
  134 : // ============================================================
  135 : 
  136 : real[int] xIcRatio(nIcRatioX), vIcRatio(nIcRatioX);
  137 : int nIcRatioLoaded = loadTable("strain_jc_icratio_x.txt", nIcRatioX, xIcRatio, vIcRatio);
  138 : func real icRatioOfX(real xx){ return interp1(xIcRatio, vIcRatio, nIcRatioLoaded, xx); }
  139 : 
  140 : func int loadJcGrid2D(string fname, int nxg, int nzg, real[int] &Xg, real[int] &Zg, real[int] &Vg){
  141 :   ifstream f(fname);
  142 :   for(int i=0;i<nxg;i++) f >> Xg[i];
  143 :   for(int j=0;j<nzg;j++) f >> Zg[j];
  144 :   for(int i=0;i<nxg;i++)
  145 :     for(int j=0;j<nzg;j++)
  146 :       f >> Vg[i*nzg+j];
  147 :   return 0;
  148 : }
  149 : 
  150 : real[int] xJcGrid(nJcGridX), zJcGrid(nJcGridZ), jcGridFlat(nJcGridX*nJcGridZ);
  151 : int jcGridLoadOK = loadJcGrid2D("strain_jc_grid_xz.txt", nJcGridX, nJcGridZ, xJcGrid, zJcGrid, jcGridFlat);
  152 : 
  153 : // Bilinear lookup, clamped at the grid edges -- matches strain_to_jc.py's
  154 : // own flat-extrapolation policy, so a query point slightly outside the
  155 : // grid (floating-point edge case, not a real out-of-coverage query, since
  156 : // the Python side already clamped/extrapolated onto this exact grid)
  157 : // degrades gracefully rather than reading out of bounds.
  158 : func real interp2(real[int] &Xg, real[int] &Zg, real[int] &Vg, int nxg, int nzg, real xq, real zq){
  159 :   real xc = xq; if (xc < Xg[0]) xc = Xg[0]; if (xc > Xg[nxg-1]) xc = Xg[nxg-1];
  160 :   real zc = zq; if (zc < Zg[0]) zc = Zg[0]; if (zc > Zg[nzg-1]) zc = Zg[nzg-1];
  161 : 
  162 :   int ix = 0;
  163 :   while (ix < nxg-2 && Xg[ix+1] < xc) ix++;
  164 :   int iz = 0;
  165 :   while (iz < nzg-2 && Zg[iz+1] < zc) iz++;
  166 : 
  167 :   real x0=Xg[ix], x1=Xg[ix+1], z0=Zg[iz], z1=Zg[iz+1];
  168 :   real fx = (x1>x0) ? (xc-x0)/(x1-x0) : 0.0;
  169 :   real fz = (z1>z0) ? (zc-z0)/(z1-z0) : 0.0;
  170 : 
  171 :   real v00=Vg[ix*nzg+iz],     v01=Vg[ix*nzg+iz+1];
  172 :   real v10=Vg[(ix+1)*nzg+iz], v11=Vg[(ix+1)*nzg+iz+1];
  173 : 
  174 :   real v0 = v00*(1-fz) + v01*fz;
  175 :   real v1 = v10*(1-fz) + v11*fz;
  176 :   return v0*(1-fx) + v1*fx;
  177 : }
  178 : func real jcRatioOfXZ(real xx, real zz){ return interp2(xJcGrid, zJcGrid, jcGridFlat, nJcGridX, nJcGridZ, xx, zz); }
