  153 : // Bilinear lookup, clamped at the grid edges -- matches strain_to_jc.py's
  154 : // own flat-extrapolation policy, so a query point slightly outside the
  155 : // grid (floating-point edge case, not a real out-of-coverage query, since
  156 : // the Python side already clamped/extrapolated onto this exact grid)
  157 : // degrades gracefully rather than reading out of bounds.
  158 : func real interp2(real[int] &Xg, real[int] &Zg, real[int] &Vg, int nxg, int nzg, real xq, real zq){
  159 :   real xc = xq; if (xc < Xg[0]) xc = Xg[0]; if (xc > Xg[nxg-1]) xc = Xg[nxg-1];
  160 :   real zc = zq; if (zc < Zg[0]) zc = Zg[0]; if (zc > Zg[nzg-1]) zc = Zg[nzg-1];
  161 : 
  162 :   int ix = 0;
  163 :   while (ix < nxg-2 && Xg[ix+1] < xc) ix++;
  164 :   int iz = 0;
  165 :   while (iz < nzg-2 && Zg[iz+1] < zc) iz++;
  166 : 
  167 :   real x0=Xg[ix], x1=Xg[ix+1], z0=Zg[iz], z1=Zg[iz+1];
  168 :   real fx = (x1>x0) ? (xc-x0)/(x1-x0) : 0.0;
  169 :   real fz = (z1>z0) ? (zc-z0)/(z1-z0) : 0.0;
  170 : 
  171 :   real v00=Vg[ix*nzg+iz],     v01=Vg[ix*nzg+iz+1];
  172 :   real v10=Vg[(ix+1)*nzg+iz], v11=Vg[(ix+1)*nzg+iz+1];
  173 : 
  174 :   real v0 = v00*(1-fz) + v01*fz;
  175 :   real v1 = v10*(1-fz) + v11*fz;
  176 :   return v0*(1-fx) + v1*fx;
  177 : }
  178 : func real jcRatioOfXZ(real xx, real zz){ return interp2(xJcGrid, zJcGrid, jcGridFlat, nJcGridX, nJcGridZ, xx, zz); }
