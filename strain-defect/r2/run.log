  140 : func int loadJcGrid2D(string fname, int nxg, int nzg, real[int] &Xg, real[int] &Zg, real[int] &Vg){
  141 :   ifstream f(fname);
  142 :   for(int i=0;i<nxg;i++) f >> Xg[i];
  143 :   for(int j=0;j<nzg;j++) f >> Zg[j];
  144 :   for(int i=0;i<nxg;i++)
