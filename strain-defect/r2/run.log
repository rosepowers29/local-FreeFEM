  154 : func real solveE(real TcuShell, real THast, real[int] &TscZ, real[int] &jcRzZ, int nk, real TagT, real Itarget){
  155 :   if (Itarget <= 0.0) return 0.0;
  156 :   real Ehi0 = 4.0; int guard = 0;
  157 :   while (Itot(Ehi0,TcuShell,THast,TscZ,jcRzZ,nk,TagT) < Itarget && guard<40){ Ehi0 *= 2.0; guard++; }
  158 :   real logElo = log(1e-30), logEhi = log(Ehi0);
  159 :   for (int it=0; it<50; it++){
  160 :     real logEmid = 0.5*(logElo+logEhi);
  161 :     real Emid = exp(logEmid);
  162 :     if (Itot(Emid,TcuShell,THast,TscZ,jcRzZ,nk,TagT) < Itarget) logElo = logEmid; else logEhi = logEmid;
  163 :   }
  164 :   real Efinal = exp(0.5*(logElo+logEhi));
  165 :   real relErr = abs(Itot(Efinal,TcuShell,THast,TscZ,jcRzZ,nk,TagT)-Itarget)/max(Itarget,1e-30);
  166 :   if (relErr > maxRelErrThisStep) maxRelErrThisStep = relErr;
  167 :   assert(relErr <= 1e-3);
  168 :   return Efinal;
  169 : }
