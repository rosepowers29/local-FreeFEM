   43 : real Tcold = 77.0;
   44 : // NOMINAL (undamaged) critical current -- intentionally UNSCALED by the
   45 : // defect, since "ratio" is meant to express how far above the undamaged
   46 : // tape's own Ic the transport current is pushed. The defect is what makes
   47 : // the tape quench before reaching this nominal target, not a redefinition
   48 : // of the target itself.
   49 : real IcRebcoActual = JcT(77.0)*tSc*coreWidth;
   50 : real I0Target = currentRatio * IcRebcoActual;
