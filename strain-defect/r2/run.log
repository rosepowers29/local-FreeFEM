   88 : // ---- REBCO superconducting parameters -- nominal values unchanged from
   89 : // 3D/3D-slit (Jc0 is a material property of the REBCO itself, not of this
   90 : // tape's geometry; the strain-defect map scales it locally, it doesn't
   91 : // replace the nominal baseline) ----
   92 : real Jc0       = 8.0e10;   // A/m^2
   93 : real Tc        = 90.0;     // K
   94 : real n0        = 20.0;     // n-value reference
   95 : real E0        = 1.0e-4;   // V/m  (1 uV/cm criterion)
   96 : real Einit     = 1.0e-10;  // V/m  (numerical floor only, NOT the critical-field criterion)
   97 : real sigmaRebco= 1.0e6;    // S/m  (REBCO normal-state floor conductivity)
   98 : real sigmaMax  = 1.0e20;   // S/m  (numerical cap)
   99 : real sigmaBuf  = 1.0e-10;  // S/m  (buffer, effectively insulating)
  100 : 
  101 : func real nT(real T){
  102 :   if (T < Tc) return (n0-10.0)*(Tc-T)/(Tc-50.0) + 10.0;
  103 :   else return 10.0;
  104 : }
  105 : 
  106 : // JcTScaled: JcT(T) generalized with a position-dependent Jc0 multiplier
  107 : // (jc0Scale=1.0 reproduces the original unscaled 3D/3D-slit behavior
  108 : // exactly). The floor branch (T>=Tc) is scaled too -- deliberately, so a
  109 : // severely-suppressed-Jc defect doesn't retain the SAME residual floor
  110 : // value as an undamaged region once T crosses Tc (flagged during planning:
  111 : // an unscaled floor would silently erase the defect's effect exactly where
  112 : // quench behavior matters most).
  113 : func real JcTScaled(real T, real jc0Scale){
  114 :   if (T < Tc) return Jc0*jc0Scale*(Tc-T)/(Tc-50.0);
  115 :   else return 1.0*jc0Scale;
  116 : }
  117 : func real JcT(real T){ return JcTScaled(T, 1.0); }   // unscaled convenience alias
  118 : 
  119 : // sigmaScDefect: sigmaSc generalized with the same jc0Scale multiplier.
  120 : func real sigmaScDefect(real Emag, real T, real jc0Scale){
  121 :   real Estab = max(abs(Emag), Einit);
  122 :   real JcVal   = JcTScaled(T, jc0Scale);
  123 :   real nVal    = nT(T);
  124 :   real scTerm = (JcVal/Estab) * (Estab/E0)^(1.0/nVal);
  125 :   return min(scTerm, sigmaMax) + sigmaRebco;
  126 : }
  127 : func real sigmaSc(real Emag, real T){ return sigmaScDefect(Emag, T, 1.0); }
