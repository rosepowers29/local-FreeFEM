   63 :   fmeta << "V_defect_down,voltage_tap," << xDefectDown << "," << yRef << "," << zDiagCenter << ",cumulative from V_CL+, downstream of defect\n";
   64 :   fmeta << "V_CL_plus,current_lead_voltage,0," << yRef << ",n/a,reference (=0 by construction)\n";
   65 :   fmeta << "V_CL_minus,current_lead_voltage," << Lx << "," << yRef << ",n/a,far current lead (total tape voltage)\n";
   66 :   return 0;
   67 : }
