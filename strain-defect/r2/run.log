   58 : // One-time metadata export: physical location + type of every channel.
   59 : func int writeDiagnosticsMetadata(string fname, real yRef){
   60 :   ofstream fmeta(fname);
   61 :   fmeta << "channel,type,x_m,y_m,z_m,notes\n";
   62 :   fmeta << "V_defect_up,voltage_tap," << xDefectUp << "," << yRef << "," << zDiagCenter << ",cumulative from V_CL+, upstream of defect\n";
   63 :   fmeta << "V_defect_down,voltage_tap," << xDefectDown << "," << yRef << "," << zDiagCenter << ",cumulative from V_CL+, downstream of defect\n";
   64 :   fmeta << "V_CL_plus,current_lead_voltage,0," << yRef << ",n/a,reference (=0 by construction)\n";
   65 :   fmeta << "V_CL_minus,current_lead_voltage," << Lx << "," << yRef << ",n/a,far current lead (total tape voltage)\n";
   66 :   return 0;
   67 : }
