  120 : // nzElec: number of z-sample points used to resolve the REBCO current-
  121 : // sharing integral at each x. T and jcRatioOfXZ don't depend on E, so
  122 : // they're precomputed once per x per timestep (same optimization the slit
  123 : // model already uses for its per-x temperature snapshots) and reused across
  124 : // every bisection iteration below.
  125 : int nzElec = 33;   // matches strain_to_jc.py's --n-z-sample=33 recommended
  126 :                    // resolution, so the electrical solve's own z-sampling
  127 :                    // isn't coarser than the table it's reading from.
  128 : real[int] zElecSample(nzElec);
  129 : for (int k=0;k<nzElec;k++) zElecSample[k] = zB1 + (zB2-zB1)*k/(nzElec-1);
  130 : 
  131 : // zIntegralSigmaSc: trapezoidal integral over z of sigmaScDefect(E,T(z),
  132 : // jc(z)) -- replaces the old width-averaged "coreWidth*sigmaScDefect(E,Tsc,
  133 : // jcScale)" scalar term with a proper per-z-resolved sum, at the SAME E
  134 : // (there's one shared equipotential cross-section at this x, current
  135 : // density simply varies with z because Jc does).
  136 : func real zIntegralSigmaSc(real E, real[int] &TscZ, real[int] &jcRzZ, int nk){
  137 :   real h = (zB2-zB1)/(nk-1);
  138 :   real sum = 0.0;
  139 :   for (int k=0;k<nk-1;k++){
  140 :     real sA = sigmaScDefect(E, TscZ[k],   jcRzZ[k]);
  141 :     real sB = sigmaScDefect(E, TscZ[k+1], jcRzZ[k+1]);
  142 :     sum += 0.5*(sA+sB)*h;
  143 :   }
  144 :   return sum;
  145 : }
