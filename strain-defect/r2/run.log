   32 : include "hts_materials.idp"// ============================================================
    2 : // hts_materials.idp (strain-defect track)
    3 : // Loads tabulated (T, property) data for the 5-region tape stack (Cu,
    4 : // Hastelloy, Buffer, REBCO, Ag) -- same underlying measured data as
    5 : // 3D/3D-slit (copied into strain-defect/data/, not referenced cross-track,
    6 : // so this directory stays self-contained per existing per-track precedent).
    7 : // No bottom-Ag-specific table: there is only one Ag layer in this stack
    8 : // (top), using the same cpAg/kAg/rhoAg functions the other tracks' AgTop
    9 : // already uses.
   10 : //
   11 : // Adds the strain-defect-specific pieces on top of the existing JcT/sigmaSc
   12 : // pattern: a position-dependent Jc0 scale factor, loaded from tables
   13 : // generated by strain_to_jc.py. jcRatioOfXZ(x,z) (the full 2D field) is the
   14 : // load-bearing one -- used both in the volumetric 3D heating source AND
   15 : // (as of the z-resolved electrical model, see step_strain_tape_transient.edp)
   16 : // in the per-x per-z current-sharing integral itself. icRatioOfX(x) (the
   17 : // width-averaged 1D profile) is kept loaded for diagnostic/comparison
   18 : // purposes only -- it drove an earlier width-averaged electrical-solve
   19 : // design that was replaced once real strain data showed a defect severe/
   20 : // narrow enough that averaging was unconservative (see
   21 : // strain-defect/CLAUDE.md).
   22 : // ============================================================
   23 : 
   24 : // ---- generic linear interpolation table loader (identical to 3D-slit's) ----
   25 : func int loadTable(string fname, int n, real[int] &T, real[int] &V){
   26 :   ifstream f(fname);
   27 :   for(int i=0;i<n;i++){ f >> T[i] >> V[i]; }
   28 :   return n;
   29 : }
   30 : 
   31 : // Binary search -- see 3D-slit/shared/hts_materials.idp for the verification
   32 : // history (1342 test queries, bit-identical to a linear scan). Copied
   33 : // unchanged.
   34 : func real interp1(real[int] &T, real[int] &V, int nn, real Tq){
   35 :   if (Tq <= T[0])    return V[0];
   36 :   if (Tq >= T[nn-1]) return V[nn-1];
   37 :   int lo = 0, hi = nn-1;
   38 :   while (lo < hi){
   39 :     int mid = (lo+hi)/2;
   40 :     if (T[mid] < Tq) lo = mid+1; else hi = mid;
   41 :   }
   42 :   int i = lo-1;
   43 :   real fr = (Tq-T[i])/(T[i+1]-T[i]);
   44 :   return V[i] + fr*(V[i+1]-V[i]);
   45 : }
   46 : 
   47 : // ---- load every table (row counts match `wc -l` on each file) ----
   48 : real[int] TcpAg(71),   VcpAg(71);      int ncpAg   = loadTable("data/cp_ag.txt",   71, TcpAg, VcpAg);
   49 : real[int] TcpBuf(132), VcpBuf(132);    int ncpBuf  = loadTable("data/cp_buff.txt", 132, TcpBuf, VcpBuf);
   50 : real[int] TcpCu(16),   VcpCu(16);      int ncpCu   = loadTable("data/cp_cu.txt",   16, TcpCu, VcpCu);
   51 : real[int] TcpHast(43), VcpHast(43);    int ncpHast = loadTable("data/cp_hast.txt", 43, TcpHast, VcpHast);
   52 : real[int] TcpSc(34),   VcpSc(34);      int ncpSc   = loadTable("data/cp_rebco.txt",34, TcpSc, VcpSc);
   53 : 
   54 : real[int] TkAg(29),    VkAg(29);       int nkAg    = loadTable("data/k_ag.txt",    29, TkAg, VkAg);
   55 : real[int] TkBuf(23),   VkBuf(23);      int nkBuf   = loadTable("data/k_buff.txt",  23, TkBuf, VkBuf);
   56 : real[int] TkCu(16),    VkCu(16);       int nkCu    = loadTable("data/k_cu.txt",    16, TkCu, VkCu);
   57 : real[int] TkHast(47),  VkHast(47);     int nkHast  = loadTable("data/k_hast.txt",  47, TkHast, VkHast);
   58 : real[int] TkSc(13),    VkSc(13);       int nkSc    = loadTable("data/k_rebco.txt", 13, TkSc, VkSc);
   59 : 
   60 : real[int] TrhoCu(16),   VrhoCu(16);    int nrhoCu   = loadTable("data/rho_cu.txt", 16, TrhoCu, VrhoCu);
   61 : real[int] TrhoHast(39), VrhoHast(39);  int nrhoHast = loadTable("data/rho_hast.txt", 39, TrhoHast, VrhoHast);
   62 : real[int] TrhoAg(19),   VrhoAg(19);    int nrhoAg   = loadTable("data/rho_silver.txt", 19, TrhoAg, VrhoAg);
   63 : 
   64 : // ---- convenience wrappers: property(T) for each material ----
   65 : func real cpAg(real T)   { return interp1(TcpAg,   VcpAg,   ncpAg,   T); }
   66 : func real cpBuf(real T)  { return interp1(TcpBuf,  VcpBuf,  ncpBuf,  T); }
   67 : func real cpCu(real T)   { return interp1(TcpCu,   VcpCu,   ncpCu,   T); }
   68 : func real cpHast(real T) { return interp1(TcpHast, VcpHast, ncpHast, T); }
   69 : func real cpSc(real T)   { return interp1(TcpSc,   VcpSc,   ncpSc,   T); }
   70 : 
   71 : func real kAg(real T)    { return interp1(TkAg,  VkAg,  nkAg,  T); }
   72 : func real kBuf(real T)   { return interp1(TkBuf, VkBuf, nkBuf, T); }
   73 : func real kCu(real T)    { return interp1(TkCu,  VkCu,  nkCu,  T); }
   74 : func real kHast(real T)  { return interp1(TkHast,VkHast,nkHast,T); }
   75 : func real kSc(real T)    { return interp1(TkSc,  VkSc,  nkSc,  T); }
   76 : 
   77 : func real rhoCu(real T)   { return interp1(TrhoCu,  VrhoCu,  nrhoCu,  T); }
   78 : func real rhoHast(real T) { return interp1(TrhoHast,VrhoHast,nrhoHast,T); }
   79 : func real rhoAg(real T)   { return interp1(TrhoAg,  VrhoAg,  nrhoAg,  T); }
