  129 : // ============================================================
  130 : // Strain-defect Jc/Jc0 ratio tables (generated by strain_to_jc.py).
  131 : // Array sizes come from strain_jc_meta.idp (auto-generated alongside the
  132 : // data files -- include that file BEFORE this one, or before these
  133 : // declarations run, so nIcRatioX/nJcGridX/nJcGridZ are already defined).
  134 : // ============================================================
  135 : 
  136 : real[int] xIcRatio(nIcRatioX), vIcRatio(nIcRatioX);
  137 : int nIcRatioLoaded = loadTable("strain_jc_icratio_x.txt", nIcRatioX, xIcRatio, vIcRatio);
  138 : func real icRatioOfX(real xx){ return interp1(xIcRatio, vIcRatio, nIcRatioLoaded, xx); }
