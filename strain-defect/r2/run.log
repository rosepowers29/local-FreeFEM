  179 : include "diagnostics_strain_tape.idp"// ============================================================
    2 : // diagnostics_strain_tape.idp
    3 : // Minimal voltage-tap diagnostics for the strain-defect single-tape model:
    4 : // 2 pairs (4 taps total), ALL on the tape's centerline (z=width/2) -- no
    5 : // left/right split, since there's no slit to sever the conductor.
    6 : //
    7 : //   - Pair 1: straddles the defect location (xDefectUp/xDefectDown,
    8 : //     upstream/downstream by `tapOffset`) -- differential voltage local to
    9 : //     the defect.
   10 : //   - Pair 2: V_CL_plus (x=0) / V_CL_minus (x=Lx) -- total end-to-end tape
   11 : //     voltage, same current-lead-reference concept as 3D-slit's diagnostics.
   12 : //
   13 : // No RTDs, no Hall probes, no B-field -- this scenario has none of those.
   14 : //
   15 : // IMPORTANT -- scope/inclusion requirements (same convention as
   16 : // 3D-slit/shared/diagnostics_3d_slit.idp): the including script must
   17 : // already define, with exactly these names:
   18 : //   real Lx, width
   19 : //   real defectX        -- from strain_jc_meta.idp (via strain_to_jc.py)
   20 : //   real tapOffset       -- distance from the defect to each tap (m)
   21 : //   func real Efun(real xx)   -- single-channel E(x), valid everywhere
   22 : // Include this file AFTER Efun is defined for the current timestep, same
   23 : // reasoning as the slit diagnostics file: tap voltages must reflect the
   24 : // CURRENT timestep's field, so voltage evaluation (diagAllTapVoltages) must
   25 : // be called freshly every step even though the tap positions themselves are
   26 : // static and computed once.
   27 : // ============================================================
   28 : 
   29 : real zDiagCenter = width/2;
   30 : 
   31 : real xDefectUp   = defectX - tapOffset;
   32 : real xDefectDown = defectX + tapOffset;
   33 : if (xDefectUp < 0.0)  xDefectUp  = 0.0;
   34 : if (xDefectDown > Lx) xDefectDown = Lx;
   35 : 
   36 : // Cumulative voltage from x=0 (V_CL+ reference) out to xx -- midpoint-rule
   37 : // integration, same cheap pattern as diagVcum in the slit diagnostics file.
   38 : func real diagVcum(real xx){
   39 :   int nSub = 400;
   40 :   real h = xx/nSub;
   41 :   real sum = 0.0;
   42 :   for (int j=0; j<nSub; j++){
   43 :     real xm = (j+0.5)*h;
   44 :     sum += Efun(xm)*h;
   45 :   }
   46 :   return sum;
   47 : }
   48 : 
   49 : // Fills the 3 non-trivial cumulative voltages for the current timestep
   50 : // (V_CL_plus is always 0 by construction, the reference point).
   51 : func int diagAllTapVoltages(real &vDefectUp, real &vDefectDown, real &vClMinus){
   52 :   vDefectUp   = diagVcum(xDefectUp);
   53 :   vDefectDown = diagVcum(xDefectDown);
   54 :   vClMinus    = diagVcum(Lx);
   55 :   return 0;
   56 : }
