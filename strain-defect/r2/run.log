  131 : // zIntegralSigmaSc: trapezoidal integral over z of sigmaScDefect(E,T(z),
  132 : // jc(z)) -- replaces the old width-averaged "coreWidth*sigmaScDefect(E,Tsc,
  133 : // jcScale)" scalar term with a proper per-z-resolved sum, at the SAME E
  134 : // (there's one shared equipotential cross-section at this x, current
  135 : // density simply varies with z because Jc does).
  136 : func real zIntegralSigmaSc(real E, real[int] &TscZ, real[int] &jcRzZ, int nk){
  137 :   real h = (zB2-zB1)/(nk-1);
  138 :   real sum = 0.0;
  139 :   for (int k=0;k<nk-1;k++){
  140 :     real sA = sigmaScDefect(E, TscZ[k],   jcRzZ[k]);
  141 :     real sB = sigmaScDefect(E, TscZ[k+1], jcRzZ[k+1]);
