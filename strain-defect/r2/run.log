  120 : // nzElec: number of z-sample points used to resolve the REBCO current-
  121 : // sharing integral at each x. T and jcRatioOfXZ don't depend on E, so
  122 : // they're precomputed once per x per timestep (same optimization the slit
  123 : // model already uses for its per-x temperature snapshots) and reused across
  124 : // every bisection iteration below.
  125 : int nzElec = 33;   // matches strain_to_jc.py's --n-z-sample=33 recommended
  126 :                    // resolution, so the electrical solve's own z-sampling
  127 :                    // isn't coarser than the table it's reading from.
  128 : real[int] zElecSample(nzElec);
  129 : for (int k=0;k<nzElec;k++) zElecSample[k] = zB1 + (zB2-zB1)*k/(nzElec-1);
