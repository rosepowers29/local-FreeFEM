  147 : func real Itot(real E, real TcuShell, real THast, real[int] &TscZ, real[int] &jcRzZ, int nk, real TagT){
  148 :   return shellArea*(E/rhoCu(TcuShell))
  149 :        + tHast*coreWidth*(E/rhoHast(THast))
  150 :        + tSc*E*zIntegralSigmaSc(E,TscZ,jcRzZ,nk)
  151 :        + tAgT*coreWidth*(E/rhoAg(TagT));
  152 : }
