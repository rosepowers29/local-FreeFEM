// ============================================================
// hts_materials.idp (strain-defect track)
// Loads tabulated (T, property) data for the 5-region tape stack (Cu,
// Hastelloy, Buffer, REBCO, Ag) -- same underlying measured data as
// 3D/3D-slit (copied into strain-defect/data/, not referenced cross-track,
// so this directory stays self-contained per existing per-track precedent).
// No bottom-Ag-specific table: there is only one Ag layer in this stack
// (top), using the same cpAg/kAg/rhoAg functions the other tracks' AgTop
// already uses.
//
// Adds the strain-defect-specific pieces on top of the existing JcT/sigmaSc
// pattern: a position-dependent Jc0 scale factor (icRatioOfX for the 1D
// per-x electrical solve, jcRatioOfXZ for the volumetric 3D heating source)
// loaded from tables generated by strain_to_jc.py. See
// strain-defect/CLAUDE.md for the physics rationale (hybrid width-averaged
// / full-2D treatment, validated during planning).
// ============================================================

// ---- generic linear interpolation table loader (identical to 3D-slit's) ----
func int loadTable(string fname, int n, real[int] &T, real[int] &V){
  ifstream f(fname);
  for(int i=0;i<n;i++){ f >> T[i] >> V[i]; }
  return n;
}

// Binary search -- see 3D-slit/shared/hts_materials.idp for the verification
// history (1342 test queries, bit-identical to a linear scan). Copied
// unchanged.
func real interp1(real[int] &T, real[int] &V, int nn, real Tq){
  if (Tq <= T[0])    return V[0];
  if (Tq >= T[nn-1]) return V[nn-1];
  int lo = 0, hi = nn-1;
  while (lo < hi){
    int mid = (lo+hi)/2;
    if (T[mid] < Tq) lo = mid+1; else hi = mid;
  }
  int i = lo-1;
  real fr = (Tq-T[i])/(T[i+1]-T[i]);
  return V[i] + fr*(V[i+1]-V[i]);
}

// ---- load every table (row counts match `wc -l` on each file) ----
real[int] TcpAg(71),   VcpAg(71);      int ncpAg   = loadTable("data/cp_ag.txt",   71, TcpAg, VcpAg);
real[int] TcpBuf(132), VcpBuf(132);    int ncpBuf  = loadTable("data/cp_buff.txt", 132, TcpBuf, VcpBuf);
real[int] TcpCu(16),   VcpCu(16);      int ncpCu   = loadTable("data/cp_cu.txt",   16, TcpCu, VcpCu);
real[int] TcpHast(43), VcpHast(43);    int ncpHast = loadTable("data/cp_hast.txt", 43, TcpHast, VcpHast);
real[int] TcpSc(34),   VcpSc(34);      int ncpSc   = loadTable("data/cp_rebco.txt",34, TcpSc, VcpSc);

real[int] TkAg(29),    VkAg(29);       int nkAg    = loadTable("data/k_ag.txt",    29, TkAg, VkAg);
real[int] TkBuf(23),   VkBuf(23);      int nkBuf   = loadTable("data/k_buff.txt",  23, TkBuf, VkBuf);
real[int] TkCu(16),    VkCu(16);       int nkCu    = loadTable("data/k_cu.txt",    16, TkCu, VkCu);
real[int] TkHast(47),  VkHast(47);     int nkHast  = loadTable("data/k_hast.txt",  47, TkHast, VkHast);
real[int] TkSc(13),    VkSc(13);       int nkSc    = loadTable("data/k_rebco.txt", 13, TkSc, VkSc);

real[int] TrhoCu(16),   VrhoCu(16);    int nrhoCu   = loadTable("data/rho_cu.txt", 16, TrhoCu, VrhoCu);
real[int] TrhoHast(39), VrhoHast(39);  int nrhoHast = loadTable("data/rho_hast.txt", 39, TrhoHast, VrhoHast);
real[int] TrhoAg(19),   VrhoAg(19);    int nrhoAg   = loadTable("data/rho_silver.txt", 19, TrhoAg, VrhoAg);

// ---- convenience wrappers: property(T) for each material ----
func real cpAg(real T)   { return interp1(TcpAg,   VcpAg,   ncpAg,   T); }
func real cpBuf(real T)  { return interp1(TcpBuf,  VcpBuf,  ncpBuf,  T); }
func real cpCu(real T)   { return interp1(TcpCu,   VcpCu,   ncpCu,   T); }
func real cpHast(real T) { return interp1(TcpHast, VcpHast, ncpHast, T); }
func real cpSc(real T)   { return interp1(TcpSc,   VcpSc,   ncpSc,   T); }

func real kAg(real T)    { return interp1(TkAg,  VkAg,  nkAg,  T); }
func real kBuf(real T)   { return interp1(TkBuf, VkBuf, nkBuf, T); }
func real kCu(real T)    { return interp1(TkCu,  VkCu,  nkCu,  T); }
func real kHast(real T)  { return interp1(TkHast,VkHast,nkHast,T); }
func real kSc(real T)    { return interp1(TkSc,  VkSc,  nkSc,  T); }

func real rhoCu(real T)   { return interp1(TrhoCu,  VrhoCu,  nrhoCu,  T); }
func real rhoHast(real T) { return interp1(TrhoHast,VrhoHast,nrhoHast,T); }
func real rhoAg(real T)   { return interp1(TrhoAg,  VrhoAg,  nrhoAg,  T); }

// ---- densities [kg/m^3] -- identical values to 3D/3D-slit ----
real rhomCu   = 8960.0;
real rhomHast = 8890.0;
real rhomBuf  = 3600.0;
real rhomSc   = 6390.0;
real rhomAg   = 10490.0;

// ---- REBCO superconducting parameters -- nominal values unchanged from
// 3D/3D-slit (Jc0 is a material property of the REBCO itself, not of this
// tape's geometry; the strain-defect map scales it locally, it doesn't
// replace the nominal baseline) ----
real Jc0       = 8.0e10;   // A/m^2
real Tc        = 90.0;     // K
real n0        = 20.0;     // n-value reference
real E0        = 1.0e-4;   // V/m  (1 uV/cm criterion)
real Einit     = 1.0e-10;  // V/m  (numerical floor only, NOT the critical-field criterion)
real sigmaRebco= 1.0e6;    // S/m  (REBCO normal-state floor conductivity)
real sigmaMax  = 1.0e20;   // S/m  (numerical cap)
real sigmaBuf  = 1.0e-10;  // S/m  (buffer, effectively insulating)

func real nT(real T){
  if (T < Tc) return (n0-10.0)*(Tc-T)/(Tc-50.0) + 10.0;
  else return 10.0;
}

// JcTScaled: JcT(T) generalized with a position-dependent Jc0 multiplier
// (jc0Scale=1.0 reproduces the original unscaled 3D/3D-slit behavior
// exactly). The floor branch (T>=Tc) is scaled too -- deliberately, so a
// severely-suppressed-Jc defect doesn't retain the SAME residual floor
// value as an undamaged region once T crosses Tc (flagged during planning:
// an unscaled floor would silently erase the defect's effect exactly where
// quench behavior matters most).
func real JcTScaled(real T, real jc0Scale){
  if (T < Tc) return Jc0*jc0Scale*(Tc-T)/(Tc-50.0);
  else return 1.0*jc0Scale;
}
func real JcT(real T){ return JcTScaled(T, 1.0); }   // unscaled convenience alias

// sigmaScDefect: sigmaSc generalized with the same jc0Scale multiplier.
func real sigmaScDefect(real Emag, real T, real jc0Scale){
  real Estab = max(abs(Emag), Einit);
  real JcVal   = JcTScaled(T, jc0Scale);
  real nVal    = nT(T);
  real scTerm = (JcVal/Estab) * (Estab/E0)^(1.0/nVal);
  return min(scTerm, sigmaMax) + sigmaRebco;
}
func real sigmaSc(real Emag, real T){ return sigmaScDefect(Emag, T, 1.0); }

// ============================================================
// Strain-defect Jc/Jc0 ratio tables (generated by strain_to_jc.py).
// Array sizes come from strain_jc_meta.idp (auto-generated alongside the
// data files -- include that file BEFORE this one, or before these
// declarations run, so nIcRatioX/nJcGridX/nJcGridZ are already defined).
// ============================================================

real[int] xIcRatio(nIcRatioX), vIcRatio(nIcRatioX);
int nIcRatioLoaded = loadTable("strain_jc_icratio_x.txt", nIcRatioX, xIcRatio, vIcRatio);
func real icRatioOfX(real xx){ return interp1(xIcRatio, vIcRatio, nIcRatioLoaded, xx); }

func int loadJcGrid2D(string fname, int nxg, int nzg, real[int] &Xg, real[int] &Zg, real[int] &Vg){
  ifstream f(fname);
  for(int i=0;i<nxg;i++) f >> Xg[i];
  for(int j=0;j<nzg;j++) f >> Zg[j];
  for(int i=0;i<nxg;i++)
    for(int j=0;j<nzg;j++)
      f >> Vg[i*nzg+j];
  return 0;
}

real[int] xJcGrid(nJcGridX), zJcGrid(nJcGridZ), jcGridFlat(nJcGridX*nJcGridZ);
int jcGridLoadOK = loadJcGrid2D("strain_jc_grid_xz.txt", nJcGridX, nJcGridZ, xJcGrid, zJcGrid, jcGridFlat);

// Bilinear lookup, clamped at the grid edges -- matches strain_to_jc.py's
// own flat-extrapolation policy, so a query point slightly outside the
// grid (floating-point edge case, not a real out-of-coverage query, since
// the Python side already clamped/extrapolated onto this exact grid)
// degrades gracefully rather than reading out of bounds.
func real interp2(real[int] &Xg, real[int] &Zg, real[int] &Vg, int nxg, int nzg, real xq, real zq){
  real xc = xq; if (xc < Xg[0]) xc = Xg[0]; if (xc > Xg[nxg-1]) xc = Xg[nxg-1];
  real zc = zq; if (zc < Zg[0]) zc = Zg[0]; if (zc > Zg[nzg-1]) zc = Zg[nzg-1];

  int ix = 0;
  while (ix < nxg-2 && Xg[ix+1] < xc) ix++;
  int iz = 0;
  while (iz < nzg-2 && Zg[iz+1] < zc) iz++;

  real x0=Xg[ix], x1=Xg[ix+1], z0=Zg[iz], z1=Zg[iz+1];
  real fx = (x1>x0) ? (xc-x0)/(x1-x0) : 0.0;
  real fz = (z1>z0) ? (zc-z0)/(z1-z0) : 0.0;

  real v00=Vg[ix*nzg+iz],     v01=Vg[ix*nzg+iz+1];
  real v10=Vg[(ix+1)*nzg+iz], v11=Vg[(ix+1)*nzg+iz+1];

  real v0 = v00*(1-fz) + v01*fz;
  real v1 = v10*(1-fz) + v11*fz;
  return v0*(1-fx) + v1*fx;
}
func real jcRatioOfXZ(real xx, real zz){ return interp2(xJcGrid, zJcGrid, jcGridFlat, nJcGridX, nJcGridZ, xx, zz); }
