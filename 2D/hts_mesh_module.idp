// ============================================================
// hts_mesh_module.idp  (v2 -- single conforming mesh, fixes interface
// node-duplication bug from the original multi-buildmesh+glue approach)
//
// Builds the 2D (length x thickness) mesh of the 7-layer REBCO tape as
// ONE single mesh (a stretched-coordinate square), guaranteeing exactly
// conforming vertices at every layer interface -- no gluing, no risk of
// near-duplicate/disconnected nodes.
//
// Region numbering (bottom -> top):
//   1 = Cu (bottom, 20um)      5 = REBCO       (1um)
//   2 = Ag (bottom, 1.8um)     6 = Ag (top, 2um)
//   3 = Hastelloy (50um)       7 = Cu (top, 20um)
//   4 = Buffer (0.2um)
//
// Labels: 1=bottom outer face  2=top outer face
//         3=left end (cold)    4=right end (cold)
// ============================================================

real Lx    = 0.20;      // tape length [m]

real tCuB  = 20e-6, tAgB = 1.8e-6, tSub = 50e-6, tBuf = 0.2e-6,
     tSc   = 1e-6,  tAgT = 2e-6,  tCuT = 20e-6;

real yB0=0, yB1=yB0+tCuB, yB2=yB1+tAgB, yB3=yB2+tSub, yB4=yB3+tBuf,
     yB5=yB4+tSc, yB6=yB5+tAgT, yB7=yB6+tCuT;

int nx = 200;
int nCuB=8, nAgB=2, nSub=6, nBuf=1, nSc=2, nAgT=2, nCuT=8;
int ny = nCuB+nAgB+nSub+nBuf+nSc+nAgT+nCuT;

func real yphys(real s){
  real fCuB=nCuB*1.0/ny, fAgB=nAgB*1.0/ny, fSub=nSub*1.0/ny, fBuf=nBuf*1.0/ny,
       fSc=nSc*1.0/ny, fAgT=nAgT*1.0/ny, fCuT=nCuT*1.0/ny;
  real c0=0, c1=c0+fCuB, c2=c1+fAgB, c3=c2+fSub, c4=c3+fBuf, c5=c4+fSc, c6=c5+fAgT, c7=c6+fCuT;
  if (s<=c1) return yB0 + (yB1-yB0)*(s-c0)/(c1-c0);
  if (s<=c2) return yB1 + (yB2-yB1)*(s-c1)/(c2-c1);
  if (s<=c3) return yB2 + (yB3-yB2)*(s-c2)/(c3-c2);
  if (s<=c4) return yB3 + (yB4-yB3)*(s-c3)/(c4-c3);
  if (s<=c5) return yB4 + (yB5-yB4)*(s-c4)/(c5-c4);
  if (s<=c6) return yB5 + (yB6-yB5)*(s-c5)/(c6-c5);
  return yB6 + (yB7-yB6)*(s-c6)/(c7-c6);
}

// FreeFEM square()'s default label order is [1=bottom,2=right,3=top,4=left].
// We want OUR labels to be [1=bottom,2=top,3=left(cold end),4=right(cold end)],
// so remap: default-bottom->1, default-right->4, default-top->2, default-left->3.
// (A prior version of this array, [3,4,2,1], was WRONG -- it mapped
// default-bottom->3 and default-left->1, silently swapping which physical
// face got the Dirichlet cold-end BC in on(3,4,...) calls throughout every
// downstream script: one real end was left adiabatic, and the BOTTOM face
// was wrongly clamped to 77K instead -- confirmed via arc-length check,
// see project history/README.)
int[int] sqLabels = [1,4,2,3];
mesh Th = square(nx, ny, [Lx*x, y], label=sqLabels);
Th = movemesh(Th, [x, yphys(y)]);

fespace Ph0region(Th, P0);
Ph0region region0 = (y<=yB1)*1 + (y>yB1 && y<=yB2)*2 + (y>yB2 && y<=yB3)*3
                   + (y>yB3 && y<=yB4)*4 + (y>yB4 && y<=yB5)*5 + (y>yB5 && y<=yB6)*6
                   + (y>yB6)*7;
Th = change(Th, fregion = region0(x,y));
